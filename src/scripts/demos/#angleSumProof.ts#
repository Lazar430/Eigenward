const sinTheta = Math.sin(THETA);
const cosTheta = Math.cos(THETA);
const sinAlpha = Math.sin(ALPHA);
const cosAlpha = Math.cos(ALPHA);
const sinBeta = Math.sin(BETA);
const cosBeta = Math.cos(BETA);

const A: Vec2Tuple = [0, 0];
const B: Vec2Tuple = [SCALE * sinTheta, 0];
const C: Vec2Tuple = [0, SCALE * cosTheta];
const D: Vec2Tuple = [B[0], C[1] + 0.42];

const rayBE: Vec2Tuple = [-sinBeta, cosBeta];

const E: Vec2Tuple = [
  B[0] + SCALE * cosAlpha * rayBE[0],
  B[1] + SCALE * cosAlpha * rayBE[1],
];

const F: Vec2Tuple = [B[0], E[1]];
const G: Vec2Tuple = [0, E[1]];

