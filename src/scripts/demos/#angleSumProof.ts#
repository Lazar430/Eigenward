const stages: ProofStage2D[] = [
  {
    title: "Stage 1 — the main right triangle",
    description:
      "Start with a right triangle whose hypotenuse has length 1. Its legs are sin(α+β) and cos(α+β).",
    async run(proof) {
      await proof.drawSegment(edges.AB, A, B, {
        durationSeconds: 0.42,
      });

      await Promise.all([
        proof.drawSegment(edges.AC, A, C, {
          durationSeconds: 0.42,
