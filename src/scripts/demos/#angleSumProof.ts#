        proof.drawSegment(edges.BC, B, C, {
          durationSeconds: 0.52,
        }),
      ]);

      await Promise.all([
        revealProofSector2D(proof, angleARight, 0.28, {
          durationSeconds: 0.28,
        }),
        revealProofSector2D(proof, angleCTotal, 0.56, {
          durationSeconds: 0.34,
        }),
      ]);

      placeAngleLabel(angleLabels.cTotal, angleCTotal, 1.42);
      angleLabels.cTotal.show().setOpacity(1);

      await Promise.all([
        revealDimensionBrace(proof, braces.BC, 0.62),
        revealDimensionBrace(proof, braces.AB, 0.62),
        revealDimensionBrace(proof, braces.AC, 0.62),
      ]);
    },
  },

  {
    title: "Stage 2 — draw the short parallel",
    description:
      "From the lower endpoint of the hypotenuse, draw a short line parallel to the adjacent leg. The angle it makes with the hypotenuse is again α+β.",
    async run(proof) {
      await proof.drawSegment(edges.BD, B, D, {
        durationSeconds: 0.42,
      });

      await revealProofSector2D(proof, angleBTotal, 0.56, {
        durationSeconds: 0.34,
      });

      placeAngleLabel(angleLabels.bTotal, angleBTotal, 1.42);
      angleLabels.bTotal.show().setOpacity(1);
    },
  },

  {
    title: "Stage 3 — split the angle into α and β",
    description:
      "Split the stage-2 angle into α and β, then extend the splitter and the perpendicular from the top vertex until they meet. This creates a right triangle with hypotenuse 1 and legs cos α and sin α.",
    async run(proof) {
      angleBTotal.hide().setRadius(0);
      angleLabels.bTotal.hide().setOpacity(0);

      await proof.drawSegment(edges.BE, B, E, {
        durationSeconds: 0.44,
      });

      await proof.drawSegment(edges.CE, C, E, {
        durationSeconds: 0.44,
      });

      await Promise.all([
        revealProofSector2D(proof, angleBAlpha, 0.50, {
          durationSeconds: 0.30,
        }),
        revealProofSector2D(proof, angleBBeta, 0.42, {
          durationSeconds: 0.30,
        }),
        revealProofSector2D(proof, angleERight, 0.26, {
          durationSeconds: 0.28,
        }),
      ]);

      placeAngleLabel(angleLabels.bAlpha, angleBAlpha, 1.48);
      placeAngleLabel(angleLabels.bBeta, angleBBeta, 1.58);

      angleLabels.bAlpha.show().setOpacity(1);
      angleLabels.bBeta.show().setOpacity(1);

      await Promise.all([
        revealDimensionBrace(proof, braces.BE, 0.64),
        revealDimensionBrace(proof, braces.CE, 0.64),
      ]);
    },
  },

  {
    title: "Stage 4 — the second right triangle",
    description:
      "Extend the parallel line upward until it meets the perpendicular from the stage-3 right angle. This produces another right triangle with legs cosβ cosα and sinβ cosα.",
    async run(proof) {
      await proof.drawSegment(edges.DF, D, F, {
        durationSeconds: 0.36,
      });

      await proof.drawSegment(edges.EF, E, F, {
        durationSeconds: 0.42,
      });

      await revealProofSector2D(proof, angleFRight, 0.26, {
        durationSeconds: 0.28,
      });

      await Promise.all([
        revealDimensionBrace(proof, braces.BF, 0.66),
        revealDimensionBrace(proof, braces.EF, 0.66),
      ]);
    },
  },

  {
    title: "Stage 5 — the final right triangle",
    description:
      "Extend the original cos(α+β) leg upward and the stage-4 segment leftward until they meet. The final right triangle contributes the terms sinβ sinα and cosβ sinα.",
    async run(proof) {
      await proof.drawSegment(edges.CG, C, G, {
        durationSeconds: 0.42,
      });

      await proof.drawSegment(edges.GE, G, E, {
        durationSeconds: 0.42,
      });

      await Promise.all([
        revealProofSector2D(proof, angleGRight, 0.26, {
          durationSeconds: 0.28,
        }),
        revealProofSector2D(proof, angleEBeta, 0.42, {
          durationSeconds: 0.30,
        }),
      ]);

      placeAngleLabel(angleLabels.eBeta, angleEBeta, 1.48);
      angleLabels.eBeta.show().setOpacity(1);

      await Promise.all([
        revealDimensionBrace(proof, braces.CG, 0.66),
        revealDimensionBrace(proof, braces.GE, 0.66),
      ]);
    },
  },
];

