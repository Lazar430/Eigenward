function createAngleLabel(
  name: string,
  text: string,
  color: string,
  background: string,
  border: string,
) {
  return createTextLabel2D({
    name,
    text,
    position: [0, 0],
    anchor: [0.5, 0.5],
    color,
    fontSizePx: 14,
    fontWeight: 760,
    background,
    border,
    borderRadiusPx: 7,
    padding: "0.10rem 0.32rem",
  });
}

function placeAngleLabel(
  label: ReturnType<typeof createTextLabel2D>,
  sector: ReturnType<typeof createProofSectorHighlight2D>,
  radiusFactor = 1.42,
): void {
  const [x, y] = sector.getLabelPosition(radiusFactor);
  label.moveTo(x, y);
}

async function revealDimensionBrace(
  proof: ProofStageController2D,
  brace: ReturnType<typeof createDimensionBrace2D>,
  durationSeconds = 0.72,
): Promise<void> {
  brace.show().setRevealProgress(0).setLabelOpacity(0);

  await proof.animate(durationSeconds, (progress) => {
    brace.setRevealProgress(progress);

    const labelProgress = Math.min(
      1,
      Math.max(0, (progress - 0.68) / 0.32),
    );

    brace.setLabelOpacity(labelProgress);
  });

  brace.showCompleteBrace().setLabelOpacity(1);
}

