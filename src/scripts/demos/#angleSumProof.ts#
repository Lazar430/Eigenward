  angleBAlpha,
  angleBBeta,
  angleERight,
  angleFRight,
  angleGRight,
  angleEBeta,
];

const allLabels = Object.values(angleLabels);
const allBraces = Object.values(braces);

function resetScene(): void {
  scene.setView({
    viewHeight: initialView.viewHeight,
    center: initialView.center,
    unitSizePixels: null,
  });

  for (const segment of allSegments) {
    segment.hide();
  }

  for (const angle of allAngles) {
    angle.hide().setRadius(0);
  }

  for (const label of allLabels) {
    label.hide().setOpacity(0);
  }

  for (const brace of allBraces) {
    brace.hide().setRevealProgress(0).setLabelOpacity(0);
  }
}

