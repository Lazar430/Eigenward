---
interface Props {
  id: string;
  label: string;
  aspectRatio?: string;
  class?: string;
}

const {
  id,
  label,
  aspectRatio = "16 / 9",
  class: className,
} = Astro.props;
---

<div
  class:list={["math-canvas-shell", className]}
  style={`--math-canvas-aspect: ${aspectRatio};`}
>
  <canvas id={id} role="img" aria-label={label}>{label}</canvas>
</div>

<style>
  .math-canvas-shell {
    position: relative;
    width: 100%;
    aspect-ratio: var(--math-canvas-aspect);
    overflow: hidden;
    border: 1px solid rgba(198, 180, 255, 0.18);
    border-radius: 1.15rem;
    background:
      radial-gradient(
        circle at 18% 20%,
        rgba(112, 231, 255, 0.08),
        transparent 32%
      ),
      radial-gradient(
        circle at 82% 76%,
        rgba(255, 107, 158, 0.08),
        transparent 34%
      ),
      rgba(16, 12, 28, 0.48);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 1.2rem 3rem rgba(3, 1, 10, 0.22);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    user-select: none;
  }
</style>
