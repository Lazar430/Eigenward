---
import MathCanvas2D from "./MathCanvas2D.astro";
---

<section class="vector-determinant-demos" aria-labelledby="vector-demo-heading">
  <header class="demo-heading">
    <p class="eyebrow">Linear algebra interaction laboratory</p>
    <h2 id="vector-demo-heading">Vectors and determinant area</h2>
  </header>

  <article class="demo-card">
    <div class="demo-copy">
      <h3>Scene 1: interaction belongs to the scene</h3>
      <p>
        Drag the cyan vector by its tip. The magenta vector uses the same
        Vector2D class but is not registered with the drag controller, so it
        remains inert.
      </p>
    </div>
    <MathCanvas2D
      id="about-vector-drag-scene"
      label="One draggable cyan vector and one noninteractive magenta vector"
      aspectRatio="16 / 8"
    />
  </article>

  <article class="demo-card">
    <div class="demo-copy">
      <h3>Scene 2: interactive determinant area</h3>
      <p>
        Drag either arrow tip. The shaded parallelogram is rebuilt from the two
        current displacement vectors, so its area changes with their determinant.
      </p>
    </div>
    <MathCanvas2D
      id="about-determinant-interactive-scene"
      label="Two draggable basis vectors with a changing shaded parallelogram"
      aspectRatio="16 / 9"
    />
  </article>

  <article class="demo-card">
    <div class="demo-copy">
      <h3>Scene 3: matrix and inverse matrix</h3>
      <p>
        A literal 2 by 2 matrix transforms both basis vectors. A second phase
        applies its computed inverse, restoring the original vectors before the
        animation repeats.
      </p>
    </div>
    <MathCanvas2D
      id="about-determinant-transformation-scene"
      label="An animated matrix transformation of a vector basis and its parallelogram"
      aspectRatio="16 / 9"
    />
  </article>
</section>

<script>
  import "../../scripts/demos/aboutVectorDragScene";
  import "../../scripts/demos/aboutDeterminantInteractiveScene";
  import "../../scripts/demos/aboutDeterminantTransformationScene";
</script>

<style>
  .vector-determinant-demos {
    display: grid;
    gap: 2rem;
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .demo-heading {
    max-width: 52rem;
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    color: #91efff;
    font-size: 0.78rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
  }

  .demo-card {
    display: grid;
    gap: 1rem;
  }

  .demo-copy {
    max-width: 58rem;
  }

  .demo-copy h3 {
    margin-bottom: 0.45rem;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .demo-copy p {
    margin-bottom: 0;
    color: rgba(239, 234, 255, 0.68);
    line-height: 1.7;
  }
</style>
