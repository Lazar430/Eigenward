  <script>
  import { HomepageSceneController } from "../scripts/homepage/HomepageSceneController";

  const oddityCanvas = document.querySelector<HTMLCanvasElement>(
    "[data-oddity-exhibition-canvas]",
  );

  const oddityCard = document.querySelector<HTMLAnchorElement>(
    "[data-oddity-exhibition-link]",
  );

  const oddityLoaderLabel = document.querySelector<HTMLElement>(
    "[data-oddity-loader-label]",
  );

  const oddityChoices = [
    {
      key: "cow-to-sphere",
      canvasId: "cow-to-sphere-scene",
      href: oddityCard?.getAttribute("href") ?? "/",
      load: async () => {
        const module = await import(
          "../scripts/animations/lessons/topology/cowToSphere"
        );
        return module.mountCowToSphere;
      },
    },
    {
      key: "mug-to-donut",
      canvasId: "mug-to-donut-scene",
      href: oddityCard?.getAttribute("href") ?? "/",
      load: async () => {
        const module = await import(
          "../scripts/animations/lessons/topology/mugToDonut"
        );
        return module.mountMugToDonut;
      },
    },
  ];

  const oddityChoice =
    oddityChoices[Math.floor(Math.random() * oddityChoices.length)];

  const oddityScenes = new HomepageSceneController({
    maxMounted: 1,
    idleDestroyMs: 25_000,
  });

  let oddityWanted = false;
  let oddityActivationTicket = 0;

  function setOddityState(
    state: "idle" | "loading" | "ready" | "error",
  ): void {
    if (!oddityCard) return;
    oddityCard.dataset.oddityState = state;

    if (!oddityLoaderLabel) return;

    oddityLoaderLabel.textContent =
      state === "error"
        ? "Exhibit could not be prepared."
        : "Preparing exhibit…";
  }

  function afterTwoFrames(): Promise<void> {
    return new Promise((resolve) => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => resolve());
      });
    });
  }

  async function activateOddity(): Promise<void> {
    if (!oddityCanvas || !oddityCard || !oddityChoice) return;

    oddityWanted = true;
    const ticket = ++oddityActivationTicket;

    if (!oddityScenes.isMounted(oddityChoice.key)) {
      setOddityState("loading");
    }

    const handle = await oddityScenes.activate(oddityChoice.key);

    if (
      ticket !== oddityActivationTicket ||
      !oddityWanted
    ) {
      return;
    }

    if (!handle) {
      setOddityState("error");
      return;
    }

    /*
     * Mounting a Three.js scene is not quite the same thing as having pixels
     * ready to reveal. Give the renderer and its resize/visibility observers
     * two browser frames to settle before fading the canvas in.
     */
    await afterTwoFrames();

    if (
      ticket === oddityActivationTicket &&
      oddityWanted
    ) {
      setOddityState("ready");
    }
  }

  function deactivateOddity(): void {
    if (!oddityChoice) return;

    oddityWanted = false;
    oddityActivationTicket += 1;

    oddityScenes.deactivate(oddityChoice.key, {
      destroyAfterMs: 25_000,
    });
  }

  if (oddityCanvas && oddityCard && oddityChoice) {
    oddityCanvas.id = oddityChoice.canvasId;
    oddityCanvas.dataset.oddityKey = oddityChoice.key;
    oddityCard.dataset.oddityKey = oddityChoice.key;
    oddityCard.href = oddityChoice.href;

    oddityScenes.register({
      key: oddityChoice.key,
      canvas: oddityCanvas,
      load: oddityChoice.load,
    });
  }

  /*
   * The enlarged root begins preparing the selected 3D exhibit while the user
   * is still travelling down the incoming winding connector. This is a bounded
   * one-scene prewarm, not an eager load of every homepage animation.
   */
  const oddityObserver =
    oddityCard && oddityChoice && "IntersectionObserver" in window
      ? new IntersectionObserver(
          ([entry]) => {
            if (!entry) return;

            if (entry.isIntersecting && entry.intersectionRatio >= 0.15) {
              void activateOddity();
            } else {
              deactivateOddity();
            }
          },
          {
            threshold: [0, 0.15, 1],
            rootMargin: "65% 0px 65% 0px",
          },
        )
      : null;

  if (oddityCard && oddityChoice) {
    if (oddityObserver) oddityObserver.observe(oddityCard);
    else void activateOddity();
  }

  document.addEventListener(
    "astro:before-swap",
    () => {
      oddityWanted = false;
      oddityActivationTicket += 1;
      oddityObserver?.disconnect();
      oddityScenes.destroyAll();
    },
    { once: true },
  );
</script>

