/*
 * A compact hierarchical overview inspired by the full Branches-page
 * sunbursts. This is intentionally a conceptual map rather than a claim that
 * every parent is a strict prerequisite for every child. The containment is
 * meant to suggest a useful progression from foundational languages toward
 * more specialized subjects.
 *
 * Edit only `parent` to reorganize the homepage map. The angular layout and
 * ring depths are derived automatically.
 */
type OverviewBranchId =
  | "logic"
  | "set-theory"
  | "linear-algebra"
  | "combinatorics"
  | "probability"
  | "topology"
  | "analysis"
  | "mathematical-physics"
  | "abstract-algebra"
  | "number-theory"
  | "geometry";

type OverviewBranch = {
  id: OverviewBranchId;
  label: string;
  href: string;
  color: string;
  parent: OverviewBranchId | null;
  minimumWeight?: number;
};

const overviewBranches: OverviewBranch[] = [
  {
    id: "logic",
    label: "Logic",
    href: withBase("branches/logic/"),
    color: "#8e7dff",
    parent: null,
    minimumWeight: 1.35,
  },
  {
    id: "set-theory",
    label: "Set Theory",
    href: withBase("branches/set-theory/"),
    color: "#8e7dff",
    parent: null,
  },
  {
    id: "linear-algebra",
    label: "Linear Algebra",
    href: withBase("branches/linear-algebra/"),
    color: "#ff7597",
    parent: null,
  },

  /* Logic / discrete thread. */
  {
    id: "combinatorics",
    label: "Combinatorics",
    href: withBase("branches/combinatorics/"),
    color: "#f4bd61",
    parent: "logic",
  },
  {
    id: "probability",
    label: "Probability",
    href: withBase("branches/probability/"),
    color: "#7fa0ff",
    parent: "combinatorics",
  },

  /* Set-theoretic / structural-and-continuous thread. */
  {
    id: "topology",
    label: "Topology",
    href: withBase("branches/topology/"),
    color: "#2fd6a3",
    parent: "set-theory",
  },
  {
    id: "analysis",
    label: "Real Analysis",
    href: withBase("branches/real-analysis/"),
    color: "#65b7ff",
    parent: "set-theory",
  },
  {
    id: "mathematical-physics",
    label: "Mathematical Physics",
    href: withBase("branches/mathematical-physics/"),
    color: "#d68cff",
    parent: "analysis",
  },

  /* Structural / algebraic continuation. */
  {
    id: "abstract-algebra",
    label: "Abstract Algebra",
    href: withBase("branches/abstract-algebra/"),
    color: "#ff7597",
    parent: "linear-algebra",
  },
  {
    id: "number-theory",
    label: "Number Theory",
    href: withBase("branches/number-theory/"),
    color: "#ffb04f",
    parent: "abstract-algebra",
  },
  {
    id: "geometry",
    label: "Geometry",
    href: withBase("branches/geometry/"),
    color: "#52ddc7",
    parent: "linear-algebra",
  },
];

const OVERVIEW_SIZE = 900;
const OVERVIEW_CENTER = OVERVIEW_SIZE / 2;
const OVERVIEW_INNER_RADIUS = 112;
const OVERVIEW_OUTER_RADIUS = 390;
const OVERVIEW_GAP = 0.010;

function clamp(value: number, minimum: number, maximum: number) {
  return Math.min(maximum, Math.max(minimum, value));
}

function hexToRgb(hex: string): [number, number, number] {
  const value = hex.replace("#", "");
  return [
    Number.parseInt(value.slice(0, 2), 16),
    Number.parseInt(value.slice(2, 4), 16),
    Number.parseInt(value.slice(4, 6), 16)
  ];
}

function mixHex(left: string, right: string, amount: number): string {
  const a = hexToRgb(left);
  const b = hexToRgb(right);
  const t = clamp(amount, 0, 1);

  const mixed = a.map((channel, index) =>
    Math.round(channel + (b[index] - channel) * t)
  );

  return `rgb(${mixed[0]}, ${mixed[1]}, ${mixed[2]})`;
}

function polar(radius: number, angle: number): [number, number] {
  return [
    OVERVIEW_CENTER + radius * Math.cos(angle),
    OVERVIEW_CENTER + radius * Math.sin(angle)
  ];
}

/*
 * Keep the sampled-polygon sector implementation from the previous homepage.
 * It avoids the Firefox/WebRender arc-tessellation artifact that used to leave
 * a triangular chip missing after the chart left and re-entered the viewport.
 */
function annularSectorPath(
  innerRadius: number,
  outerRadius: number,
  startAngle: number,
  endAngle: number
): string {
  const start = startAngle + OVERVIEW_GAP;
  const end = endAngle - OVERVIEW_GAP;
  const samples = 32;

  const outerPoints = Array.from({ length: samples + 1 }, (_, index) => {
    const t = index / samples;
    const angle = start + (end - start) * t;
    return polar(outerRadius, angle);
  });

  const innerPoints = Array.from({ length: samples + 1 }, (_, index) => {
    const t = index / samples;
    const angle = end - (end - start) * t;
    return polar(innerRadius, angle);
  });

  const [firstX, firstY] = outerPoints[0];

  return [
    `M ${firstX} ${firstY}`,
    ...outerPoints.slice(1).map(([x, y]) => `L ${x} ${y}`),
    ...innerPoints.map(([x, y]) => `L ${x} ${y}`),
    "Z"
  ].join(" ");
}

function splitLabel(label: string): string[] {
  const words = label.split(/\s+/).filter(Boolean);

  if (words.length <= 1) return [label];
  if (words.length === 2) return words;

  const midpoint = Math.ceil(words.length / 2);

  return [
    words.slice(0, midpoint).join(" "),
    words.slice(midpoint).join(" ")
  ];
}

type OverviewNode = OverviewBranch & {
  children: OverviewNode[];
  depth: number;
  weight: number;
  startAngle: number;
  endAngle: number;
};

const overviewNodeMap = new Map<OverviewBranchId, OverviewNode>(
  overviewBranches.map((branch) => [
    branch.id,
    {
      ...branch,
      children: [],
      depth: 1,
      weight: 1,
      startAngle: 0,
      endAngle: 0,
    },
  ]),
);

const overviewRoots: OverviewNode[] = [];

for (const node of overviewNodeMap.values()) {
  const parent = node.parent ? overviewNodeMap.get(node.parent) : undefined;

  if (parent && parent !== node) parent.children.push(node);
  else overviewRoots.push(node);
}

function assignOverviewDepth(node: OverviewNode, depth: number): void {
  node.depth = depth;
  for (const child of node.children) assignOverviewDepth(child, depth + 1);
}

for (const root of overviewRoots) assignOverviewDepth(root, 1);

function assignOverviewWeight(node: OverviewNode): number {
  const childWeight = node.children.reduce(
    (sum, child) => sum + assignOverviewWeight(child),
    0,
  );

  node.weight = Math.max(
    node.minimumWeight ?? 1,
    childWeight,
  );

  return node.weight;
}

for (const root of overviewRoots) assignOverviewWeight(root);

function assignOverviewAngles(
  nodes: OverviewNode[],
  startAngle: number,
  endAngle: number,
): void {
  const totalWeight = nodes.reduce((sum, node) => sum + node.weight, 0);
  const totalSpan = endAngle - startAngle;
  let cursor = startAngle;

  for (const node of nodes) {
    const span = totalSpan * (node.weight / totalWeight);
    node.startAngle = cursor;
    node.endAngle = cursor + span;

    if (node.children.length > 0) {
      assignOverviewAngles(node.children, node.startAngle, node.endAngle);
    }

    cursor += span;
  }
}

assignOverviewAngles(
  overviewRoots,
  -Math.PI / 2,
  Math.PI * 1.5,
);

const overviewNodes = Array.from(overviewNodeMap.values());
const overviewMaximumDepth = Math.max(...overviewNodes.map((node) => node.depth));
const overviewRadiusBoundaries = Array.from(
  { length: overviewMaximumDepth + 1 },
  (_, index) =>
    OVERVIEW_INNER_RADIUS +
    ((OVERVIEW_OUTER_RADIUS - OVERVIEW_INNER_RADIUS) * index) /
      overviewMaximumDepth,
);

const overviewSectors = overviewNodes.map((node) => {
  const innerRadius = overviewRadiusBoundaries[node.depth - 1];
  const outerRadius = overviewRadiusBoundaries[node.depth];
  const midRadius = (innerRadius + outerRadius) / 2;
  const midAngle = (node.startAngle + node.endAngle) / 2;
  const [textX, textY] = polar(midRadius, midAngle);

  let rotation = (midAngle * 180) / Math.PI + 90;
  const normalized = ((rotation % 360) + 360) % 360;

  if (normalized > 90 && normalized < 270) rotation += 180;

  const lines = splitLabel(node.label);
  const fontSize = node.depth === 1
    ? 18
    : lines.length === 1
      ? 17
      : 15.5;
  const lineHeight = fontSize * 1.08;
  const darkness = 0.08 + (node.depth - 1) * 0.075;

  return {
    id: node.id,
    parentId: node.parent,
    label: node.label,
    href: node.href,
    depth: node.depth,
    path: annularSectorPath(
      innerRadius,
      outerRadius,
      node.startAngle,
      node.endAngle,
    ),
    fill: mixHex(node.color, "#1c1432", darkness),
    fillOpacity: clamp(0.90 - (node.depth - 1) * 0.045, 0.80, 0.90),
    stroke: mixHex(node.color, "#120b24", 0.62),
    textX,
    textY,
    rotation,
    fontSize,
    lines: lines.map((line, lineIndex) => ({
      text: line,
      dy:
        lineIndex === 0
          ? lines.length === 1
            ? "0"
            : `${-lineHeight / 2}px`
          : `${lineHeight}px`,
    })),
  };
});
---

<BaseLayout
  title="Home"
  description="A mathematical library of proofs, problems, animations, essays, and research notes."
>
  <!--
    Batch 3: native vertical scrolling now drives a horizontal presentation
    camera while the reader crosses the long winding route between stops.

    The camera uses translation only. That is deliberate: descendant
    MathScene2D/MathScene3D canvases keep exactly the same measured CSS size
    while the page appears to travel left and right through the larger world.
  -->
  <script is:inline>
    /*
     * Mark this document as spatial-JS-capable before the journey can paint.
     * CSS uses the marker to suppress the one-frame unpositioned flash while
     * the controller synchronizes with restored scroll position.
     */
    document.documentElement.dataset.homeSpatialJs = "true";
  </script>

  <div class="home-spatial-journey" data-home-spatial-journey>
  <div
    class="home-spatial-track"
    data-home-spatial-track
    data-spatial-ready="false"
    aria-label="Homepage journey"
  >
  <div
    class="home-spatial-stop home-spatial-stop--intro"
    data-spatial-stop
    data-spatial-key="intro"
    data-spatial-index="0"
    data-spatial-arrived="false"
    data-spatial-current="false"
    data-spatial-x="0"
    data-spatial-rotation="0"
    data-spatial-anchor="center"
  >
    <section class="home-hero">
      <p class="home-kicker">
        Proofs · problems · animations · research notes
      </p>

      <h1>A finitely large napkin.</h1>

      <p class="home-lead">
        For those seeking guidance, look to eigenward.
      </p>
    </section>

    <figure class="sanderson-quote">
      <blockquote>
        “The devils in the upper right quadrant aren't nearly appreciative enough
        of projective geometry”
      </blockquote>

      <figcaption>— Grant Sanderson</figcaption>
    </figure>
  </div>
  <div
    class="home-spatial-connector"
    data-spatial-connector="center-right"
    aria-hidden="true"
  >
    <svg viewBox="0 0 1000 180" preserveAspectRatio="none" focusable="false">
      <path data-spatial-route-path d="M 500 4 C 500 78 720 92 955 176"></path>
    </svg>
  </div>
  <div
    class="home-spatial-stop home-spatial-stop--right home-spatial-stop--branches"
    data-spatial-stop
    data-spatial-key="branches"
    data-spatial-index="1"
    data-spatial-arrived="false"
    data-spatial-current="false"
    data-spatial-x="0.56"
    data-spatial-rotation="1.2"
    data-spatial-anchor="right"
  >
    <section class="front-section">
      <div class="section-header">
        <h2>Rough sketch of topics</h2>

        <p>
          For a more detailed overview of stuff you can find in here, check the
          Branches page.
        </p>
      </div>

      <div
        class="home-sunburst-viewport"
        data-home-sunburst-viewport
        aria-label="Overview of the main branches of mathematics"
      >
        <canvas
          class="home-sunburst-canvas"
          data-home-sunburst-canvas
          aria-hidden="true"
        ></canvas>

        <!--
          The SVG is now ONLY an invisible interaction map. Nothing visible is
          painted with SVG paths anymore, so the old triangular sector chip
          cannot be a visible SVG/WebRender artifact.
        -->
        <svg
          class="home-sunburst-hit-map"
          viewBox={`0 0 ${OVERVIEW_SIZE} ${OVERVIEW_SIZE}`}
          aria-hidden="true"
        >
          {overviewSectors.map((sector, index) => (
            <a
              class="home-sunburst-hit-sector"
              href={sector.href}
              aria-label={sector.label}
              data-sunburst-sector
              data-index={index}
              data-sector-id={sector.id}
              data-parent-id={sector.parentId ?? ""}
              data-depth={sector.depth}
              data-path={sector.path}
              data-fill={sector.fill}
              data-fill-opacity={sector.fillOpacity}
              data-stroke={sector.stroke}
              data-text-x={sector.textX}
              data-text-y={sector.textY}
              data-rotation={sector.rotation}
              data-font-size={sector.fontSize}
              data-lines={sector.lines.map((line) => line.text).join("|")}
            >
              <path
                d={sector.path}
                fill="rgba(255, 255, 255, 0.001)"
                stroke="none"
              ></path>
            </a>
          ))}

          <a
            class="home-sunburst-hit-center"
            href={withBase("branches/")}
            aria-label="Open the full Branches page"
            data-sunburst-center
          >
            <circle
              cx={OVERVIEW_CENTER}
              cy={OVERVIEW_CENTER}
              r={OVERVIEW_INNER_RADIUS - 5}
              fill="rgba(255, 255, 255, 0.001)"
            ></circle>
          </a>
        </svg>
      </div>
    </section>

  </div>
  <div
    class="home-spatial-connector"
    data-spatial-connector="right-left"
    aria-hidden="true"
  >
    <svg viewBox="0 0 1000 180" preserveAspectRatio="none" focusable="false">
      <path data-spatial-route-path d="M 955 4 C 790 86 210 94 45 176"></path>
    </svg>
  </div>
  <div
    class="home-spatial-stop home-spatial-stop--left home-spatial-stop--featured"
    data-spatial-stop
    data-spatial-key="featured-articles"
    data-spatial-index="2"
    data-spatial-arrived="false"
    data-spatial-current="false"
    data-spatial-x="-0.62"
    data-spatial-rotation="-1.4"
    data-spatial-anchor="left"
  >
    <section
      class="front-section featured-articles-section"
      aria-labelledby="featured-articles-heading"
    >
      <div
        class="featured-hex-orbit"
        aria-label="Featured articles"
      >
        <a
          class="featured-hex-center"
          href={withBase("articles/")}
          aria-label="Browse all articles"
          data-featured-hex-center
          data-preview-active="false"
        >
          <h2 id="featured-articles-heading">
            Featured
            <span>Articles</span>
          </h2>

          <div
            class="featured-hex-animation-stage"
            aria-hidden="true"
          >
            <!--
              One physical WebGL canvas is deliberately reused by every featured
              article preview. Each article still has its own loader/animation,
              but exploring six hexagons can no longer allocate six persistent
              WebGL contexts. The active scene is destroyed before the next one
              mounts, including its CSS2D label layer.
            -->
            <div
              class="featured-hex-animation-slot"
              data-featured-preview-slot
              data-preview-active="false"
              aria-hidden="true"
            >
              <div class="featured-hex-animation-mount">
                <canvas
                  id="featured-article-preview-canvas"
                  class="featured-hex-animation-canvas"
                  data-featured-preview-canvas
                  aria-hidden="true"
                ></canvas>
              </div>
            </div>
          </div>
        </a>

        {
          featuredArticles.map((article, index) => (
            <a
              class="featured-hex-card"
              href={article.href}
              aria-label={`Read ${article.title}`}
              data-hex-position={index}
              data-featured-preview-trigger
              data-preview-key={article.previewKey}
              data-preview-canvas-id={article.canvasId}
            >
              <h3>{article.title}</h3>

              <div class="featured-hex-hover">
                <span class="featured-hex-eyebrow">{article.eyebrow}</span>

                <p>{article.text}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

  </div>
  <div
    class="home-spatial-connector"
    data-spatial-connector="left-right"
    aria-hidden="true"
  >
    <svg viewBox="0 0 1000 180" preserveAspectRatio="none" focusable="false">
      <path data-spatial-route-path d="M 45 4 C 210 86 790 94 955 176"></path>
    </svg>
  </div>
  <div
    class="home-spatial-stop home-spatial-stop--right home-spatial-stop--oddity"
    data-spatial-stop
    data-spatial-key="oddity-exhibition"
    data-spatial-index="3"
    data-spatial-arrived="false"
    data-spatial-current="false"
    data-spatial-x="0.62"
    data-spatial-rotation="1.15"
    data-spatial-anchor="right"
  >
    <section
      class="front-section oddity-exhibition-section"
      aria-labelledby="oddity-exhibition-heading"
    >
      <h2
        id="oddity-exhibition-heading"
        class="oddity-exhibition-title"
      >
        Oddity Exhibition
      </h2>

      <a
        class="oddity-exhibition-card"
        data-oddity-exhibition-link
        data-oddity-state="idle"
        href={withBase("")}
        aria-label="Open the Oddity Exhibition"
      >
        <div
          class="oddity-exhibition-loader"
          data-oddity-exhibition-loader
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
          <span class="oddity-loader-knot" aria-hidden="true"></span>
          <span class="oddity-loader-label" data-oddity-loader-label>
            Preparing exhibit…
          </span>
          <span class="oddity-loader-track" aria-hidden="true">
            <span></span>
          </span>
        </div>

        <canvas
          class="oddity-exhibition-canvas"
          data-oddity-exhibition-canvas
          aria-hidden="true"
        ></canvas>
      </a>
    </section>

  </div>
  <div
    class="home-spatial-connector"
    data-spatial-connector="right-left"
    aria-hidden="true"
  >
    <svg viewBox="0 0 1000 180" preserveAspectRatio="none" focusable="false">
      <path data-spatial-route-path d="M 955 4 C 790 86 210 94 45 176"></path>
    </svg>
  </div>
  <div
    class="home-spatial-stop home-spatial-stop--left home-spatial-stop--weekly"
    data-spatial-stop
    data-spatial-key="weekly"
    data-spatial-index="4"
    data-spatial-arrived="false"
    data-spatial-current="false"
    data-spatial-x="-0.54"
    data-spatial-rotation="-0.9"
    data-spatial-anchor="left"
  >
    <section class="front-section">
      <div class="home-weekly-stack">
        <a
          class="problem-card home-weekly-card"
          href={withBase("problems/")}
          aria-label="Open the problem of the week"
        >
          <header class="problem-card-header">
            <span class="problem-branch">Problem of the week</span>

            <h2>A sum of cubes</h2>
          </header>

          <div
            class="problem-formula"
            role="img"
            aria-label="Sum of cubes identity"
            set:html={problemFormula}
          />

          <p class="problem-description">
            🤤🍆
          </p>

          <span class="read-label" aria-hidden="true">
            View problem <span>→</span>
          </span>
        </a>

        <a
          class="article-card home-weekly-card theorem-card"
          href={withBase("articles/")}
          aria-label="Read the theorem of the week"
        >
          <header class="article-card-header">
            <span class="article-branch">Theorem of the week</span>

            <h2>Euler's identity</h2>
          </header>

          <div
            class="problem-formula"
            role="img"
            aria-label="Euler's identity"
            set:html={theoremFormula}
          />

          <p class="article-description">
            Now WHO was this Leonard Euler REALLY?
          </p>

          <span class="read-label" aria-hidden="true">
            Read theorem <span>→</span>
          </span>
        </a>

        <a
          class="article-card home-weekly-card mathematician-card"
          href={withBase("articles/")}
          aria-label="Read about the mathematician of the month, Emmy Noether"
        >
          <header class="article-card-header">
            <span class="article-branch">Mathematician of the month</span>

            <h2>Emmy Noether</h2>
          </header>

          <div
            class="article-canvas home-mathematician-canvas"
            role="img"
            aria-label="Reserved animation canvas for Emmy Noether"
          >
            <canvas
              id="fourier-epicycles"
              aria-hidden="true"
            ></canvas>
          </div>

          <p class="article-description">
           Her iconic 1910 digital portrait that looks conspicuously similar to the figure of Joseph Fourier.
          </p>

          <span class="read-label" aria-hidden="true">
            Read profile <span>→</span>
          </span>
        </a>
      </div>
    </section>

  </div>
  <div
    class="home-spatial-connector"
    data-spatial-connector="left-right"
    aria-hidden="true"
  >
    <svg viewBox="0 0 1000 180" preserveAspectRatio="none" focusable="false">
      <path data-spatial-route-path d="M 45 4 C 210 86 790 94 955 176"></path>
    </svg>
