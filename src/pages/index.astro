  <script>
    const SUNBURST_SIZE = 900;
    const SUNBURST_CENTER = SUNBURST_SIZE / 2;
    const SUNBURST_INNER_RADIUS = 112;

    const sunburstViewport = document.querySelector(
      "[data-home-sunburst-viewport]"
    );

    const sunburstCanvas = sunburstViewport?.querySelector(
      "[data-home-sunburst-canvas]"
    );

    const sunburstSectorLinks = Array.from(
      sunburstViewport?.querySelectorAll(
        "[data-sunburst-sector]"
      ) ?? []
    );

    const sunburstCenterLink = sunburstViewport?.querySelector(
      "[data-sunburst-center]"
    );

    const parsedSectors = sunburstSectorLinks.map((link) => ({
      link,
      index: Number(link.dataset.index ?? 0),
      path: new Path2D(link.dataset.path ?? ""),
      id: link.dataset.sectorId ?? "",
      parentId: link.dataset.parentId || null,
      depth: Number(link.dataset.depth ?? 1),
      fill: link.dataset.fill ?? "rgb(80, 72, 112)",
      fillOpacity: Number(link.dataset.fillOpacity ?? 0.86),
      stroke: link.dataset.stroke ?? "rgb(30, 24, 50)",
      textX: Number(link.dataset.textX ?? 0),
      textY: Number(link.dataset.textY ?? 0),
      rotation: Number(link.dataset.rotation ?? 0),
      fontSize: Number(link.dataset.fontSize ?? 17),
      lines: (link.dataset.lines ?? "").split("|").filter(Boolean)
    }));

    let activeSector = null;
    let centerActive = false;

    function relatedSectorIds(activeIndex) {
      if (activeIndex === null) return new Set();

      const active = parsedSectors.find(
        (sector) => sector.index === activeIndex
      );

      if (!active) return new Set();

      const related = new Set([active.id]);

      /* Walk inward through the active sector's ancestry. */
      let parentId = active.parentId;
      while (parentId) {
        related.add(parentId);
        parentId =
          parsedSectors.find((sector) => sector.id === parentId)?.parentId ?? null;
      }

      /* Then walk outward through every descendant of the active sector. */
      let changed = true;
      while (changed) {
        changed = false;
        for (const sector of parsedSectors) {
          if (
            sector.parentId &&
            related.has(sector.parentId) &&
            !related.has(sector.id)
          ) {
            related.add(sector.id);
            changed = true;
          }
        }
      }

      return related;
    }

    function drawSunburst() {
      if (!(sunburstCanvas instanceof HTMLCanvasElement)) return;

      const rectangle = sunburstCanvas.getBoundingClientRect();
      if (rectangle.width <= 0 || rectangle.height <= 0) return;

      const pixelRatio = Math.min(
        window.devicePixelRatio || 1,
        2
      );

      const backingWidth = Math.max(
        1,
        Math.round(rectangle.width * pixelRatio)
      );

      const backingHeight = Math.max(
        1,
        Math.round(rectangle.height * pixelRatio)
      );

      if (
        sunburstCanvas.width !== backingWidth ||
        sunburstCanvas.height !== backingHeight
      ) {
        sunburstCanvas.width = backingWidth;
        sunburstCanvas.height = backingHeight;
      }

      const context = sunburstCanvas.getContext("2d");
      if (!context) return;

      context.setTransform(1, 0, 0, 1, 0, 0);
      context.clearRect(
        0,
        0,
        backingWidth,
        backingHeight
      );

      const scale =
        Math.min(
          rectangle.width,
          rectangle.height
        ) / SUNBURST_SIZE;

      const offsetX =
        (rectangle.width - SUNBURST_SIZE * scale) / 2;

      const offsetY =
        (rectangle.height - SUNBURST_SIZE * scale) / 2;

      context.setTransform(
        pixelRatio * scale,
        0,
        0,
        pixelRatio * scale,
        pixelRatio * offsetX,
        pixelRatio * offsetY
      );

      context.lineJoin = "round";
      context.lineCap = "round";

      const relatedIds = relatedSectorIds(activeSector);

      for (const sector of parsedSectors) {
        context.save();

        /*
         * Match the original SVG appearance: colored sectors are translucent,
         * so the Julia background remains visible through the sunburst.
         */
        context.globalAlpha = sector.fillOpacity;
        context.fillStyle = sector.fill;
        context.fill(sector.path);

        /*
         * Keep the boundary a little more solid than the fill, as in the
         * original SVG where stroke-opacity was not reduced with fill-opacity.
         */
        context.globalAlpha = 0.96;
        context.strokeStyle = sector.stroke;
        context.lineWidth = 2.4;
        context.stroke(sector.path);

        if (activeSector === sector.index) {
          /* Active node: strongest lift. */
          context.globalAlpha = 0.085;
          context.fillStyle = "#ffffff";
          context.fill(sector.path);
        } else if (relatedIds.has(sector.id)) {
          /* Parent/child lineage: enough lift to make the hierarchy readable. */
          context.globalAlpha = 0.028;
          context.fillStyle = "#ffffff";
          context.fill(sector.path);
        }

        context.restore();
      }

      /*
       * Center disc.
       */
      context.save();

      context.beginPath();
      context.arc(
        SUNBURST_CENTER,
        SUNBURST_CENTER,
        SUNBURST_INNER_RADIUS - 5,
        0,
        Math.PI * 2
      );

      /*
       * These are the original center-disc colors:
       *
       *   mixHex("#8e7dff", "#0d081d", 0.72)  -> rgb(49, 41, 92)
       *   mixHex("#8e7dff", "#ffffff", 0.24)  -> rgb(169, 156, 255)
       *
       * On hover/focus the ENTIRE disc receives the same subtle brightness /
       * saturation lift the SVG version used to have, rather than changing
       * only the border.
       */
      context.filter = centerActive
        ? "brightness(1.12) saturate(1.03)"
        : "none";

      context.fillStyle = "rgb(49, 41, 92)";
      context.fill();

      context.strokeStyle = "rgb(169, 156, 255)";
      context.lineWidth = 4;
      context.stroke();

      context.filter = "none";
      context.restore();

      /*
       * Sector labels are also canvas-rendered. This keeps the visible
       * sunburst in one raster surface, with no independently composited SVG
       * paths or SVG text nodes.
       */
      context.textAlign = "center";
      context.textBaseline = "middle";
      context.fillStyle = "#ffffff";
      context.strokeStyle = "rgba(8, 5, 20, 0.48)";
      context.lineJoin = "round";

      for (const sector of parsedSectors) {
        context.save();

        context.translate(
          sector.textX,
          sector.textY
        );

        context.rotate(
          sector.rotation *
          Math.PI /
          180
        );

        context.font =
          `760 ${sector.fontSize}px Inter, ui-sans-serif, system-ui, sans-serif`;

        context.lineWidth = 3;

        const lineHeight =
          sector.fontSize *
          1.08;

        const totalHeight =
          (sector.lines.length - 1) *
          lineHeight;

        sector.lines.forEach((line, index) => {
          const y =
            index *
            lineHeight -
            totalHeight / 2;

          context.strokeText(
            line,
            0,
            y
          );

          context.fillText(
            line,
            0,
            y
          );
        });

        context.restore();
      }

      context.save();

      context.fillStyle =
        "#ffffff";

      context.strokeStyle =
        "rgba(8, 5, 20, 0.48)";

      context.lineWidth =
        3;

      context.font =
        "820 29px Inter, ui-sans-serif, system-ui, sans-serif";

      context.textAlign =
        "center";

      context.textBaseline =
        "middle";

      context.strokeText(
        "Branches",
        SUNBURST_CENTER,
        SUNBURST_CENTER
      );

      context.fillText(
        "Branches",
        SUNBURST_CENTER,
        SUNBURST_CENTER
      );

      context.restore();
    }

    for (const sector of parsedSectors) {
      sector.link.addEventListener(
        "pointerenter",
        () => {
          activeSector = sector.index;
          drawSunburst();
        }
      );

      sector.link.addEventListener(
        "pointerleave",
        () => {
          activeSector = null;
          drawSunburst();
        }
      );

      sector.link.addEventListener(
        "focus",
        () => {
          activeSector = sector.index;
          drawSunburst();
        }
      );

      sector.link.addEventListener(
        "blur",
        () => {
          activeSector = null;
          drawSunburst();
        }
      );
    }

    sunburstCenterLink?.addEventListener(
      "pointerenter",
      () => {
        centerActive = true;
        drawSunburst();
      }
    );

    sunburstCenterLink?.addEventListener(
      "pointerleave",
      () => {
        centerActive = false;
        drawSunburst();
      }
    );

    sunburstCenterLink?.addEventListener(
      "focus",
      () => {
        centerActive = true;
        drawSunburst();
      }
    );

    sunburstCenterLink?.addEventListener(
      "blur",
      () => {
        centerActive = false;
        drawSunburst();
      }
    );

    const sunburstResizeObserver =
      sunburstCanvas &&
      "ResizeObserver" in window
        ? new ResizeObserver(drawSunburst)
        : null;

    if (sunburstCanvas) {
      sunburstResizeObserver?.observe(
        sunburstCanvas
      );
    }

    /*
     * Redraw on viewport entry too, but DO NOT replace DOM nodes anymore.
     * The canvas is the sole visible rendering surface; a normal redraw is
     * enough and cannot preserve a stale SVG sector tile.
     */
    const sunburstVisibilityObserver =
      sunburstViewport &&
      "IntersectionObserver" in window
        ? new IntersectionObserver(
            ([entry]) => {
              if (entry?.isIntersecting) {
                requestAnimationFrame(
                  drawSunburst
                );
              }
            },
            {
              threshold: 0.01
            }
          )
        : null;

    sunburstVisibilityObserver?.observe(
      sunburstViewport
    );

    requestAnimationFrame(
      drawSunburst
    );

    document.addEventListener(
      "astro:before-swap",
      () => {
        sunburstResizeObserver?.disconnect();
        sunburstVisibilityObserver?.disconnect();
      },
      { once: true }
    );
  </script>

  <script>
  import { HomepageSceneController } from "../scripts/homepage/HomepageSceneController";

  const featuredOrbit = document.querySelector<HTMLElement>(
    ".featured-hex-orbit",
  );

  const featuredCenter = featuredOrbit?.querySelector<HTMLElement>(
    "[data-featured-hex-center]",
  );

  const featuredTriggers = Array.from(
    featuredOrbit?.querySelectorAll<HTMLElement>(
      "[data-featured-preview-trigger]",
    ) ?? [],
  );

  const featuredPreviewSlot = featuredOrbit?.querySelector<HTMLElement>(
    "[data-featured-preview-slot]",
  );

  const featuredPreviewMount = featuredPreviewSlot?.querySelector<HTMLElement>(
    ".featured-hex-animation-mount",
  );

  const featuredPreviewCanvas = featuredPreviewSlot?.querySelector<HTMLCanvasElement>(
    "[data-featured-preview-canvas]",
  );

  const FEATURED_PREVIEW_NATIVE_WIDTH = 960;
  const FEATURED_PREVIEW_NATIVE_HEIGHT = 540;
  const FEATURED_PREVIEW_IDLE_DESTROY_MS = 12_000;

  const featuredScenes = new HomepageSceneController({
    maxMounted: 1,
    idleDestroyMs: FEATURED_PREVIEW_IDLE_DESTROY_MS,
  });

  const featuredPreviewLoaders = new Map([
    [
      "about-primitives-scene",
      async () => {
        const module = await import("../scripts/demos/aboutPrimitivesScene");
        return module.mountAboutPrimitivesScene;
      },
    ],
    [
      "about-curve-scene",
      async () => {
        const module = await import("../scripts/demos/aboutCurveScene");
        return module.mountAboutCurveScene;
      },
    ],
    [
      "about-lissajous-scene",
      async () => {
        const module = await import("../scripts/demos/aboutLissajousScene");
        return module.mountAboutLissajousScene;
      },
    ],
    [
      "about-determinant-transformation-scene",
      async () => {
        const module = await import(
          "../scripts/demos/aboutDeterminantTransformationScene"
        );
        return module.mountAboutDeterminantTransformationScene;
      },
    ],
    [
      "factorial-shuffling",
      async () => {
        const module = await import("../scripts/demos/factorialShuffling");
        return module.mountFactorialShuffling;
      },
    ],
    [
      "about-function-graph-scene",
      async () => {
        const module = await import("../scripts/demos/aboutFunctionGraphScene");
        return module.mountAboutFunctionGraphScene;
      },
    ],
  ]);

  function preparePreviewAtNativeSize(): void {
    if (!featuredPreviewMount) return;

    featuredPreviewMount.style.width = `${FEATURED_PREVIEW_NATIVE_WIDTH}px`;
    featuredPreviewMount.style.height = `${FEATURED_PREVIEW_NATIVE_HEIGHT}px`;
    featuredPreviewMount.style.setProperty("--featured-preview-scale", "1");
  }

  function fittedPreviewScale(): number {
    if (!featuredCenter) return 1;

    const rectangle = featuredCenter.getBoundingClientRect();
    const hexWidth = rectangle.width;
    const hexHeight = rectangle.height;

    if (hexWidth <= 0 || hexHeight <= 0) return 1;

    const sideConstraint =
      hexWidth /
      (
        FEATURED_PREVIEW_NATIVE_WIDTH +
        (hexWidth * FEATURED_PREVIEW_NATIVE_HEIGHT) / (2 * hexHeight)
      );

    const verticalConstraint =
      hexHeight / FEATURED_PREVIEW_NATIVE_HEIGHT;

    return Math.min(sideConstraint, verticalConstraint);
  }

  function applyMiniatureScale(): void {
    if (
      !featuredPreviewMount ||
      featuredPreviewSlot?.dataset.previewReady !== "true"
    ) {
      return;
    }

    featuredPreviewMount.style.width = `${FEATURED_PREVIEW_NATIVE_WIDTH}px`;
    featuredPreviewMount.style.height = `${FEATURED_PREVIEW_NATIVE_HEIGHT}px`;
    featuredPreviewMount.style.setProperty(
      "--featured-preview-scale",
      String(fittedPreviewScale()),
    );
  }

  if (featuredPreviewCanvas) {
    for (const [key, load] of featuredPreviewLoaders) {
      featuredScenes.register({
        key,
        canvas: featuredPreviewCanvas,
        load,
      });
    }
  }

  preparePreviewAtNativeSize();

  let activePreviewKey: string | null = null;

  async function setFeaturedPreview(previewKey: string | null): Promise<void> {
    const previousKey = activePreviewKey;
    activePreviewKey = previewKey;

    if (featuredCenter) {
      featuredCenter.dataset.previewActive =
        previewKey === null ? "false" : "true";
    }

    if (featuredPreviewSlot) {
      featuredPreviewSlot.dataset.previewActive =
        previewKey === null ? "false" : "true";
      featuredPreviewSlot.setAttribute(
        "aria-hidden",
        previewKey === null ? "true" : "false",
      );
    }

    if (previousKey && previousKey !== previewKey) {
      /*
       * Destroy before switching. Because all six previews reuse one canvas,
       * this removes the previous WebGLRenderer/CSS2D layer before the next
       * scene is allowed to mount.
       */
      featuredScenes.deactivate(previousKey, { destroyAfterMs: 0 });
    }

    if (previewKey === null) {
      if (previousKey) {
        featuredScenes.deactivate(previousKey, {
          destroyAfterMs: FEATURED_PREVIEW_IDLE_DESTROY_MS,
        });
      }

      if (featuredPreviewSlot) {
        featuredPreviewSlot.dataset.previewReady = "false";
        featuredPreviewSlot.dataset.previewInitializing = "false";
      }

      featuredOrbit?.dispatchEvent(
        new CustomEvent("featured-article-preview-change", {
          detail: { previewKey: null, canvas: null, slot: null },
        }),
      );
      return;
    }

    if (!featuredPreviewCanvas || !featuredPreviewSlot) return;

    const trigger = featuredTriggers.find(
      (candidate) => candidate.dataset.previewKey === previewKey,
    );

    const canvasId = trigger?.dataset.previewCanvasId;
    if (canvasId) featuredPreviewCanvas.id = canvasId;
    featuredPreviewCanvas.dataset.previewKey = previewKey;

    featuredPreviewSlot.dataset.previewReady = "false";
    featuredPreviewSlot.dataset.previewInitializing = "true";
    preparePreviewAtNativeSize();

    const handle = await featuredScenes.activate(previewKey);

    if (!handle) {
      featuredPreviewSlot.dataset.previewInitializing = "false";
      featuredPreviewSlot.dataset.previewReady = "false";

      if (activePreviewKey === previewKey) {
        activePreviewKey = null;
        featuredPreviewSlot.dataset.previewActive = "false";
        featuredPreviewSlot.setAttribute("aria-hidden", "true");
        if (featuredCenter) featuredCenter.dataset.previewActive = "false";
      }
      return;
    }

    if (activePreviewKey !== previewKey) return;

    featuredPreviewSlot.dataset.previewInitializing = "false";
    featuredPreviewSlot.dataset.previewReady = "true";
    applyMiniatureScale();

    featuredOrbit?.dispatchEvent(
      new CustomEvent("featured-article-preview-change", {
        detail: {
          previewKey,
          canvas: featuredPreviewCanvas,
          slot: featuredPreviewSlot,
        },
      }),
    );
  }

  function clearFeaturedPreviewIfInactive(trigger: HTMLElement): void {
    requestAnimationFrame(() => {
      const stillHovered = trigger.matches(":hover");
      const stillFocused = document.activeElement === trigger;

      if (
        !stillHovered &&
        !stillFocused &&
        activePreviewKey === trigger.dataset.previewKey
      ) {
        void setFeaturedPreview(null);
      }
    });
  }

  for (const trigger of featuredTriggers) {
    trigger.addEventListener("pointerenter", () => {
      void setFeaturedPreview(trigger.dataset.previewKey ?? null);
    });

    trigger.addEventListener("pointerleave", () => {
      clearFeaturedPreviewIfInactive(trigger);
    });

    trigger.addEventListener("focus", () => {
      void setFeaturedPreview(trigger.dataset.previewKey ?? null);
    });

    trigger.addEventListener("blur", () => {
      clearFeaturedPreviewIfInactive(trigger);
    });
  }

  const featuredPreviewResizeObserver =
    featuredCenter && "ResizeObserver" in window
      ? new ResizeObserver(applyMiniatureScale)
      : null;

  if (featuredCenter) featuredPreviewResizeObserver?.observe(featuredCenter);

  document.addEventListener(
    "astro:before-swap",
    () => {
      featuredPreviewResizeObserver?.disconnect();
      featuredScenes.destroyAll();
    },
    { once: true },
  );
</script>

  <script>
    import { mountHomepageSpatialJourney } from "../scripts/homepage/HomepageSpatialJourney";

    const spatialTrack = document.querySelector<HTMLElement>(
      "[data-home-spatial-track]",
    );

    const spatialJourney = spatialTrack
      ? mountHomepageSpatialJourney(spatialTrack, {
          desktopQuery: "(min-width: 901px)",
          cameraLeadIn: 0.12,
          cameraLeadOut: 0.10,
          focusViewportRatio: 0.52,
          arrivalProgress: 0.92,
        })
      : null;

    document.addEventListener(
      "astro:before-swap",
      () => spatialJourney?.destroy(),
      { once: true },
    );
  </script>

</BaseLayout>

