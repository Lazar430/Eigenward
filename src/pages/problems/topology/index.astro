---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TopologySidebar from "../../../components/TopologySidebar.astro";
import Math from "../../../components/Math.astro";
import { withBase } from "@/utils/paths";

const problemCards = [
  {
    branch: "Bases \u00b7 Generated Topologies",
    title: "Does This Family Form a Basis?",
    href: withBase("problems/topology/basis-test/"),
    ariaLabel: "Open Does This Family Form a Basis?",
    formula: String.raw`\mathcal B=
\{[a,b):a<b,\ a,b\in\mathbb R\}`,
    text: "Verify the basis axioms, describe the topology generated by the family, and compare it with the ordinary topology on the real line."
  },
  {
    branch: "Continuity \u00b7 Initial Topology",
    title: "Continuity Without Epsilon\u2013Delta",
    href: withBase("problems/topology/continuity-open-sets/"),
    ariaLabel: "Open Continuity Without Epsilon\u2013Delta",
    formula: String.raw`f:X\to Y,\qquad
    V\subseteq Y\text{ open}
\Longrightarrow
f^{-1}(V)\subseteq X\text{ open}`,
    text: "Prove continuity directly from inverse images and compare the argument with the corresponding metric proof when metrics are available."
  },
  {
    branch: "Products \u00b7 Box Topology",
    title: "Product or Box?",
    href: withBase("problems/topology/product-vs-box/"),
    ariaLabel: "Open Product or Box?",
    formula: String.raw`\prod_{n=1}^{\infty}(-1/n,1/n)`,
    text: "Determine which basic neighborhoods occur in the product and box topologies and use them to distinguish the two structures."
  },
  {
    branch: "Quotients \u00b7 Identification",
    title: "Glue an Interval Into a Circle",
    href: withBase("problems/topology/interval-quotient-circle/"),
    ariaLabel: "Open Glue an Interval Into a Circle",
    formula: String.raw`[0,1]/(0\sim1)\cong S^1`,
    text: "Construct an explicit map from the quotient of the interval to the circle and prove that it is a homeomorphism."
  },
  {
    branch: "Connectedness \u00b7 Continuous Images",
    title: "Why the Intermediate Value Property Is Topological",
    href: withBase("problems/topology/connected-image/"),
    ariaLabel: "Open Why the Intermediate Value Property Is Topological",
    formula: String.raw`X\text{ connected},\qquad
    f:X\to\mathbb R\text{ continuous}`,
    text: "Show that the image is an interval and recover the intermediate value phenomenon purely from connectedness."
  },
  {
    branch: "Compactness \u00b7 Open Covers",
    title: "Compactness Without Sequences",
    href: withBase("problems/topology/open-cover-compactness/"),
    ariaLabel: "Open Compactness Without Sequences",
    formula: String.raw`X=\bigcup_{\alpha\in A}U_\alpha
\quad\Longrightarrow\quad
X=U_{\alpha_1}\cup\cdots\cup U_{\alpha_n}`,
    text: "Prove compactness from the open-cover definition and compare it with sequential compactness in a setting where the two notions agree."
  },
  {
    branch: "Separation \u00b7 Hausdorff Spaces",
    title: "Compact Sets Are Closed",
    href: withBase("problems/topology/compact-closed-hausdorff/"),
    ariaLabel: "Open Compact Sets Are Closed",
    formula: String.raw`K\subseteq X,\qquad
    K\text{ compact},\quad X\text{ Hausdorff}
\Longrightarrow K\text{ closed}`,
    text: "Build the finite separation argument carefully and isolate exactly where the Hausdorff hypothesis is required."
  },
  {
    branch: "Countability \u00b7 Nonmetrizable Spaces",
    title: "A First-Countability Failure",
    href: withBase("problems/topology/first-countability-failure/"),
    ariaLabel: "Open A First-Countability Failure",
    formula: String.raw`X=[0,\omega_1],\qquad
\omega_1\in X`,
    text: "Analyze neighborhoods of the first uncountable ordinal and prove that no countable local base exists at the endpoint."
  },
  {
    branch: "Metrization \u00b7 Urysohn",
    title: "When Does a Topology Come From a Metric?",
    href: withBase("problems/topology/metrizability/"),
    ariaLabel: "Open When Does a Topology Come From a Metric?",
    formula: String.raw`T_1+\text{ regular}+\text{ second countable}
\Longrightarrow
\text{ metrizable}`,
    text: "Check the hypotheses of a metrization theorem for a concrete space and determine whether an explicit compatible metric can be constructed."
  },
  {
    branch: "Compactness \u00b7 Products",
    title: "Compactness Across an Infinite Product",
    href: withBase("problems/topology/tychonoff-product/"),
    ariaLabel: "Open Compactness Across an Infinite Product",
    formula: String.raw`X=\prod_{i\in I}X_i,\qquad
    X_i\text{ compact}`,
    text: "Explore why finite-product arguments do not immediately extend to arbitrary products and formulate the role of Tychonoff's theorem."
  },
];
---

<BaseLayout
  title="Topology Problems"
  description="A collection of topology problems on bases, continuity, products, quotients, connectedness, compactness, separation axioms, and metrization."
>
  <section class="hub-page">
    <TopologySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Topology · Problems</span>

        <h1>Problems</h1>

        <p>
          A dedicated shelf of problems involving spaces, maps, constructions,
          counterexamples, compactness arguments, and separation phenomena.
        </p>
      </section>

      <section class="problems-list" aria-labelledby="topology-problems-title">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Selected problems</span>

            <h2 id="topology-problems-title" class="section-title">
              Problem shelf
            </h2>
          </div>

          <p>
            The displayed formulas are representative snapshots rather than
            complete problem statements.
          </p>
        </div>

        <div class="problem-card-grid">
          {
            problemCards.map((problem) => (
              <a
                class="problem-card"
                href={problem.href}
                aria-label={problem.ariaLabel}
              >
                <header class="problem-card-header">
                  <span class="problem-branch">{problem.branch}</span>
                  <h3>{problem.title}</h3>
                </header>

                <div
                  class="problem-formula"
                  role="img"
                  aria-label={`Representative formula for ${problem.title}`}
                >
                  <Math tex={problem.formula} display />
                </div>

                <p class="problem-description">{problem.text}</p>

                <span class="read-label" aria-hidden="true">
                  View problem <span>→</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .problems-list {
    width: 100%;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.25rem;
  }

  .section-heading p {
    max-width: 520px;
    margin: 0;
    color: rgba(239, 234, 255, 0.62);
    line-height: 1.65;
  }

  .section-title {
    margin: 0.45rem 0 0;
    font-size: clamp(1.7rem, 3.5vw, 2.7rem);
    letter-spacing: -0.045em;
  }

  .problem-card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .problem-card {
    display: grid;
    gap: 1.2rem;
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 1.4rem;
    padding: clamp(1.15rem, 2.5vw, 1.75rem);
    color: inherit;
    background:
      radial-gradient(circle at 85% 0%, rgba(113, 230, 255, 0.09), transparent 30%),
      linear-gradient(145deg, rgba(35, 23, 67, 0.86), rgba(13, 9, 29, 0.91));
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.27),
      inset 0 1px 0 rgba(255, 255, 255, 0.045);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .problem-card:hover,
  .problem-card:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(113, 230, 255, 0.44);
    box-shadow:
      0 30px 85px rgba(0, 0, 0, 0.34),
      0 0 28px rgba(113, 230, 255, 0.08);
    outline: none;
  }

  .problem-card-header {
    display: grid;
    gap: 0.65rem;
  }

  .problem-branch {
    color: var(--accent, #71e6ff);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .problem-card h3 {
    margin: 0;
    font-size: clamp(1.65rem, 3.2vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .problem-formula {
    display: grid;
    place-items: center;
    min-width: 0;
    padding: clamp(1rem, 3vw, 2rem) 0;
    color: rgba(247, 244, 255, 0.94);
    overflow: auto hidden;
  }

  .problem-formula :global(.katex-display) {
    max-width: 100%;
    margin: 0;
  }

  .problem-formula :global(.katex) {
    font-size: clamp(0.92rem, 1.45vw, 1.22rem);
  }

  .problem-description {
    max-width: 900px;
    margin: 0;
    color: rgba(239, 234, 255, 0.72);
    font-size: clamp(0.96rem, 1.25vw, 1.06rem);
    line-height: 1.72;
  }

  .read-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    color: rgba(239, 248, 255, 0.9);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .read-label span {
    color: var(--accent, #71e6ff);
    font-size: 1.15rem;
    transition: transform 180ms ease;
  }

  .problem-card:hover .read-label span,
  .problem-card:focus-visible .read-label span {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .section-heading {
      display: grid;
      align-items: initial;
    }
  }

  @media (max-width: 600px) {
    .problem-card {
      border-radius: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .problem-card,
    .read-label span {
      transition: none;
    }

    .problem-card:hover,
    .problem-card:focus-visible {
      transform: none;
    }
  }
</style>
