---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DifferentialGeometrySidebar from "../../../components/DifferentialGeometrySidebar.astro";
import Math from "../../../components/Math.astro";
import { withBase } from "@/utils/paths";

const problemCards = [
  {
    branch: "TODO · Topic",
    title: "TODO Problem 1",
    href: withBase("problems/differential-geometry/"),
    ariaLabel: "Open TODO Problem 1",
    formula: String.raw`x+y=z`,
    text: "TODO: Add the problem description."
  },
  {
    branch: "TODO · Topic",
    title: "TODO Problem 2",
    href: withBase("problems/differential-geometry/"),
    ariaLabel: "Open TODO Problem 2",
    formula: String.raw`f(x)=x^2`,
    text: "TODO: Add the problem description."
  },
  {
    branch: "TODO · Topic",
    title: "TODO Problem 3",
    href: withBase("problems/differential-geometry/"),
    ariaLabel: "Open TODO Problem 3",
    formula: String.raw`\sum_{k=1}^{n} a_k`,
    text: "TODO: Add the problem description."
  },
  {
    branch: "TODO · Topic",
    title: "TODO Problem 4",
    href: withBase("problems/differential-geometry/"),
    ariaLabel: "Open TODO Problem 4",
    formula: String.raw`A\mathbf{x}=\mathbf{b}`,
    text: "TODO: Add the problem description."
  }
];
---

<BaseLayout
  title="Differential Geometry Problems"
  description="TODO: Write a short description for the Differential Geometry problem archive."
>
  <section class="hub-page">
    <DifferentialGeometrySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Differential Geometry · Problems</span>
        <h1>Problems</h1>
        <p>
          TODO: Introduce the Differential Geometry problem archive and explain how it will
          be organized.
        </p>
      </section>

      <section class="problems-list" aria-labelledby="differential-geometry-problems-title">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Selected problems</span>
            <h2 id="differential-geometry-problems-title" class="section-title">Problem shelf</h2>
          </div>

          <p>
            TODO: Add a short note about the representative formulas and problem
            selection.
          </p>
        </div>

        <div class="problem-card-grid">
          {problemCards.map((problem) => (
            <a class="problem-card" href={problem.href} aria-label={problem.ariaLabel}>
              <header class="problem-card-header">
                <span class="problem-branch">{problem.branch}</span>
                <h3>{problem.title}</h3>
              </header>

              <div
                class="problem-formula"
                role="img"
                aria-label={`Representative equation for ${problem.title}`}
              >
                <Math tex={problem.formula} display />
              </div>

              <p class="problem-description">{problem.text}</p>
              <span class="read-label" aria-hidden="true">
                View problem <span>→</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .problems-list { width: 100%; margin-top: clamp(2rem, 5vw, 4rem); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.25rem; }
  .section-heading p { max-width: 520px; margin: 0; color: rgba(239, 234, 255, 0.62); line-height: 1.65; }
  .section-title { margin: 0.45rem 0 0; font-size: clamp(1.7rem, 3.5vw, 2.7rem); letter-spacing: -0.045em; }
  .problem-card-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  .problem-card { display: grid; gap: 1.2rem; min-width: 0; border: 1px solid rgba(255,255,255,.11); border-radius: 1.4rem; padding: clamp(1.15rem,2.5vw,1.75rem); color: inherit; background: radial-gradient(circle at 85% 0%, rgba(113,230,255,.09), transparent 30%), linear-gradient(145deg, rgba(35,23,67,.86), rgba(13,9,29,.91)); box-shadow: 0 24px 70px rgba(0,0,0,.27), inset 0 1px 0 rgba(255,255,255,.045); text-decoration: none; overflow: hidden; transition: transform 180ms ease,border-color 180ms ease,box-shadow 180ms ease; }
  .problem-card:hover, .problem-card:focus-visible { transform: translateY(-4px); border-color: rgba(113,230,255,.44); box-shadow: 0 30px 85px rgba(0,0,0,.34),0 0 28px rgba(113,230,255,.08); outline: none; }
  .problem-card-header { display: grid; gap: .65rem; }
  .problem-branch { color: var(--accent,#71e6ff); font-size: .75rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .problem-card h3 { margin: 0; font-size: clamp(1.65rem,3.2vw,2.9rem); line-height: 1; letter-spacing: -.05em; }
  .problem-formula { display: grid; place-items: center; min-width: 0; padding: clamp(1rem,3vw,2rem) 0; color: rgba(247,244,255,.94); overflow: auto hidden; }
  .problem-formula :global(.katex-display) { max-width: 100%; margin: 0; }
  .problem-formula :global(.katex) { font-size: clamp(.92rem,1.45vw,1.22rem); }
  .problem-description { max-width: 900px; margin: 0; color: rgba(239,234,255,.72); font-size: clamp(.96rem,1.25vw,1.06rem); line-height: 1.72; }
  .read-label { display: inline-flex; align-items: center; gap: .55rem; width: fit-content; color: rgba(239,248,255,.9); font-size: .82rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .read-label span { color: var(--accent,#71e6ff); font-size: 1.15rem; transition: transform 180ms ease; }
  .problem-card:hover .read-label span, .problem-card:focus-visible .read-label span { transform: translateX(4px); }
  @media (max-width:900px) { .section-heading { display:grid; align-items:initial; } }
  @media (max-width:600px) { .problem-card { border-radius:1rem; } }
  @media (prefers-reduced-motion:reduce) { .problem-card,.read-label span { transition:none; } .problem-card:hover,.problem-card:focus-visible { transform:none; } }
</style>
