---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MathCanvas2D from "../../components/math-graphics/MathCanvas2D.astro";
---

<BaseLayout title="About">
  <section class="simple-page">
    <header class="page-heading">
      <p class="eyebrow">Math graphics laboratory</p>
      <h1>About</h1>
      <section class="topic-section" id="broad-stroke">
      <p> Idk, man. </p>
      </section>
    </header>

    <MathCanvas2D
      id="riemann-sums"
      label="Riemann sum approximation of area under a curve"
      aspectRatio="16 / 9"
    />

    <MathCanvas2D
      id="about-function-graph-scene"
      label="An explicit function graph with exact axis intersections and a draggable point"
      aspectRatio="16 / 9"
    />
    
    <MathCanvas2D
      id="circle-chords-proof-scene"
      label="Step-by-step mock geometry proof of a problem involving perpendicular circle chords"
      aspectRatio="16 / 9"
    />

    <MathCanvas2D
      id="prism-proof-scene"
      label="Proof diagram for a right prism with a square base."
      aspectRatio="16 / 9"
    />

    <MathCanvas2D
      id="sphere-proof-scene"
      label="Staged spherical geometry scene"
      aspectRatio="16 / 9"
    />

    <MathCanvas2D
      id="parallel-secant-angles-scene"
      aspectRatio="16 / 9"
    />


    <MathCanvas2D
      id="about-reference-angles-scene"
      label="Trig elements"
      aspectRatio="16 / 9"
    />

    <MathCanvas2D
      id="about-trig-all-functions-scene"
      label="Trig elements"
      aspectRatio="16 / 9"
    />
    
    <!--MathCanvas2D
      id="about-primitives-scene"
      label="Animated circles and polygons"
      aspectRatio="16 / 9"
    /-->

    <!--MathCanvas2D
      id="about-curve-scene"
      label="Trigonometry elements"
      aspectRatio="16 / 9"
    /-->

    <MathCanvas2D
      id="about-vector-drag-scene"
      label="Draggable vectors"
      aspectRatio="16 / 9"
    />

    <!--MathCanvas2D
      id="about-determinant-interactive-scene"
      label="Interactive determinant"
      aspectRatio="16 / 9"
    /-->

    <!--MathCanvas2D
      id="about-determinant-transformation-scene"
      label="Matrix transformation"
      aspectRatio="16 / 9"
    /-->

    <p class="scene-note">
      Every object is persistent geometry inside the Three.js scene graph.
      Motion and resizing alter object transforms, while outline tracing changes
      shader parameters rather than rebuilding geometry each frame.
    </p>
  </section>
</BaseLayout>

<script>
  import "../../scripts/demos/riemannSums";
  import "../../scripts/demos/circleChordsProofStages";
  import "../../scripts/demos/prismProofStages";
  import "../../scripts/demos/sphereProofStages";
  import "../../scripts/demos/parallelSecantAngles";
  import "../../scripts/demos/aboutReferenceAnglesScene";
  import "../../scripts/demos/aboutTrigAllFunctionsScene";
  //import "../../scripts/demos/aboutPrimitivesScene";
  //import "../../scripts/demos/aboutCurveScene";
  import "../../scripts/demos/aboutVectorDragScene";
  //import "../../scripts/demos/aboutDeterminantInteractiveScene";
  //import "../../scripts/demos/aboutDeterminantTransformationScene";
  import "../../scripts/demos/aboutFunctionGraphScene";
</script>

<style>
  .simple-page {
    width: min(72rem, calc(100% - 2rem));
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 5rem) 0;
  }

  .page-heading {
    max-width: 48rem;
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    color: #91efff;
    font-size: 0.78rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 0.95;
  }

  .page-heading > p:last-child,
  .scene-note {
    color: rgba(239, 234, 255, 0.68);
    line-height: 1.75;
  }

  .scene-note {
    max-width: 58rem;
    margin: 1rem 0 0;
    font-size: 0.93rem;
  }
</style>
