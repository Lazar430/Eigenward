        <h1>Differential Geometry</h1>

        <p>
          TODO: Write the main introduction to the Differential Geometry branch, its scope,
          motivation, connections, and suggested route through the material.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a
          class="hub-overview-card"
          href={withBase("branches/differential-geometry/")}
        >
          <span class="eyebrow">Core idea</span>

          <h2>TODO: Core idea</h2>

          <p>
            TODO: Summarize the central viewpoint of the subject.
          </p>
        </a>

        <a
          class="hub-overview-card formuhub-card"
          href={withBase("branches/differential-geometry/")}
        >
          <span class="eyebrow">Guiding result</span>

          <div class="hub-formula" set:html={guidingFormula} />

          <p>
            TODO: Explain why this formula or theorem is representative.
          </p>
        </a>

        <a
          class="hub-overview-card formuhub-card"
          href={withBase("branches/differential-geometry/")}
        >
          <span class="eyebrow">Second viewpoint</span>

          <div class="hub-formula" set:html={secondFormula} />

          <p>
            TODO: Add a second representative formula or structural idea.
          </p>
        </a>
      </section>

      <section class="hub-section">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            TODO: Introduce the sequential lesson path.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            TODO: Introduce the highlighted problem shelf.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a
                class="hub-problem-card"
                href={withBase("problems/differential-geometry/")}
              >
                <span class="eyebrow">Problem</span>

                <h3>{problem.title}</h3>

                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a
          class="hub-index-card"
          href={withBase("branches/differential-geometry/theorems/")}
        >
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a
          class="hub-index-card"
          href={withBase("branches/differential-geometry/definitions/")}
        >
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
