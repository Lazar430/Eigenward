---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ClassicalMechanicsSidebar from "../../../components/ClassicalMechanicsSidebar.astro";
import { withBase } from "@/utils/paths";
import katex from "katex";

const formulaOne = katex.renderToString(
  String.raw`\frac{d}{dt}\frac{\partial L}{\partial \dot q_i}-\frac{\partial L}{\partial q_i}=0`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const formulaTwo = katex.renderToString(
  String.raw`\dot q_i=\frac{\partial H}{\partial p_i},\qquad \dot p_i=-\frac{\partial H}{\partial q_i}`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const branchHref = withBase("branches/classical-mechanics/");
const lessonsHref = withBase("branches/classical-mechanics/lessons/");
const theoremsHref = withBase("branches/classical-mechanics/theorems/");
const definitionsHref = withBase("branches/classical-mechanics/definitions/");

const lessons = [
  {
    number: "01",
    title: "Kinematics in Euclidean Space",
    href: lessonsHref,
    text: "Position, velocity, acceleration, trajectories, reference frames, relative motion, coordinate descriptions, and geometric constraints."
  },
  {
    number: "02",
    title: "Newtonian Dynamics",
    href: lessonsHref,
    text: "Newton's laws, force fields, inertial frames, momentum, angular momentum, work, energy, impulses, and systems of particles."
  },
  {
    number: "03",
    title: "Conservation Laws",
    href: lessonsHref,
    text: "Linear momentum, angular momentum, energy, center-of-mass motion, symmetry intuition, and reduction of dynamical problems."
  },
  {
    number: "04",
    title: "Oscillations",
    href: lessonsHref,
    text: "Harmonic oscillators, coupled oscillators, normal modes, damping, forcing, resonance, and linear stability."
  },
  {
    number: "05",
    title: "Central-Force Motion",
    href: lessonsHref,
    text: "Two-body reduction, effective potentials, angular momentum barriers, Kepler orbits, scattering, and qualitative phase portraits."
  },
  {
    number: "06",
    title: "Rigid-Body Mechanics",
    href: lessonsHref,
    text: "Rotations, angular velocity, inertia tensor, Euler angles, principal axes, Euler equations, precession, and tops."
  },
  {
    number: "07",
    title: "Constraints and Generalized Coordinates",
    href: lessonsHref,
    text: "Holonomic and nonholonomic constraints, virtual displacements, generalized coordinates, degrees of freedom, and d'Alembert's principle."
  },
  {
    number: "08",
    title: "The Calculus of Variations",
    href: lessonsHref,
    text: "Functionals, Euler–Lagrange equations, constrained variation, geodesic-type problems, and the mathematical structure behind stationary action."
  }
];

const problems = [
  {
    title: "Reduce the two-body problem",
    text: "Pass to center-of-mass and relative coordinates and derive the one-body effective-potential description of orbital motion."
  },
  {
    title: "Find the normal modes",
    text: "Linearize a coupled mechanical system, solve the generalized eigenvalue problem, and interpret the normal coordinates."
  },
  {
    title: "Recover a conserved quantity",
    text: "Identify a continuous symmetry of a Lagrangian and use Noether's theorem to derive the associated first integral."
  }
];

const theorems = [
  "Work–Energy Theorem",
  "Noether's Theorem",
  "Euler's Rotation Theorem",
  "Bertrand's Theorem",
  "Liouville's Theorem in Hamiltonian Mechanics",
  "KAM Theorem"
];

const definitions = [
  "Configuration space",
  "Lagrangian",
  "Hamiltonian",
  "Phase space",
  "Poisson bracket",
  "Canonical transformation",
  "Inertia tensor",
  "Symplectic form"
];
---

<BaseLayout
  title="Classical Mechanics"
  description="A structured path through Newtonian, Lagrangian, Hamiltonian, rigid-body, continuum, and geometric mechanics."
>
  <section class="hub-page">
    <ClassicalMechanicsSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Branch prototype</span>

        <h1>Classical Mechanics</h1>

        <p>
          This page is the main entrance to the classical mechanics section. The subject begins with motion and force in Euclidean space, then moves toward increasingly structural formulations in generalized coordinates, variational calculus, phase space, symplectic geometry, and nonlinear dynamics.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a class="hub-overview-card" href={branchHref}>
          <span class="eyebrow">Core idea</span>

          <h2>Dynamics from structure</h2>

          <p>
            Classical mechanics studies how states evolve under forces or variational principles, and how symmetry, conservation laws, geometry, and phase-space structure organize that evolution.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Lagrangian dynamics</span>

          <div class="hub-formula" set:html={formulaOne} />

          <p>
            The Euler–Lagrange equations replace coordinate-specific force balances with a variational law that works naturally in generalized coordinates.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Hamiltonian dynamics</span>

          <div class="hub-formula" set:html={formulaTwo} />

          <p>
            Hamilton's equations turn mechanics into a first-order flow on phase space and expose the symplectic geometry behind conservation and canonical transformations.
          </p>
        </a>
      </section>

      <section class="hub-section" id="lessons">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            A sequential route through the central ideas. These cards show the
            opening portion of the complete lesson path.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section" id="problems">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            A small rotating shelf of representative problems, with the complete
            archive living in the shared Problems section.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a class="hub-problem-card" href={withBase("problems/classical-mechanics/")}>
                <span class="eyebrow">Problem</span>

                <h3>{problem.title}</h3>

                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a class="hub-index-card" id="theorems" href={theoremsHref}>
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a class="hub-index-card" id="definitions" href={definitionsHref}>
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
