  "Closed set",
  "Closure",
  "Compact space",
  "Compact-open topology",
  "Completely regular space",
  "Component",
  "Connected space",
  "Continuous map",
  "Countability axiom",
  "Dense subset",
  "Discrete topology",
  "Embedding",
  "Filter",
  "First-countable space",
  "Hausdorff space",
  "Homeomorphism",
  "Interior",
  "Interior point",
  "Isolated point",
  "Limit point",
  "Lindel\u00f6f space",
  "Local base",
  "Locally compact space",
  "Locally connected space",
  "Locally finite family",
  "Locally path-connected space",
  "Metric topology",
  "Metrizable space",
  "Neighborhood",
  "Net",
  "Normal space",
  "Open cover",
  "Open map",
  "Open set",
  "Paracompact space",
  "Partition of unity",
  "Path",
  "Path component",
  "Path-connected space",
  "Product topology",
  "Proper map",
  "Pseudometric",
  "Quotient map",
  "Quotient space",
  "Regular space",
  "Retraction",
  "Second-countable space",
  "Separable space",
  "Separation",
  "Sequentially compact space",
  "Subbase",
  "Subspace topology",
  "T0 space",
  "T1 space",
  "Topological embedding",
  "Topological invariant",
  "Topological manifold",
  "Topological space",
  "Topology",
  "Tychonoff space",
  "Ultrafilter",
  "Uniform topology"
];

const letters = [...new Set(items.map((item) => item[0].toUpperCase()))];
---

<BaseLayout
  title="Topology Definitions"
  description="An alphabetical index of topology definitions."
>
  <section class="hub-page">
    <TopologySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Topology · Definitions</span>

        <h1>Definitions</h1>

        <p>
          An alphabetical index of the principal spaces, maps, local and global properties, separation conditions, and constructions used throughout the topology section.
        </p>
      </section>

      <section class="index-tools" aria-label="Definitions index controls">
        <label class="search-control">
          <span>Search definitions</span>
          <input
            id="definition-search"
            type="search"
            placeholder="Try “compact”, “quotient”, “Hausdorff”…"
            autocomplete="off"
          />
        </label>

        <nav class="alphabet-nav" aria-label="Jump to letter">
          {
            letters.map((letter) => (
              <a href={`#definitions-${letter}`}>{letter}</a>
            ))
          }
        </nav>

        <output id="definition-result-count" aria-live="polite">
          {items.length} definitions
        </output>
      </section>

      <div class="alphabet-index" id="definition-index">
        <section class="alphabet-group" data-alpha-group>
          <h2 id="definitions-A">A</h2>

          <div class="alphabet-entry-list">
            <a
