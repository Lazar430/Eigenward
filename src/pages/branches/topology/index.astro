---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TopologySidebar from "../../../components/TopologySidebar.astro";
import Math from "../../../components/Math.astro";
import { withBase } from "@/utils/paths";

const topologyAxioms = String.raw`
\varnothing,X\in\tau,\qquad
\bigcup_{i\in I}U_i\in\tau,\qquad
U_1\cap\cdots\cap U_n\in\tau
`;

const continuity = String.raw`
f:X\to Y\text{ continuous}
\quad\Longleftrightarrow\quad
V\in\tau_Y\Longrightarrow f^{-1}(V)\in\tau_X
`;

const lessons = [
  {
    number: "01",
    title: "Topological Spaces",
    href: withBase("branches/topology/lessons/"),
    text: "Open sets, topology axioms, neighborhoods, closed sets, interior, closure, boundary, and the first examples."
  },
  {
    number: "02",
    title: "Bases and Subbases",
    href: withBase("branches/topology/lessons/"),
    text: "Generating topologies efficiently through bases and subbases, comparing topologies, and working with standard constructions."
  },
  {
    number: "03",
    title: "Continuous Maps and Homeomorphisms",
    href: withBase("branches/topology/lessons/"),
    text: "Continuity through inverse images, homeomorphisms, embeddings, quotient maps, and topological invariants."
  },
  {
    number: "04",
    title: "Product and Quotient Spaces",
    href: withBase("branches/topology/lessons/"),
    text: "Product topologies, projections, quotient topologies, identifications, and spaces built from simpler pieces."
  },
  {
    number: "05",
    title: "Compactness",
    href: withBase("branches/topology/lessons/"),
    text: "Open-cover compactness, finite intersection properties, compact images, local compactness, and compactification."
  },
  {
    number: "06",
    title: "Connectedness",
    href: withBase("branches/topology/lessons/"),
    text: "Connected spaces, components, path connectedness, local connectedness, and the ways spaces split into pieces."
  },
  {
    number: "07",
    title: "Separation and Countability",
    href: withBase("branches/topology/lessons/"),
    text: "T0\u2013T4 separation axioms, first and second countability, separability, Lindel\u00f6f spaces, and regularity phenomena."
  },
  {
    number: "08",
    title: "Metric and Metrization Theory",
    href: withBase("branches/topology/lessons/"),
    text: "Metric topologies, completeness, compactness in metric spaces, Urysohn metrization, and the boundary between metric and non-metric spaces."
  },
];

const problems = [
  {
    title: "A topology from a basis",
    text: "Verify that a proposed family is a basis, determine the topology it generates, and compare it with the usual topology."
  },
  {
    title: "A quotient that changes shape",
    text: "Describe a familiar quotient space produced by identifying points and determine which properties survive the quotient."
  },
  {
    title: "Compact but not obviously so",
    text: "Prove compactness using an open-cover or finite-intersection argument rather than a metric shortcut."
  },
];

const theorems = [
  "Tychonoff's Theorem",
  "Heine\u2013Borel Theorem",
  "Urysohn Metrization Theorem",
  "Tietze Extension Theorem",
  "Alexander Subbase Theorem"
];

const definitions = [
  "Topology",
  "Basis",
  "Continuous map",
  "Homeomorphism",
  "Compact space",
  "Connected space",
  "Hausdorff space",
  "Quotient space"
];

const branchHref = withBase("branches/topology/");
---

<BaseLayout
  title="Topology"
  description="A structured path through topological spaces, continuity, bases, products, quotients, compactness, connectedness, separation axioms, and metrization."
>
  <section class="hub-page">
    <TopologySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Branch prototype</span>

        <h1>Topology</h1>

        <p>
          This page is the main entrance to the topology section. The branch
          studies which properties of spaces survive continuous deformation,
          how local neighborhoods determine global structure, and how familiar
          ideas from metric spaces persist after distance itself is removed.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a class="hub-overview-card" href={branchHref}>
          <span class="eyebrow">Core idea</span>

          <h2>Structure without distance</h2>

          <p>
            Topology keeps track of neighborhoods, continuity, convergence, and
            global shape while discarding rigid measurements such as lengths
            and angles.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Topological structure</span>

          <div class="hub-formula">
            <Math tex={topologyAxioms} display />
          </div>

          <p>
            A topology is a family of open sets stable under arbitrary unions
            and finite intersections and containing both the empty set and the
            entire space.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Continuity</span>

          <div class="hub-formula">
            <Math tex={continuity} display />
          </div>

          <p>
            Continuity is expressed entirely through open sets: inverse images
            of open sets must remain open.
          </p>
        </a>
      </section>

      <section class="hub-section" id="lessons">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            A sequential path through the central ideas. These cards are only
            highlights; the complete curriculum lives on the lessons page.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section" id="problems">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            A small shelf of representative problems from the branch.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a
                class="hub-problem-card"
                href={withBase("branches/topology/problems/")}
              >
                <span class="eyebrow">Problem</span>
                <h3>{problem.title}</h3>
                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a
          class="hub-index-card"
          id="theorems"
          href={withBase("branches/topology/theorems/")}
        >
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a
          class="hub-index-card"
          id="definitions"
          href={withBase("branches/topology/definitions/")}
        >
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
