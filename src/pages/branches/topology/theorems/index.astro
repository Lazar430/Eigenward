---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import TopologySidebar from "../../../../components/TopologySidebar.astro";

const items = [
  "Alexander Subbase Theorem",
  "Baire Category Theorem",
  "Brouwer Invariance of Domain",
  "Closed Map Lemma for Compact-to-Hausdorff Maps",
  "Compactness Theorem for Metric Spaces",
  "Engelking\u2013Nagata\u2013Smirnov Metrization Theorem",
  "Heine\u2013Borel Theorem",
  "Lebesgue Number Lemma",
  "Michael Selection Theorem",
  "Nagata\u2013Smirnov Metrization Theorem",
  "One-Point Compactification Theorem",
  "Tietze Extension Theorem",
  "Tube Lemma",
  "Tychonoff's Theorem",
  "Urysohn Lemma",
  "Urysohn Metrization Theorem",
  "Wallace Lemma"
];

const letters = [...new Set(items.map((item) => item[0].toUpperCase()))];
---

<BaseLayout
  title="Topology Theorems"
  description="An alphabetical index of topology theorems."
>
  <section class="hub-page">
    <TopologySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Topology · Theorems</span>

        <h1>Theorems</h1>

        <p>
          An alphabetical index of the principal compactness, separation, extension, metrization, product, and structural theorems used throughout the topology section.
        </p>
      </section>

      <section class="index-tools" aria-label="Theorems index controls">
        <label class="search-control">
          <span>Search theorems</span>
          <input
            id="theorem-search"
            type="search"
            placeholder="Try “Urysohn”, “compact”, “Tychonoff”…"
            autocomplete="off"
          />
        </label>

        <nav class="alphabet-nav" aria-label="Jump to letter">
          {
            letters.map((letter) => (
              <a href={`#theorems-${letter}`}>{letter}</a>
            ))
          }
        </nav>

        <output id="theorem-result-count" aria-live="polite">
          {items.length} theorems
        </output>
      </section>

      <div class="alphabet-index" id="theorem-index">
        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-A">A</h2>

          <div class="alphabet-entry-list">
              <a
                id="alexander-subbase-theorem"
                class="index-entry"
                href="#alexander-subbase-theorem"
                data-index-entry
                data-search-term="alexander subbase theorem"
              >
                <span>Alexander Subbase Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-B">B</h2>

          <div class="alphabet-entry-list">
              <a
                id="baire-category-theorem"
                class="index-entry"
                href="#baire-category-theorem"
                data-index-entry
                data-search-term="baire category theorem"
              >
                <span>Baire Category Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
              <a
                id="brouwer-invariance-of-domain"
                class="index-entry"
                href="#brouwer-invariance-of-domain"
                data-index-entry
                data-search-term="brouwer invariance of domain"
              >
                <span>Brouwer Invariance of Domain</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-C">C</h2>

          <div class="alphabet-entry-list">
              <a
                id="closed-map-lemma-for-compact-to-hausdorff-maps"
                class="index-entry"
                href="#closed-map-lemma-for-compact-to-hausdorff-maps"
                data-index-entry
                data-search-term="closed map lemma for compact-to-hausdorff maps"
              >
                <span>Closed Map Lemma for Compact-to-Hausdorff Maps</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
              <a
                id="compactness-theorem-for-metric-spaces"
                class="index-entry"
                href="#compactness-theorem-for-metric-spaces"
                data-index-entry
                data-search-term="compactness theorem for metric spaces"
              >
                <span>Compactness Theorem for Metric Spaces</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-E">E</h2>

          <div class="alphabet-entry-list">
              <a
                id="engelking-nagata-smirnov-metrization-theorem"
                class="index-entry"
                href="#engelking-nagata-smirnov-metrization-theorem"
                data-index-entry
                data-search-term="engelking\u2013nagata\u2013smirnov metrization theorem"
              >
                <span>Engelking–Nagata–Smirnov Metrization Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-H">H</h2>

          <div class="alphabet-entry-list">
              <a
                id="heine-borel-theorem"
                class="index-entry"
                href="#heine-borel-theorem"
                data-index-entry
                data-search-term="heine\u2013borel theorem"
              >
                <span>Heine–Borel Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-L">L</h2>

          <div class="alphabet-entry-list">
              <a
                id="lebesgue-number-lemma"
                class="index-entry"
                href="#lebesgue-number-lemma"
                data-index-entry
                data-search-term="lebesgue number lemma"
              >
                <span>Lebesgue Number Lemma</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-M">M</h2>

          <div class="alphabet-entry-list">
              <a
                id="michael-selection-theorem"
                class="index-entry"
                href="#michael-selection-theorem"
                data-index-entry
                data-search-term="michael selection theorem"
              >
                <span>Michael Selection Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-N">N</h2>

          <div class="alphabet-entry-list">
              <a
                id="nagata-smirnov-metrization-theorem"
                class="index-entry"
                href="#nagata-smirnov-metrization-theorem"
                data-index-entry
                data-search-term="nagata\u2013smirnov metrization theorem"
              >
                <span>Nagata–Smirnov Metrization Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-O">O</h2>

          <div class="alphabet-entry-list">
              <a
                id="one-point-compactification-theorem"
                class="index-entry"
                href="#one-point-compactification-theorem"
                data-index-entry
                data-search-term="one-point compactification theorem"
              >
                <span>One-Point Compactification Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-T">T</h2>

          <div class="alphabet-entry-list">
              <a
                id="tietze-extension-theorem"
                class="index-entry"
                href="#tietze-extension-theorem"
                data-index-entry
                data-search-term="tietze extension theorem"
              >
                <span>Tietze Extension Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
              <a
                id="tube-lemma"
                class="index-entry"
                href="#tube-lemma"
                data-index-entry
                data-search-term="tube lemma"
              >
                <span>Tube Lemma</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
              <a
                id="tychonoff-s-theorem"
                class="index-entry"
                href="#tychonoff-s-theorem"
                data-index-entry
                data-search-term="tychonoff's theorem"
              >
                <span>Tychonoff's Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-U">U</h2>

          <div class="alphabet-entry-list">
              <a
                id="urysohn-lemma"
                class="index-entry"
                href="#urysohn-lemma"
                data-index-entry
                data-search-term="urysohn lemma"
              >
                <span>Urysohn Lemma</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
              <a
                id="urysohn-metrization-theorem"
                class="index-entry"
                href="#urysohn-metrization-theorem"
                data-index-entry
                data-search-term="urysohn metrization theorem"
              >
                <span>Urysohn Metrization Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-W">W</h2>

          <div class="alphabet-entry-list">
              <a
                id="wallace-lemma"
                class="index-entry"
                href="#wallace-lemma"
                data-index-entry
                data-search-term="wallace lemma"
              >
                <span>Wallace Lemma</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#theorem-search");
  const entries = Array.from(
    document.querySelectorAll<HTMLElement>("[data-index-entry]"),
  );
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>("[data-alpha-group]"),
  );
  const resultCount =
    document.querySelector<HTMLOutputElement>("#theorem-result-count");

  const updateIndex = () => {
    const query = search?.value.trim().toLowerCase() ?? "";
    let visible = 0;

    entries.forEach((entry) => {
      const matches = (entry.dataset.searchTerm ?? "").includes(query);
      entry.hidden = !matches;

      if (matches) visible += 1;
    });

    groups.forEach((group) => {
      const hasVisibleEntries = Array.from(
        group.querySelectorAll<HTMLElement>("[data-index-entry]"),
      ).some((entry) => !entry.hidden);

      group.hidden = !hasVisibleEntries;
    });

    if (resultCount) {
      resultCount.textContent =
        query.length === 0
          ? `${visible} theorems`
          : `${visible} matching theorem${visible === 1 ? "" : "s"}`;
    }
  };

  search?.addEventListener("input", updateIndex);
</script>

<style>
  .index-tools {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 1.2rem;
    background: rgba(17, 11, 37, 0.55);
  }

  .search-control {
    display: grid;
    gap: 0.55rem;
  }

  .search-control span {
    color: var(--accent, #71e6ff);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .search-control input {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 0.8rem;
    padding: 0.85rem 1rem;
    color: inherit;
    background: rgba(5, 5, 18, 0.42);
    font: inherit;
  }

  .search-control input:focus {
    border-color: rgba(113, 230, 255, 0.48);
    outline: none;
  }

  .alphabet-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .alphabet-nav a {
    display: grid;
    place-items: center;
    min-width: 2.1rem;
    min-height: 2.1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.55rem;
    color: rgba(239, 234, 255, 0.76);
    text-decoration: none;
  }

  .alphabet-nav a:hover,
  .alphabet-nav a:focus-visible {
    border-color: rgba(113, 230, 255, 0.42);
    color: var(--accent, #71e6ff);
    outline: none;
  }

  #theorem-result-count {
    color: rgba(239, 234, 255, 0.62);
    font-size: 0.9rem;
  }

  .alphabet-index {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .alphabet-group {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 1rem;
  }

  .alphabet-group h2 {
    position: sticky;
    top: 1rem;
    align-self: start;
    margin: 0;
    color: var(--accent, #71e6ff);
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1;
  }

  .alphabet-entry-list {
    display: grid;
    gap: 0.55rem;
  }

  .index-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.8rem;
    padding: 0.85rem 1rem;
    color: inherit;
    background: rgba(255, 255, 255, 0.025);
    text-decoration: none;
  }

  .index-entry:hover,
  .index-entry:focus-visible {
    border-color: rgba(113, 230, 255, 0.32);
    background: rgba(113, 230, 255, 0.045);
    outline: none;
  }

  .index-arrow {
    color: var(--accent, #71e6ff);
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 600px) {
    .alphabet-group {
      grid-template-columns: 1fr;
    }

    .alphabet-group h2 {
      position: static;
    }
  }
</style>
