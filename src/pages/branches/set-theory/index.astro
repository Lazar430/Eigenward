---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SetTheorySidebar from "../../../components/SetTheorySidebar.astro";
import { withBase } from "@/utils/paths";
import katex from "katex";

const extensionality = katex.renderToString(
  String.raw`\forall A\,\forall B\,\Bigl[\forall x\,(x\in A\leftrightarrow x\in B)\Longrightarrow A=B\Bigr]`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const cantor = katex.renderToString(
  String.raw`|X|<|\mathcal P(X)|`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const branchHref = withBase("branches/set-theory/");

const lessons = [
  {
    number: "01",
    title: "Sets, Membership, and Paradoxes",
    href: withBase("branches/set-theory/"),
    text: "Naive set formation, Russell's paradox, extensionality, separation, and the need for axioms."
  },
  {
    number: "02",
    title: "The ZF Axioms",
    href: withBase("branches/set-theory/"),
    text: "Pairing, union, power set, infinity, replacement, foundation, separation, and the cumulative hierarchy."
  },
  {
    number: "03",
    title: "Relations and Functions",
    href: withBase("branches/set-theory/"),
    text: "Ordered pairs, products, equivalence relations, functions, images, inverses, and quotient constructions."
  },
  {
    number: "04",
    title: "Ordinals",
    href: withBase("branches/set-theory/"),
    text: "Transitive well-orders, successor and limit ordinals, ordinal arithmetic, and order types."
  },
  {
    number: "05",
    title: "Transfinite Induction and Recursion",
    href: withBase("branches/set-theory/"),
    text: "Proof and construction across arbitrary well-orders, including recursive definitions on ordinals."
  },
  {
    number: "06",
    title: "Cardinals",
    href: withBase("branches/set-theory/"),
    text: "Equinumerosity, cardinal comparison, infinite arithmetic, Cantor–Bernstein, and aleph numbers."
  },
  {
    number: "07",
    title: "The Axiom of Choice",
    href: withBase("branches/set-theory/"),
    text: "Choice functions, Zorn's lemma, well-ordering, maximal principles, and their mathematical consequences."
  },
  {
    number: "08",
    title: "Models and Independence",
    href: withBase("branches/set-theory/"),
    text: "Inner models, forcing as a later goal, relative consistency, and the independence of CH and choice principles."
  },
];

const problems = [
  {
    title: "Cantor's diagonal argument",
    text: "Prove that no function from a set onto its power set can be surjective."
  },
  {
    title: "Comparing infinite sets",
    text: "Construct explicit injections in both directions and use Cantor–Bernstein to establish equinumerosity."
  },
  {
    title: "A transfinite recursion",
    text: "Define an object along all ordinals below a fixed ordinal and verify uniqueness by transfinite induction."
  },
];

const theorems = [
  "Cantor's Theorem",
  "Cantor–Bernstein Theorem",
  "Hartogs' Theorem",
  "Well-Ordering Theorem",
  "Transfinite Recursion Theorem"
];

const definitions = [
  "Set",
  "Subset",
  "Relation",
  "Function",
  "Transitive set",
  "Ordinal",
  "Cardinal",
  "Model of set theory"
];
---

<BaseLayout
  title="Set Theory"
  description="A structured path through membership, axioms, relations, ordinals, cardinals, choice, transfinite methods, and the foundations of mathematics."
>
  <section class="hub-page">
    <SetTheorySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Branch prototype</span>

        <h1>Set Theory</h1>

        <p>
          This page will become the main entrance to the set theory section. It can eventually develop the passage from informal collections to axiomatic set theory, explain how mathematical objects are encoded as sets, and introduce infinity through ordinals, cardinals, and models.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a class="hub-overview-card" href={branchHref}>
          <span class="eyebrow">Core idea</span>

          <h2>Membership and hierarchy</h2>

          <p>
            Set theory studies objects through membership and builds increasingly complex mathematical universes from simple sets by precise formation principles.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Axiom of identity</span>

          <div class="hub-formula" set:html={extensionality} />

          <p>
            Extensionality says that a set is determined entirely by its members; there is no hidden structure beyond membership.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Hierarchy of infinity</span>

          <div class="hub-formula" set:html={cantor} />

          <p>
            Cantor's theorem guarantees that taking power sets always produces a strictly larger cardinality, so there is no largest infinity.
          </p>
        </a>
      </section>

      <section class="hub-section" id="lessons">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            A sequential path through the central concepts. These cards are
            highlights; later they can point to complete lesson pages.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section" id="problems">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            A small rotating shelf of problems. Later, this can be replaced by
            a full archive with difficulty, topic, and method tags.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a class="hub-problem-card" href={branchHref}>
                <span class="eyebrow">Problem</span>

                <h3>{problem.title}</h3>

                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a class="hub-index-card" id="theorems" href={branchHref}>
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a class="hub-index-card" id="definitions" href={branchHref}>
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
