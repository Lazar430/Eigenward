const letters = [...new Set(items.map((item) => item[0].toUpperCase()))];
---

<BaseLayout
  title="Set Theory Definitions"
  description="An alphabetical index of set theory definitions."
>
  <section class="hub-page">
    <SetTheorySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Set Theory · Definitions</span>

        <h1>Definitions</h1>

        <p>
          An alphabetical index of the principal objects, axioms, order-theoretic notions, ordinal and cardinal constructions, and model-theoretic vocabulary used throughout the set theory section.
        </p>
      </section>

      <section class="index-tools" aria-label="Definitions index controls">
        <label class="search-control">
          <span>Search definitions</span>
          <input
            id="definition-search"
            type="search"
            placeholder="Try “ordinal”, “cardinal”, “choice”…"
            autocomplete="off"
          />
        </label>

        <nav class="alphabet-nav" aria-label="Jump to letter">
          {
            letters.map((letter) => (
              <a href={`#definitions-${letter}`}>{letter}</a>
            ))
          }
        </nav>

        <output id="definition-result-count" aria-live="polite">
          {items.length} definitions
        </output>
      </section>

      <div class="alphabet-index" id="definition-index">
        <section class="alphabet-group" data-alpha-group>
