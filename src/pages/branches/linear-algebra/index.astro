---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LinearAlgebraSidebar from "../../../components/LinearAlgebraSidebar.astro";
import { withBase } from "@/utils/paths";
import katex from "katex";

const rankNullity = katex.renderToString(
  String.raw`\dim V = \operatorname{rank}(T) + \operatorname{nullity}(T)`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const eigenEquation = katex.renderToString(
  String.raw`T(v) = \lambda v`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const lessons = [
  {
    number: "01",
    title: "Vector Spaces",
    href: withBase("branches/linear-algebra/"),
    text: "The abstraction of addition, scalar multiplication, linear combinations, span, independence, basis, and dimension."
  },
  {
    number: "02",
    title: "Linear Maps",
    href: withBase("branches/linear-algebra/linear_maps/"),
    text: "Functions that preserve linear structure: kernels, images, rank, injectivity, surjectivity, and matrix representations."
  },
  {
    number: "03",
    title: "Systems of Linear Equations",
    href: withBase("branches/linear-algebra/"),
    text: "Solving linear systems through row reduction, rank, compatibility, and the geometry of solution spaces."
  },
  {
    number: "04",
    title: "Determinants",
    href: withBase("branches/linear-algebra/"),
    text: "Signed volume, orientation, invertibility, multilinearity, and the algebraic machinery behind change of variables."
  },
  {
    number: "05",
    title: "Eigenvalues and Eigenvectors",
    href: withBase("branches/linear-algebra/"),
    text: "Directions preserved by a transformation, characteristic polynomials, diagonalization, and spectral structure."
  },
  {
    number: "06",
    title: "Dual Spaces",
    href: withBase("branches/linear-algebra/"),
    text: "Linear functionals, dual bases, annihilators, transpose maps, and the geometry of measurement."
  },
  {
    number: "07",
    title: "Inner Product Spaces",
    href: withBase("branches/linear-algebra/"),
    text: "Orthogonality, projections, Gram matrices, least squares, adjoints, and geometric structure."
  },
  {
    number: "08",
    title: "Affine Spaces",
    href: withBase("branches/linear-algebra/"),
    text: "Points, vectors, affine combinations, affine maps, linear varieties, and the geometry behind coordinates."
  }
];

const problems = [
  {
    title: "Finding a basis from generators",
    text: "Given five vectors in R⁴, extract a basis for their span and compute the dimension."
  },
  {
    title: "Kernel and image of a parameter map",
    text: "Study how the rank and nullity of a linear map depend on a real parameter."
  },
  {
    title: "Projection onto a subspace",
    text: "Find the closest point to a vector inside a plane using orthogonality and Gram matrices."
  }
];

const theorems = [
  "Rank–Nullity Theorem",
  "Basis Extension Theorem",
  "Dimension Formula for Subspaces",
  "Spectral Theorem",
  "Cayley–Hamilton Theorem"
];

const definitions = [
  "Vector space",
  "Linear independence",
  "Basis",
  "Linear map",
  "Kernel",
  "Image",
  "Eigenvalue",
  "Dual space"
];

const sidebarItems = [
  "Lessons",
  "Problems",
  "Theorems",
  "Definitions"
];
---

<BaseLayout
  title="Linear Algebra"
  description="A structured path through vector spaces, linear maps, matrices, eigenvalues, dual spaces, affine spaces, and related problems."
>
  <section class="hub-page">
    <LinearAlgebraSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Branch prototype</span>

        <h1>Linear Algebra</h1>

        <p>
          This page will become the main entrance to the linear algebra section.
          Later, this opening area can contain a general overview of what linear
          algebra studies, why it is central, how it connects to geometry,
          computation, physics, algebra, and analysis, and how the reader should
          move through the lessons.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a
          class="hub-overview-card"
          href={withBase("branches/linear-algebra/")}
        >
          <span class="eyebrow">Core idea</span>

          <h2>Structure-preserving motion</h2>

          <p>
            Linear algebra studies spaces where addition and scaling make sense,
            and maps that preserve those operations.
          </p>
        </a>

        <a
          class="hub-overview-card formuhub-card"
          href={withBase("branches/linear-algebra/")}
        >
          <span class="eyebrow">Guiding theorem</span>

          <div class="hub-formula" set:html={rankNullity} />

          <p>
            The rank-nullity theorem is one of the first signs that linear maps
            have measurable internal structure.
          </p>
        </a>

        <a
          class="hub-overview-card formuhub-card"
          href={withBase("branches/linear-algebra/")}
        >
          <span class="eyebrow">Spectral viewpoint</span>

          <div class="hub-formula" set:html={eigenEquation} />

          <p>
            Eigenvectors expose directions in which a transformation acts as
            pure scaling.
          </p>
        </a>
      </section>

      <section class="hub-section">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            A sequential path through the central concepts. These cards are
            highlights; later they will point to full lesson pages.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            A small rotating shelf of problems. Later, this will be replaced by
            a full problem archive with difficulty, topic, and method tags.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a
                class="hub-problem-card"
                href={withBase("branches/linear-algebra/")}
              >
                <span class="eyebrow">Problem</span>

                <h3>{problem.title}</h3>

                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a
          class="hub-index-card"
          href={withBase("branches/linear-algebra/")}
        >
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a
          class="hub-index-card"
          href={withBase("branches/linear-algebra/")}
        >
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
