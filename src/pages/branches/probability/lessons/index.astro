---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ProbabilityTheorySidebar from "../../../../components/ProbabilityTheorySidebar.astro";
import { withBase } from "@/utils/paths";

const lessons = [
  {
    number: "01",
    title: "Probability Spaces and Events",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Sample spaces, sigma-algebras, probability measures, axioms of probability, complements, unions, continuity of probability, and modeling random experiments."
  },
  {
    number: "02",
    title: "Conditional Probability and Independence",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Conditional probability, product rules, independence of events, pairwise versus mutual independence, total probability, and Bayes' theorem."
  },
  {
    number: "03",
    title: "Discrete Random Variables",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Probability mass functions, cumulative distribution functions, expectation, variance, moments, transformations, and standard discrete distributions."
  },
  {
    number: "04",
    title: "Continuous Random Variables",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Distribution functions, densities, expectation by integration, transformations, quantiles, and the normal, exponential, gamma, and beta families."
  },
  {
    number: "05",
    title: "Joint Distributions",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Joint laws, marginals, conditional distributions, independence of random variables, covariance, correlation, and transformations of random vectors."
  },
  {
    number: "06",
    title: "Expectation as an Operator",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Linearity, indicators, tail-sum formulas, conditional expectation intuition, Jensen's inequality, and computing expectations without full distributions."
  },
  {
    number: "07",
    title: "Generating Functions and Transforms",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Probability generating functions, moment generating functions, characteristic functions, Laplace transforms, and their use in sums and limit theory."
  },
  {
    number: "08",
    title: "Sums of Independent Random Variables",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Convolution, binomial and Poisson sums, normal sums, compound distributions, random sums, and transform methods."
  },
  {
    number: "09",
    title: "Modes of Convergence",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Almost sure convergence, convergence in probability, convergence in distribution, convergence in mean, and relationships among these notions."
  },
  {
    number: "10",
    title: "Laws of Large Numbers",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Weak and strong laws, sample means, variance control, Borel–Cantelli ideas, and why averages stabilize."
  },
  {
    number: "11",
    title: "The Central Limit Theorem",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Standardization, characteristic-function intuition, Lindeberg-type ideas, normal approximation, Berry–Esseen estimates, and the universality of Gaussian fluctuations."
  },
  {
    number: "12",
    title: "Concentration and Tail Bounds",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Markov, Chebyshev, Chernoff and Hoeffding bounds, sub-Gaussian behavior, union bounds, and nonasymptotic control of random deviations."
  },
  {
    number: "13",
    title: "Conditional Expectation",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Conditional expectation as a random variable, sigma-algebra conditioning, tower property, conditional variance, and the projection viewpoint."
  },
  {
    number: "14",
    title: "Martingales",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Filtrations, martingales, submartingales, stopping times, optional stopping, martingale convergence, and fair-game structure."
  },
  {
    number: "15",
    title: "Markov Chains",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Transition matrices, communicating classes, recurrence, transience, stationary distributions, detailed balance, hitting times, and long-run behavior."
  },
  {
    number: "16",
    title: "Poisson Processes",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Counting processes, exponential waiting times, independent increments, thinning, superposition, conditional arrival times, and memorylessness."
  },
  {
    number: "17",
    title: "Continuous-Time Markov Chains",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Jump rates, generators, holding times, Kolmogorov equations, birth-death processes, and stationary behavior in continuous time."
  },
  {
    number: "18",
    title: "Brownian Motion",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Gaussian increments, continuity, scaling, hitting times, reflection principles, quadratic variation, and Brownian motion as the central continuous stochastic process."
  },
  {
    number: "19",
    title: "Statistical Inference from a Probability Viewpoint",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Likelihood, estimators, bias and consistency, sufficiency, confidence procedures, hypothesis testing, and the probabilistic structure behind statistical methods."
  },
  {
    number: "20",
    title: "Stochastic Processes and Modern Probability: A First View",
    href: withBase("branches/probability-theory/lessons/"),
    text: "Random processes indexed by time or space, ergodic ideas, branching processes, random walks, Gaussian processes, and paths toward stochastic analysis."
  }
];
---

<BaseLayout
  title="Probability Theory Lessons"
  description="A structured path through probability spaces, random variables, expectation, conditional probability, limit theorems, concentration, martingales, Markov chains, and stochastic processes."
>
  <section class="hub-page">
    <ProbabilityTheorySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Probability Theory · Lessons</span>

        <h1>Lessons</h1>

        <p>
          A sequential route through the subject. The organization moves from foundational language and elementary methods toward increasingly structural and advanced viewpoints, while keeping each lesson broad enough to function as a coherent chapter rather than a single theorem.
        </p>
      </section>

      <section class="hub-section lesson-index-section">
        <div class="section-header">
          <h2>Full lesson path</h2>

          <p>
            Each card represents a substantial conceptual unit rather than one
            isolated result. Later lessons freely reuse the language, examples,
            and proof methods established earlier in the sequence.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>

                <span class="lesson-arrow" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .lesson-index-section {
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .lesson-card {
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
  }

  .lesson-arrow {
    color: var(--accent, #71e6ff);
    font-size: 1.15rem;
    transition: transform 180ms ease;
  }

  .lesson-card:hover .lesson-arrow,
  .lesson-card:focus-visible .lesson-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .lesson-card {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .lesson-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lesson-arrow {
      transition: none;
    }
  }
</style>
