---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProbabilityTheorySidebar from "../../../components/ProbabilityTheorySidebar.astro";
import { withBase } from "@/utils/paths";
import katex from "katex";

const formulaOne = katex.renderToString(
  String.raw`\mathbb P(A\mid B)=\frac{\mathbb P(A\cap B)}{\mathbb P(B)}`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const formulaTwo = katex.renderToString(
  String.raw`\frac{X_1+\cdots+X_n-n\mu}{\sigma\sqrt n}\xrightarrow{d}N(0,1)`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const branchHref = withBase("branches/probability-theory/");
const lessonsHref = withBase("branches/probability-theory/lessons/");
const theoremsHref = withBase("branches/probability-theory/theorems/");
const definitionsHref = withBase("branches/probability-theory/definitions/");

const lessons = [
  {
    number: "01",
    title: "Probability Spaces and Events",
    href: lessonsHref,
    text: "Sample spaces, sigma-algebras, probability measures, axioms of probability, complements, unions, continuity of probability, and modeling random experiments."
  },
  {
    number: "02",
    title: "Conditional Probability and Independence",
    href: lessonsHref,
    text: "Conditional probability, product rules, independence of events, pairwise versus mutual independence, total probability, and Bayes' theorem."
  },
  {
    number: "03",
    title: "Discrete Random Variables",
    href: lessonsHref,
    text: "Probability mass functions, cumulative distribution functions, expectation, variance, moments, transformations, and standard discrete distributions."
  },
  {
    number: "04",
    title: "Continuous Random Variables",
    href: lessonsHref,
    text: "Distribution functions, densities, expectation by integration, transformations, quantiles, and the normal, exponential, gamma, and beta families."
  },
  {
    number: "05",
    title: "Joint Distributions",
    href: lessonsHref,
    text: "Joint laws, marginals, conditional distributions, independence of random variables, covariance, correlation, and transformations of random vectors."
  },
  {
    number: "06",
    title: "Expectation as an Operator",
    href: lessonsHref,
    text: "Linearity, indicators, tail-sum formulas, conditional expectation intuition, Jensen's inequality, and computing expectations without full distributions."
  },
  {
    number: "07",
    title: "Generating Functions and Transforms",
    href: lessonsHref,
    text: "Probability generating functions, moment generating functions, characteristic functions, Laplace transforms, and their use in sums and limit theory."
  },
  {
    number: "08",
    title: "Sums of Independent Random Variables",
    href: lessonsHref,
    text: "Convolution, binomial and Poisson sums, normal sums, compound distributions, random sums, and transform methods."
  }
];

const problems = [
  {
    title: "A coupon collector with state",
    text: "Model the number of distinct coupons collected as a Markov chain and derive an expectation from the waiting-time decomposition."
  },
  {
    title: "When does conditioning create dependence?",
    text: "Start with independent events, condition on a third event, and determine exactly why the conditional law may destroy independence."
  },
  {
    title: "A concentration estimate without the exact law",
    text: "Bound a rare deviation using only expectation or variance, then compare Markov, Chebyshev, and exponential tail bounds."
  }
];

const theorems = [
  "Bayes' Theorem",
  "Weak Law of Large Numbers",
  "Strong Law of Large Numbers",
  "Central Limit Theorem",
  "Borel–Cantelli Lemma",
  "Optional Stopping Theorem"
];

const definitions = [
  "Probability space",
  "Random variable",
  "Conditional probability",
  "Expectation",
  "Variance",
  "Markov chain",
  "Martingale",
  "Stochastic process"
];
---

<BaseLayout
  title="Probability Theory"
  description="A structured path through probability spaces, random variables, expectation, conditional probability, limit theorems, concentration, martingales, Markov chains, and stochastic processes."
>
  <section class="hub-page">
    <ProbabilityTheorySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Branch prototype</span>

        <h1>Probability Theory</h1>

        <p>
          This page is the main entrance to the probability section. Probability turns uncertainty into mathematical structure: events become measurable sets, random quantities become functions, and repeated randomness gives rise to robust laws, limit theorems, and stochastic processes.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a class="hub-overview-card" href={branchHref}>
          <span class="eyebrow">Core idea</span>

          <h2>Mathematics of uncertainty</h2>

          <p>
            Probability studies how uncertainty behaves under combination, conditioning, repetition, and limiting processes. Its central objects are distributions rather than individual outcomes.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Conditioning</span>

          <div class="hub-formula" set:html={formulaOne} />

          <p>
            Conditional probability updates the probabilistic model once information is known, and it is the basis of Bayes' theorem, dependence, and much of stochastic reasoning.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Universal limiting behavior</span>

          <div class="hub-formula" set:html={formulaTwo} />

          <p>
            The central limit theorem explains why normalized sums of many independent contributions often approach a Gaussian law even when the individual variables are not Gaussian.
          </p>
        </a>
      </section>

      <section class="hub-section" id="lessons">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            A sequential path through the branch's central concepts. These are
            the opening stages of the complete lesson sequence.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section" id="problems">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            A small rotating shelf of representative problems, with the complete
            archive living in the shared Problems section.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a class="hub-problem-card" href={withBase("problems/probability-theory/")}>
                <span class="eyebrow">Problem</span>

                <h3>{problem.title}</h3>

                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a class="hub-index-card" id="theorems" href={theoremsHref}>
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a class="hub-index-card" id="definitions" href={definitionsHref}>
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
