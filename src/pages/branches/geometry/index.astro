---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GeometrySidebar from "../../../components/GeometrySidebar.astro";
import { withBase } from "@/utils/paths";
import katex from "katex";

const innerProduct = katex.renderToString(
  String.raw`\langle x,y\rangle=\sum_{k=1}^{n}x_k y_k,\qquad \|x\|=\sqrt{\langle x,x\rangle}`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const curvature = katex.renderToString(
  String.raw`K=\kappa_1\kappa_2`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const branchHref = withBase("branches/geometry/");
const lessonsHref = withBase("branches/geometry/lessons/");
const theoremsHref = withBase("branches/geometry/theorems/");
const definitionsHref = withBase("branches/geometry/definitions/");

const lessons = [
  {
    number: "01",
    title: "Geometric Language and Axioms",
    href: lessonsHref,
    text: "Points, lines, planes, incidence, betweenness, congruence, distance, angle, and the role of axioms in determining a geometry."
  },
  {
    number: "02",
    title: "Euclidean Geometry",
    href: lessonsHref,
    text: "Triangles, circles, polygons, parallelism, similarity, area, classical constructions, and the central theorems of plane Euclidean geometry."
  },
  {
    number: "03",
    title: "Isometries and Symmetry",
    href: lessonsHref,
    text: "Translations, rotations, reflections, glide reflections, rigid motions, fixed points, composition, and symmetry groups of figures."
  },
  {
    number: "04",
    title: "Vectors, Inner Products, and Euclidean Space",
    href: lessonsHref,
    text: "Vectors, dot products, norms, orthogonality, projections, distances, angles, affine subspaces, and Euclidean geometry in higher dimensions."
  },
  {
    number: "05",
    title: "Analytic Geometry",
    href: lessonsHref,
    text: "Coordinates, equations of lines and planes, distance formulas, intersections, loci, transformations of coordinates, and algebraic descriptions of geometric objects."
  },
  {
    number: "06",
    title: "Conics and Quadrics",
    href: lessonsHref,
    text: "Ellipses, parabolas, hyperbolas, quadratic forms, canonical equations, affine classification, focal properties, and higher-dimensional quadrics."
  },
  {
    number: "07",
    title: "Affine Geometry",
    href: lessonsHref,
    text: "Affine spaces, affine combinations, parallelism, barycentric coordinates, affine transformations, convex combinations, and invariants beyond metric geometry."
  },
  {
    number: "08",
    title: "Projective Geometry",
    href: lessonsHref,
    text: "Projective space, homogeneous coordinates, points at infinity, projective transformations, duality, cross-ratios, conics, and incidence theorems."
  },
  {
    number: "09",
    title: "Convex Geometry",
    href: lessonsHref,
    text: "Convex sets, convex hulls, supporting hyperplanes, separation, extreme points, polytopes, Helly-type phenomena, and geometric optimization."
  },
  {
    number: "10",
    title: "Discrete and Combinatorial Geometry",
    href: lessonsHref,
    text: "Configurations, tilings, packings, coverings, incidence problems, finite point sets, polyhedra, and combinatorial restrictions on geometric structure."
  },
  {
    number: "11",
    title: "Computational Geometry",
    href: lessonsHref,
    text: "Convex hull algorithms, Voronoi diagrams, Delaunay triangulations, arrangements, visibility, intersection problems, and algorithmic representations of shape."
  },
  {
    number: "12",
    title: "Spherical Geometry",
    href: lessonsHref,
    text: "Great circles, spherical distance, spherical triangles, angle excess, spherical trigonometry, rotations of the sphere, and geometry of positive curvature."
  },
  {
    number: "13",
    title: "Hyperbolic Geometry",
    href: lessonsHref,
    text: "The parallel postulate, hyperbolic distance, geodesics, the disk and half-plane models, hyperbolic triangles, isometries, and negative curvature."
  },
  {
    number: "14",
    title: "Metric Geometry",
    href: lessonsHref,
    text: "Metric spaces from a geometric viewpoint, length spaces, geodesics, intrinsic metrics, comparison ideas, and geometry defined by distance rather than coordinates."
  },
  {
    number: "15",
    title: "Manifolds and Tangent Spaces",
    href: lessonsHref,
    text: "Local Euclidean structure, charts, coordinate changes, tangent vectors, tangent spaces, smooth maps, immersions, embeddings, and geometric objects without global coordinates."
  },
  {
    number: "16",
    title: "Differential Geometry of Curves",
    href: lessonsHref,
    text: "Regular curves, arc length, curvature, torsion, Frenet frames, evolutes, geodesic curvature, and the local geometry of parametrized curves."
  },
  {
    number: "17",
    title: "Differential Geometry of Surfaces",
    href: lessonsHref,
    text: "Regular surfaces, tangent planes, first and second fundamental forms, normal curvature, principal curvatures, Gaussian curvature, and the Gauss map."
  },
  {
    number: "18",
    title: "Riemannian Geometry",
    href: lessonsHref,
    text: "Riemannian metrics, lengths and energies, geodesics, Levi-Civita connection, curvature tensors, completeness, and geometry on smooth manifolds."
  },
  {
    number: "19",
    title: "Symplectic and Contact Geometry",
    href: lessonsHref,
    text: "Symplectic forms, Hamiltonian vector fields, canonical transformations, contact structures, and the geometric language underlying classical mechanics."
  },
  {
    number: "20",
    title: "Complex and Algebraic Geometry: A First View",
    href: lessonsHref,
    text: "Complex manifolds, algebraic varieties, projective varieties, singularities, divisors, and how geometric questions change when polynomial or complex structure is imposed."
  }
];

const problems = [
  {
    title: "Classify a Euclidean motion",
    text: "Given a composition of reflections and rotations, determine the resulting isometry and identify the geometric data that completely specifies it."
  },
  {
    title: "Recover a conic from its quadratic equation",
    text: "Use translation, rotation, and a quadratic-form viewpoint to reduce a general second-degree equation to canonical geometric form."
  },
  {
    title: "Compare spherical and Euclidean triangles",
    text: "Derive a relation between angle sum and area on the sphere and explain precisely which Euclidean identities survive or fail."
  }
];

const theorems = [
  "Pythagorean Theorem",
  "Law of Cosines",
  "Ceva's Theorem",
  "Menelaus' Theorem",
  "Desargues' Theorem",
  "Pappus' Theorem",
  "Pascal's Theorem",
  "Euler's Polyhedron Formula",
  "Gauss's Theorema Egregium",
  "Gauss–Bonnet Theorem"
];

const definitions = [
  "Isometry",
  "Affine space",
  "Projective space",
  "Conic",
  "Convex set",
  "Geodesic",
  "Manifold",
  "Tangent space",
  "Gaussian curvature",
  "Riemannian metric"
];
---

<BaseLayout
  title="Geometry"
  description="A structured path through Euclidean, analytic, affine, projective, convex, spherical, hyperbolic, metric, and differential geometry."
>
  <section class="hub-page">
    <GeometrySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Branch prototype</span>

        <h1>Geometry</h1>

        <p>
          This page is the main entrance to the geometry section. The subject
          begins with shape, distance, angle, incidence, and symmetry, then
          progressively loosens or enriches those structures: affine geometry
          forgets distance, projective geometry adjoins points at infinity,
          non-Euclidean geometry changes the ambient metric, and differential
          geometry studies curvature on smooth spaces.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a class="hub-overview-card" href={branchHref}>
          <span class="eyebrow">Core idea</span>

          <h2>Structure of space</h2>

          <p>
            Geometry studies which properties of figures and spaces survive the
            transformations allowed by a chosen geometric structure: rigid,
            affine, projective, metric, smooth, or otherwise.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Euclidean language</span>

          <div class="hub-formula" set:html={innerProduct} />

          <p>
            An inner product produces lengths, angles, orthogonality, and
            distance. Much of Euclidean geometry can be understood as the study
            of structures and transformations preserving this data.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Curved geometry</span>

          <div class="hub-formula" set:html={curvature} />

          <p>
            On a surface, Gaussian curvature is the product of the principal
            curvatures. It records intrinsic bending and opens the route from
            classical surfaces to differential and Riemannian geometry.
          </p>
        </a>
      </section>

      <section class="hub-section" id="lessons">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            A sequential route from classical Euclidean geometry through
            coordinate, affine, projective, non-Euclidean, metric, and smooth
            geometry.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.slice(0, 8).map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section" id="problems">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            A small shelf of problems emphasizing transformation, classification,
            and the comparison of different geometries.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a class="hub-problem-card" href={withBase("problems/geometry/")}>
                <span class="eyebrow">Problem</span>

                <h3>{problem.title}</h3>

                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a class="hub-index-card" id="theorems" href={theoremsHref}>
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a class="hub-index-card" id="definitions" href={definitionsHref}>
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
