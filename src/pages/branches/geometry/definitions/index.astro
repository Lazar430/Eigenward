---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import GeometrySidebar from "../../../../components/GeometrySidebar.astro";

const items = [
  "Affine combination",
  "Affine dependence",
  "Affine map",
  "Affine space",
  "Affine subspace",
  "Angle",
  "Arc length",
  "Barycentric coordinates",
  "Bilinear form",
  "Chart",
  "Circle",
  "Circumcenter",
  "Conic",
  "Contact structure",
  "Convex combination",
  "Convex hull",
  "Convex polytope",
  "Convex set",
  "Coordinate chart",
  "Cross-ratio",
  "Curvature",
  "Delaunay triangulation",
  "Differential",
  "Differential form",
  "Ellipse",
  "Embedding",
  "Euclidean isometry",
  "Euclidean space",
  "Extreme point",
  "First fundamental form",
  "Focal point",
  "Geodesic",
  "Geodesic curvature",
  "Great circle",
  "Gaussian curvature",
  "Gauss map",
  "Half-space",
  "Homogeneous coordinates",
  "Hyperbola",
  "Hyperbolic plane",
  "Hyperplane",
  "Immersion",
  "Incidence",
  "Inner product",
  "Intrinsic metric",
  "Isometry",
  "Kähler metric",
  "Length space",
  "Levi-Civita connection",
  "Line",
  "Linear isometry",
  "Manifold",
  "Mean curvature",
  "Metric",
  "Metric geometry",
  "Normal curvature",
  "Normal vector",
  "Orthogonal projection",
  "Parabola",
  "Parallel transport",
  "Plane",
  "Point at infinity",
  "Polyhedron",
  "Principal curvature",
  "Projective duality",
  "Projective line",
  "Projective map",
  "Projective space",
  "Quadratic form",
  "Quadric",
  "Reflection",
  "Regular curve",
  "Regular surface",
  "Riemannian manifold",
  "Riemannian metric",
  "Rigid motion",
  "Rotation",
  "Second fundamental form",
  "Sectional curvature",
  "Shape operator",
  "Simplex",
  "Similarity",
  "Sphere",
  "Spherical triangle",
  "Submanifold",
  "Supporting hyperplane",
  "Symplectic form",
  "Tangent bundle",
  "Tangent plane",
  "Tangent space",
  "Tangent vector",
  "Torsion of a curve",
  "Translation",
  "Triangulation",
  "Vector field",
  "Voronoi diagram"
];

const letters = [...new Set(items.map((item) => item[0].toUpperCase()))];

const groups = letters.map((letter) => ({
  letter,
  items: items.filter((item) => item[0].toUpperCase() === letter)
}));

function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}
---

<BaseLayout
  title="Geometry Definitions"
  description="An alphabetical index of geometry definitions."
>
  <section class="hub-page">
    <GeometrySidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Geometry · Definitions</span>

        <h1>Definitions</h1>

        <p>
          An alphabetical index of the principal objects, transformations, coordinate notions, metric structures, curvature concepts, and vocabulary used throughout the geometry section.
        </p>
      </section>

      <section class="index-tools" aria-label="Definitions index controls">
        <label class="search-control">
          <span>Search definitions</span>

          <input
            id="definition-search"
            type="search"
            placeholder="Try “geodesic”, “affine”, “curvature”…"
            autocomplete="off"
          />
        </label>

        <nav class="alphabet-nav" aria-label="Jump to letter">
          {
            letters.map((letter) => (
              <a href={`#definitions-${letter}`}>{letter}</a>
            ))
          }
        </nav>

        <output id="definition-result-count" aria-live="polite">
          {items.length} definitions
        </output>
      </section>

      <div class="alphabet-index" id="definition-index">
        {
          groups.map((group) => (
            <section class="alphabet-group" data-alpha-group>
              <h2 id={`$definitions-${group.letter}`}>{group.letter}</h2>

              <div class="alphabet-entry-list">
                {
                  group.items.map((item) => {
                    const slug = slugify(item);

                    return (
                      <a
                        id={slug}
                        class="index-entry"
                        href={`#${slug}`}
                        data-index-entry
                        data-search-term={item.toLowerCase()}
                      >
                        <span>{item}</span>
                        <span class="index-arrow" aria-hidden="true">→</span>
                      </a>
                    );
                  })
                }
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#definition-search");
  const entries = Array.from(
    document.querySelectorAll<HTMLElement>("[data-index-entry]"),
  );
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>("[data-alpha-group]"),
  );
  const resultCount =
    document.querySelector<HTMLOutputElement>("#definition-result-count");

  const updateIndex = () => {
    const query = search?.value.trim().toLowerCase() ?? "";
    let visible = 0;

    entries.forEach((entry) => {
      const matches = (entry.dataset.searchTerm ?? "").includes(query);
      entry.hidden = !matches;

      if (matches) visible += 1;
    });

    groups.forEach((group) => {
      const hasVisibleEntries = Array.from(
        group.querySelectorAll<HTMLElement>("[data-index-entry]"),
      ).some((entry) => !entry.hidden);

      group.hidden = !hasVisibleEntries;
    });

    if (resultCount) {
      resultCount.textContent =
        query.length === 0
          ? `${visible} definitions`
          : `${visible} matching definition${visible === 1 ? "" : "s"}`;
    }
  };

  search?.addEventListener("input", updateIndex);
</script>

<style>
  .index-tools {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 1.2rem;
    background: rgba(17, 11, 37, 0.55);
  }

  .search-control {
    display: grid;
    gap: 0.55rem;
  }

  .search-control span {
    color: var(--accent, #71e6ff);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .search-control input {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 0.8rem;
    padding: 0.85rem 1rem;
    color: inherit;
    background: rgba(5, 5, 18, 0.42);
    font: inherit;
  }

  .search-control input:focus {
    border-color: rgba(113, 230, 255, 0.48);
    outline: none;
  }

  .alphabet-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .alphabet-nav a {
    display: grid;
    place-items: center;
    min-width: 2.1rem;
    min-height: 2.1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.55rem;
    color: rgba(239, 234, 255, 0.76);
    text-decoration: none;
  }

  .alphabet-nav a:hover,
  .alphabet-nav a:focus-visible {
    border-color: rgba(113, 230, 255, 0.42);
    color: var(--accent, #71e6ff);
    outline: none;
  }

  #definition-result-count {
    color: rgba(239, 234, 255, 0.62);
    font-size: 0.9rem;
  }

  .alphabet-index {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .alphabet-group {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 1rem;
  }

  .alphabet-group h2 {
    position: sticky;
    top: 1rem;
    align-self: start;
    margin: 0;
    color: var(--accent, #71e6ff);
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1;
  }

  .alphabet-entry-list {
    display: grid;
    gap: 0.55rem;
  }

  .index-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.8rem;
    padding: 0.85rem 1rem;
    color: inherit;
    background: rgba(255, 255, 255, 0.025);
    text-decoration: none;
  }

  .index-entry:hover,
  .index-entry:focus-visible {
    border-color: rgba(113, 230, 255, 0.32);
    background: rgba(113, 230, 255, 0.045);
    outline: none;
  }

  .index-arrow {
    color: var(--accent, #71e6ff);
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 600px) {
    .alphabet-group {
      grid-template-columns: 1fr;
    }

    .alphabet-group h2 {
      position: static;
    }
  }
</style>
