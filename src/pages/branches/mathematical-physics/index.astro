---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MathematicalPhysicsSidebar from "../../../components/MathematicalPhysicsSidebar.astro";
import { withBase } from "@/utils/paths";
import katex from "katex";

const formulaOne = katex.renderToString(
  String.raw`\delta S=0,\qquad S[q]=\int L(q,\dot q,t)\,dt`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const formulaTwo = katex.renderToString(
  String.raw`\frac{d}{dt}Q=0\qquad\Longleftrightarrow\qquad\text{continuous symmetry}`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const branchHref = withBase("branches/mathematical-physics/");
const lessonsHref = withBase("branches/mathematical-physics/lessons/");
const theoremsHref = withBase("branches/mathematical-physics/theorems/");
const definitionsHref = withBase("branches/mathematical-physics/definitions/");

const lessons = [
  {
    number: "01",
    title: "Mathematical Structures in Physics",
    href: lessonsHref,
    text: "Configuration spaces, state spaces, symmetries, observables, dimensional analysis, scaling, variational principles, and the role of mathematical models in physical theory."
  },
  {
    number: "02",
    title: "Classical Mechanics: Lagrangian Formulation",
    href: lessonsHref,
    text: "Generalized coordinates, constraints, action, Euler–Lagrange equations, symmetries, conserved quantities, and coordinate-free viewpoints on mechanics."
  },
  {
    number: "03",
    title: "Hamiltonian Mechanics",
    href: lessonsHref,
    text: "Phase space, symplectic structure, Hamilton's equations, canonical transformations, Poisson brackets, integrability, and Hamilton–Jacobi theory."
  },
  {
    number: "04",
    title: "Continuum Mechanics",
    href: lessonsHref,
    text: "Stress and strain, conservation laws, constitutive relations, elasticity, fluid mechanics, material derivatives, and tensor descriptions of continua."
  },
  {
    number: "05",
    title: "Classical Field Theory",
    href: lessonsHref,
    text: "Fields as dynamical variables, Lagrangian densities, Euler–Lagrange field equations, Noether currents, scalar fields, and gauge-type structure."
  },
  {
    number: "06",
    title: "Electromagnetism",
    href: lessonsHref,
    text: "Maxwell's equations, differential forms, potentials, gauge freedom, wave equations, energy-momentum, and geometric formulations of electromagnetic fields."
  },
  {
    number: "07",
    title: "Special Relativity",
    href: lessonsHref,
    text: "Minkowski space, Lorentz transformations, four-vectors, relativistic dynamics, causal structure, tensors, and covariant field equations."
  },
  {
    number: "08",
    title: "General Relativity",
    href: lessonsHref,
    text: "Lorentzian manifolds, connections, curvature, geodesics, Einstein's field equations, exact solutions, causal structure, and gravitational dynamics."
  }
];

const problems = [
  {
    title: "Derive a conservation law from symmetry",
    text: "Start from an invariant action and use the variational principle to derive the associated Noether current."
  },
  {
    title: "Diagonalize a physical operator",
    text: "Use spectral structure to interpret eigenvalues and eigenspaces of an observable or evolution generator."
  },
  {
    title: "Compare two formulations of a field equation",
    text: "Rewrite a familiar physical law in vector-calculus and differential-form language and identify the geometric content preserved by both."
  }
];

const theorems = [
  "Noether's Theorem",
  "Spectral Theorem",
  "Liouville's Theorem in Hamiltonian Mechanics",
  "Bell's Theorem",
  "Stone's Theorem on One-Parameter Unitary Groups",
  "KAM Theorem"
];

const definitions = [
  "Action",
  "Hamiltonian",
  "Hilbert space",
  "Gauge field",
  "Lorentzian manifold",
  "Poisson bracket",
  "Propagator",
  "Symmetry"
];
---

<BaseLayout
  title="Mathematical Physics"
  description="A structured path through the mathematical language of mechanics, fields, relativity, quantum theory, PDEs, geometry, operator theory, and modern mathematical physics."
>
  <section class="hub-page">
    <MathematicalPhysicsSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Branch prototype</span>

        <h1>Mathematical Physics</h1>

        <p>
          This page is the main entrance to the mathematical physics section. The emphasis is not merely on applying formulas to physical systems, but on understanding the mathematical structures underlying physical theories: variational principles, symmetries, differential equations, geometry, operators, probability, and representation theory.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a class="hub-overview-card" href={branchHref}>
          <span class="eyebrow">Core idea</span>

          <h2>Physical laws as mathematical structure</h2>

          <p>
            Mathematical physics studies how physical theories are encoded by geometry, analysis, algebra, probability, and variational principles, and how those structures constrain what physical behavior is possible.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Variational language</span>

          <div class="hub-formula" set:html={formulaOne} />

          <p>
            Stationary-action principles unify classical mechanics, field theory, relativity, and many quantum formulations by turning dynamics into a variational problem.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Symmetry and conservation</span>

          <div class="hub-formula" set:html={formulaTwo} />

          <p>
            Noether's theorem makes symmetry a structural source of conserved quantities, linking transformations of a theory to invariants of its dynamics.
          </p>
        </a>
      </section>

      <section class="hub-section" id="lessons">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            A sequential route through the central ideas. These cards show the
            opening portion of the complete lesson path.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section" id="problems">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            A small rotating shelf of representative problems, with the complete
            archive living in the shared Problems section.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a class="hub-problem-card" href={withBase("problems/mathematical-physics/")}>
                <span class="eyebrow">Problem</span>

                <h3>{problem.title}</h3>

                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a class="hub-index-card" id="theorems" href={theoremsHref}>
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a class="hub-index-card" id="definitions" href={definitionsHref}>
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
