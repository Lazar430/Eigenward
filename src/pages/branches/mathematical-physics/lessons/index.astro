---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import MathematicalPhysicsSidebar from "../../../../components/MathematicalPhysicsSidebar.astro";
import { withBase } from "@/utils/paths";

const lessons = [
  {
    number: "01",
    title: "Mathematical Structures in Physics",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Configuration spaces, state spaces, symmetries, observables, dimensional analysis, scaling, variational principles, and the role of mathematical models in physical theory."
  },
  {
    number: "02",
    title: "Classical Mechanics: Lagrangian Formulation",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Generalized coordinates, constraints, action, Euler–Lagrange equations, symmetries, conserved quantities, and coordinate-free viewpoints on mechanics."
  },
  {
    number: "03",
    title: "Hamiltonian Mechanics",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Phase space, symplectic structure, Hamilton's equations, canonical transformations, Poisson brackets, integrability, and Hamilton–Jacobi theory."
  },
  {
    number: "04",
    title: "Continuum Mechanics",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Stress and strain, conservation laws, constitutive relations, elasticity, fluid mechanics, material derivatives, and tensor descriptions of continua."
  },
  {
    number: "05",
    title: "Classical Field Theory",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Fields as dynamical variables, Lagrangian densities, Euler–Lagrange field equations, Noether currents, scalar fields, and gauge-type structure."
  },
  {
    number: "06",
    title: "Electromagnetism",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Maxwell's equations, differential forms, potentials, gauge freedom, wave equations, energy-momentum, and geometric formulations of electromagnetic fields."
  },
  {
    number: "07",
    title: "Special Relativity",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Minkowski space, Lorentz transformations, four-vectors, relativistic dynamics, causal structure, tensors, and covariant field equations."
  },
  {
    number: "08",
    title: "General Relativity",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Lorentzian manifolds, connections, curvature, geodesics, Einstein's field equations, exact solutions, causal structure, and gravitational dynamics."
  },
  {
    number: "09",
    title: "Thermodynamics and Statistical Mechanics",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "State variables, entropy, ensembles, partition functions, fluctuations, thermodynamic limits, phase transitions, and probabilistic descriptions of macroscopic systems."
  },
  {
    number: "10",
    title: "Quantum Mechanics: Hilbert-Space Formulation",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Hilbert spaces, observables as operators, states, spectral theory, unitary time evolution, measurement, uncertainty, and symmetry."
  },
  {
    number: "11",
    title: "Quantum Angular Momentum and Symmetry",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Lie groups and Lie algebras, rotations, commutators, angular momentum, spin, representation theory, and addition of angular momenta."
  },
  {
    number: "12",
    title: "Quantum Field Theory: Mathematical Foundations",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Classical fields to quantized fields, Fock spaces, canonical quantization, propagators, path integrals, symmetries, and the mathematical difficulties of interacting theories."
  },
  {
    number: "13",
    title: "Partial Differential Equations in Physics",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Wave, heat, Laplace, Poisson, Schrödinger, Klein–Gordon, and Maxwell equations; characteristics, boundary-value problems, Green functions, and spectral methods."
  },
  {
    number: "14",
    title: "Functional Analysis and Operator Theory",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Banach and Hilbert spaces, bounded and unbounded operators, self-adjointness, spectral theory, semigroups, distributions, and operator methods in physics."
  },
  {
    number: "15",
    title: "Geometry and Topology in Physics",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Bundles, connections, curvature, characteristic classes, gauge fields, defects, topological phases, and global structures invisible to local coordinates."
  },
  {
    number: "16",
    title: "Dynamical Systems and Chaos",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Flows, fixed points, stability, bifurcations, Hamiltonian chaos, invariant manifolds, ergodicity, and geometric approaches to nonlinear dynamics."
  },
  {
    number: "17",
    title: "Representation Theory in Physics",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Continuous symmetries, Lie groups, irreducible representations, Wigner's viewpoint, particle classifications, selection rules, and harmonic analysis."
  },
  {
    number: "18",
    title: "Gauge Theory",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Principal bundles, connections, curvature forms, Yang–Mills fields, gauge transformations, instantons, monopoles, and geometric formulations of interactions."
  },
  {
    number: "19",
    title: "Condensed Matter and Many-Body Mathematics",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Lattices, second quantization, quasiparticles, correlation functions, symmetry breaking, topological phases, and effective theories of collective behavior."
  },
  {
    number: "20",
    title: "Modern Mathematical Physics: A Survey",
    href: withBase("branches/mathematical-physics/lessons/"),
    text: "Integrable systems, conformal field theory, string-inspired geometry, quantum information, spectral geometry, and interactions among geometry, algebra, analysis, and physics."
  }
];
---

<BaseLayout
  title="Mathematical Physics Lessons"
  description="A structured path through the mathematical language of mechanics, fields, relativity, quantum theory, PDEs, geometry, operator theory, and modern mathematical physics."
>
  <section class="hub-page">
    <MathematicalPhysicsSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Mathematical Physics · Lessons</span>

        <h1>Lessons</h1>

        <p>
          A sequential route through the subject, beginning with its core mathematical framework and moving toward more structural, geometric, and advanced formulations.
        </p>
      </section>

      <section class="hub-section lesson-index-section">
        <div class="section-header">
          <h2>Full lesson path</h2>

          <p>
            Each card represents a substantial conceptual unit rather than a
            single formula or isolated theorem, so later material can build on
            a coherent physical and mathematical vocabulary.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>

                <span class="lesson-arrow" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .lesson-index-section {
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .lesson-card {
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
  }

  .lesson-arrow {
    color: var(--accent, #71e6ff);
    font-size: 1.15rem;
    transition: transform 180ms ease;
  }

  .lesson-card:hover .lesson-arrow,
  .lesson-card:focus-visible .lesson-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .lesson-card {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .lesson-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lesson-arrow {
      transition: none;
    }
  }
</style>
