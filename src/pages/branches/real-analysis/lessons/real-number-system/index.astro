---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import RealAnalysisSidebar from "../../../../../components/RealAnalysisSidebar.astro";
import katex from "katex";

const displayMath = (tex: string) =>
  katex.renderToString(tex, {
    displayMode: true,
    throwOnError: false
  });

const inlineMath = (tex: string) =>
  katex.renderToString(tex, {
    displayMode: false,
    throwOnError: false
  });
---

<BaseLayout
  title="Constructing the Reals"
  description="A motivated abstract construction of the naturals, integers, rationals and reals."
>
  <section class="la-page">
    <RealAnalysisSidebar />

    <article class="topic-article">
      <header class="topic-hero">
        <span class="eyebrow">Real Analysis · Foundations</span>
        <h1>Constructing the Reals (& Co.)</h1>

        <p>
          A guided tour of the fundamental number systems and a detailed exploration of their inner-mechanics.
        </p>
      </header>

      <nav class="topic-toc" aria-label="Page sections">
        <a href="#broad-stroke">Broad Stroke</a>
        <a href="#quick-examples">Quick Examples</a>
        <a href="#a-deeper-look">A Deeper Look</a>
      </nav>

      <section class="topic-section" id="broad-stroke">
        <h2>Broad Stroke</h2>
	
	<p>
	  In this lesson, we'll construct the four fundamental number systems we are going to use in real analysis:
	  <span class = "emph"> natural numbers </span>,
	  <span class = "emph"> integers </span>,
	  <span class = "emph"> rationals </span> and
	  <span class = "emph"> real numbers </span>.
	  You most likely already know at this point what these are... or do you? We are aiming for a conrete (or is the word "abstract"?), rigorous
          definition for each of these concepts, one that doesn't rely on mere intuition, preconcieved notions or tangible objects to describe what the numbers represent.
	</p>
	  
      </section>

      <section class="topic-section" id="a-deeper-look">
        <h2>A Deeper Look</h2>
      </section>
    </article>
  </section>
</BaseLayout>
