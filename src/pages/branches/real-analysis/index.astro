---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RealAnalysisSidebar from "../../../components/RealAnalysisSidebar.astro";
import { withBase } from "@/utils/paths";
import katex from "katex";

const completeness = katex.renderToString(
  String.raw`\varnothing\neq A\subseteq\mathbb{R},\ A\text{ bounded above}\Longrightarrow \sup A\in\mathbb{R}`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const epsilonDelta = katex.renderToString(
  String.raw`\forall\varepsilon>0\ \exists\delta>0:\ |x-a|<\delta\Longrightarrow |f(x)-L|<\varepsilon`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const branchHref = withBase("branches/real-analysis/");

const lessons = [
  {
    number: "01",
    title: "The Real Number System",
    href: withBase("branches/real-analysis/lessons/real-number-system/"),
    text: "Order, absolute value, bounds, suprema, infima, completeness, and the construction of the continuum."
  },
  {
    number: "02",
    title: "Sequences and Convergence",
    href: withBase("branches/real-analysis/"),
    text: "Limits, subsequences, monotone sequences, Cauchy sequences, limsup, and liminf."
  },
  {
    number: "03",
    title: "Limits of Functions",
    href: withBase("branches/real-analysis/"),
    text: "Local behavior, one-sided limits, infinite limits, algebra of limits, and epsilon-delta proofs."
  },
  {
    number: "04",
    title: "Continuity",
    href: withBase("branches/real-analysis/"),
    text: "Pointwise and uniform continuity, compactness arguments, connectedness, and preservation theorems."
  },
  {
    number: "05",
    title: "Differentiation",
    href: withBase("branches/real-analysis/"),
    text: "Derivatives, mean-value principles, Taylor approximation, convexity, and inverse-function behavior."
  },
  {
    number: "06",
    title: "Riemann Integration",
    href: withBase("branches/real-analysis/"),
    text: "Upper and lower sums, integrability, the fundamental theorem of calculus, and improper integrals."
  },
  {
    number: "07",
    title: "Series of Numbers and Functions",
    href: withBase("branches/real-analysis/"),
    text: "Convergence tests, power series, uniform convergence, and interchange of limiting operations."
  },
  {
    number: "08",
    title: "Metric Spaces",
    href: withBase("branches/real-analysis/"),
    text: "Open and closed sets, compactness, completeness, continuity, contraction mappings, and abstract convergence."
  },
];

const problems = [
  {
    title: "A supremum argument",
    text: "Prove the existence of a limit by translating monotonicity and boundedness into a least-upper-bound argument."
  },
  {
    title: "Uniform versus pointwise convergence",
    text: "Construct and analyze a sequence of functions whose pointwise limit exists but whose convergence is not uniform."
  },
  {
    title: "Differentiation under a limit",
    text: "Determine which hypotheses justify exchanging a derivative with an infinite limit and exhibit what fails without them."
  },
];

const theorems = [
  "Bolzano–Weierstrass Theorem",
  "Heine–Borel Theorem",
  "Intermediate Value Theorem",
  "Mean Value Theorem",
  "Fundamental Theorem of Calculus"
];

const definitions = [
  "Supremum",
  "Convergent sequence",
  "Cauchy sequence",
  "Continuity",
  "Uniform continuity",
  "Derivative",
  "Riemann integrability",
  "Compactness"
];
---

<BaseLayout
  title="Real Analysis"
  description="A structured path through the real number system, convergence, continuity, differentiation, integration, metric spaces, and related problems."
>
  <section class="hub-page">
    <RealAnalysisSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Branch prototype</span>

        <h1>Real Analysis</h1>

        <p>
          This page will become the main entrance to the real analysis section. It can eventually explain how analysis turns intuitive ideas about limits, approximation, continuity, and infinite processes into a precise theory built on the completeness of the real numbers.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a class="hub-overview-card" href={branchHref}>
          <span class="eyebrow">Core idea</span>

          <h2>Controlled approximation</h2>

          <p>
            Real analysis studies when approximation is reliable: when sequences converge,
            functions vary continuously, derivatives exist, and infinite processes preserve meaning.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Foundational principle</span>

          <div class="hub-formula" set:html={completeness} />

          <p>
            Completeness distinguishes the real numbers from the rationals and supports the central existence theorems of elementary analysis.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Limit language</span>

          <div class="hub-formula" set:html={epsilonDelta} />

          <p>
            Epsilon-delta reasoning expresses exactly what it means for errors in the input to force controlled errors in the output.
          </p>
        </a>
      </section>

      <section class="hub-section" id="lessons">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            A sequential path through the central concepts. These cards are
            highlights; later they can point to complete lesson pages.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section" id="problems">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            A small rotating shelf of problems. Later, this can be replaced by
            a full archive with difficulty, topic, and method tags.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a class="hub-problem-card" href={branchHref}>
                <span class="eyebrow">Problem</span>

                <h3>{problem.title}</h3>

                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a class="hub-index-card" id="theorems" href={branchHref}>
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a class="hub-index-card" id="definitions" href={branchHref}>
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
