---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import RealAnalysisSidebar from "../../../../components/RealAnalysisSidebar.astro";

const items = [
  "Abel's Theorem for Power Series",
  "Alternating Series Test",
  "Arzel\u00e0\u2013Ascoli Theorem",
  "Banach Fixed-Point Theorem",
  "Bolzano\u2013Weierstrass Theorem",
  "Cauchy Condensation Test",
  "Cauchy Criterion for Convergence of Sequences",
  "Cauchy Criterion for Convergence of Series",
  "Cauchy Mean Value Theorem",
  "Darboux's Theorem",
  "Dini's Theorem",
  "Extreme Value Theorem",
  "Fundamental Theorem of Calculus",
  "Heine\u2013Borel Theorem",
  "Heine\u2013Cantor Theorem",
  "Intermediate Value Theorem",
  "Leibniz Test",
  "Mean Value Theorem",
  "Monotone Convergence Theorem for Sequences",
  "Nested Interval Theorem",
  "Ratio Test",
  "Riemann Integrability Criterion",
  "Rolle's Theorem",
  "Root Test",
  "Taylor's Theorem",
  "Uniform Cauchy Criterion",
  "Uniform Limit Theorem",
  "Weierstrass Approximation Theorem"
];

const letters = [...new Set(items.map((item) => item[0].toUpperCase()))];
---

<BaseLayout
  title="Real Analysis Theorems"
  description="An alphabetical index of real analysis theorems."
