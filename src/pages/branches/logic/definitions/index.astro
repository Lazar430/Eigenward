const letters = [...new Set(items.map((item) => item[0].toUpperCase()))];
---

<BaseLayout
  title="Mathematical Logic Definitions"
  description="An alphabetical index of mathematical logic definitions."
>
  <section class="hub-page">
    <MathematicalLogicSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Mathematical Logic · Definitions</span>

        <h1>Definitions</h1>

        <p>
          An alphabetical index of the principal syntactic, semantic, proof-theoretic, computability, and metamathematical vocabulary used throughout the mathematical logic section.
        </p>
      </section>

      <section class="index-tools" aria-label="Definitions index controls">
        <label class="search-control">
          <span>Search definitions</span>
          <input
            id="definition-search"
            type="search"
            placeholder="Try “model”, “provability”, “recursive”…"
            autocomplete="off"
          />
        </label>

        <nav class="alphabet-nav" aria-label="Jump to letter">
          {
            letters.map((letter) => (
              <a href={`#definitions-${letter}`}>{letter}</a>
            ))
          }
        </nav>

        <output id="definition-result-count" aria-live="polite">
          {items.length} definitions
        </output>
      </section>

      <div class="alphabet-index" id="definition-index">
        <section class="alphabet-group" data-alpha-group>
          <h2 id="definitions-A">A</h2>

          <div class="alphabet-entry-list">
