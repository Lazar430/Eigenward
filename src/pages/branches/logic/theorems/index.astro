---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import MathematicalLogicSidebar from "../../../../components/MathematicalLogicSidebar.astro";

const items = [
  "Church's Theorem",
  "Church\u2013Turing Thesis",
  "Compactness Theorem for First-Order Logic",
  "Cook\u2013Levin Theorem",
  "Craig Interpolation Theorem",
  "Cut-Elimination Theorem",
  "Deduction Theorem",
  "Diagonal Lemma",
  "Downward L\u00f6wenheim\u2013Skolem Theorem",
  "G\u00f6del Completeness Theorem",
  "G\u00f6del's First Incompleteness Theorem",
  "G\u00f6del's Second Incompleteness Theorem",
  "Herbrand's Theorem",
  "Kleene Normal Form Theorem",
  "Kleene Recursion Theorem",
  "Lindenbaum Lemma",
  "L\u00f6b's Theorem",
  "L\u00f6wenheim\u2013Skolem Theorem",
  "Post's Theorem",
  "Propositional Compactness Theorem",
  "Propositional Completeness Theorem",
  "Rice's Theorem",
  "Rosser's Theorem",
  "Soundness Theorem",
  "Strong Completeness Theorem",
  "Tarski's Undefinability Theorem",
  "Trakhtenbrot's Theorem",
  "Undecidability of the Halting Problem",
  "Upward L\u00f6wenheim\u2013Skolem Theorem"
];

const letters = [...new Set(items.map((item) => item[0].toUpperCase()))];
---

<BaseLayout
  title="Mathematical Logic Theorems"
  description="An alphabetical index of mathematical logic theorems."
>
  <section class="hub-page">
    <MathematicalLogicSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Mathematical Logic · Theorems</span>

        <h1>Theorems</h1>

        <p>
          An alphabetical index of the principal soundness, completeness, compactness, computability, undecidability, and incompleteness results used throughout the mathematical logic section.
        </p>
      </section>

      <section class="index-tools" aria-label="Theorems index controls">
        <label class="search-control">
          <span>Search theorems</span>
          <input
            id="theorem-search"
            type="search"
            placeholder="Try “completeness”, “Gödel”, “undecidability”…"
            autocomplete="off"
          />
        </label>

        <nav class="alphabet-nav" aria-label="Jump to letter">
          {
            letters.map((letter) => (
              <a href={`#theorems-${letter}`}>{letter}</a>
            ))
          }
        </nav>

        <output id="theorem-result-count" aria-live="polite">
          {items.length} theorems
        </output>
      </section>

      <div class="alphabet-index" id="theorem-index">
        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-C">C</h2>

          <div class="alphabet-entry-list">
              <a
                id="church-s-theorem"
                class="index-entry"
                href="#church-s-theorem"
                data-index-entry
                data-search-term="church's theorem"
