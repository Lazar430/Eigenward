---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MathematicalLogicSidebar from "../../../components/MathematicalLogicSidebar.astro";
import { withBase } from "@/utils/paths";
import katex from "katex";

const completeness = katex.renderToString(
  String.raw`\Gamma\vdash\varphi\quad\Longleftrightarrow\quad\Gamma\models\varphi`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const incompleteness = katex.renderToString(
  String.raw`T\nvdash G_T\qquad\text{and}\qquad T\nvdash\neg G_T`,
  {
    displayMode: true,
    throwOnError: false
  }
);

const branchHref = withBase("branches/logic/");

const lessons = [
  {
    number: "01",
    title: "Propositional Syntax",
    href: withBase("branches/logic/"),
    text: "Formulas, connectives, parse trees, substitutions, normal forms, and formal languages."
  },
  {
    number: "02",
    title: "Propositional Semantics",
    href: withBase("branches/logic/"),
    text: "Valuations, truth tables, satisfiability, validity, semantic consequence, and compactness."
  },
  {
    number: "03",
    title: "Deductive Systems",
    href: withBase("branches/logic/"),
    text: "Axiomatic calculi, natural deduction, sequents, formal derivations, soundness, and proof normalization."
  },
  {
    number: "04",
    title: "First-Order Languages",
    href: withBase("branches/logic/"),
    text: "Terms, predicates, quantifiers, free and bound variables, substitution, and formal theories."
  },
  {
    number: "05",
    title: "Structures and Satisfaction",
    href: withBase("branches/logic/"),
    text: "Interpretations, assignments, models, truth in a structure, and semantic consequence."
  },
  {
    number: "06",
    title: "Completeness and Compactness",
    href: withBase("branches/logic/"),
    text: "Henkin constructions, maximal consistent sets, completeness, compactness, and their applications."
  },
  {
    number: "07",
    title: "Computability and Decidability",
    href: withBase("branches/logic/"),
    text: "Algorithms, recursive functions, Turing machines, enumerable theories, and undecidable problems."
  },
  {
    number: "08",
    title: "Gödel's Incompleteness Theorems",
    href: withBase("branches/logic/"),
    text: "Arithmetization, diagonalization, incompleteness, consistency statements, and formal limitations."
  },
];

const problems = [
  {
    title: "Normal forms and validity",
    text: "Convert a propositional formula into conjunctive and disjunctive normal form and determine whether it is valid."
  },
  {
    title: "A formal derivation",
    text: "Construct a derivation in natural deduction while recording every discharged assumption and rule application."
  },
  {
    title: "A compactness construction",
    text: "Use compactness to produce a model with a global property enforced only through infinitely many finite conditions."
  },
];

const theorems = [
  "Soundness Theorem",
  "Gödel Completeness Theorem",
  "Compactness Theorem",
  "Löwenheim–Skolem Theorem",
  "Gödel Incompleteness Theorems"
];

const definitions = [
  "Formal language",
  "Formula",
  "Valuation",
  "Derivation",
  "Model",
  "Satisfiability",
  "Validity",
  "Decidability"
];
---

<BaseLayout
  title="Mathematical Logic"
  description="A structured path through formal languages, semantics, proof systems, first-order logic, completeness, computability, and incompleteness."
>
  <section class="hub-page">
    <MathematicalLogicSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Branch prototype</span>

        <h1>Mathematical Logic</h1>

        <p>
          This page will become the main entrance to the mathematical logic section. It can eventually explain how mathematical statements acquire formal syntax, how proofs and models give two different notions of consequence, and where the powers and limits of formal systems lie.
        </p>
      </section>

      <section class="hub-overview-grid">
        <a class="hub-overview-card" href={branchHref}>
          <span class="eyebrow">Core idea</span>

          <h2>Reasoning made mathematical</h2>

          <p>
            Mathematical logic turns formulas, proofs, truth, definability, and computation into mathematical objects that can themselves be studied.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Proof and truth</span>

          <div class="hub-formula" set:html={completeness} />

          <p>
            For first-order logic, soundness and completeness connect formal derivability with semantic consequence.
          </p>
        </a>

        <a class="hub-overview-card formuhub-card" href={branchHref}>
          <span class="eyebrow">Metamathematical limit</span>

          <div class="hub-formula" set:html={incompleteness} />

          <p>
            A sufficiently expressive, consistent, effectively axiomatized theory cannot decide every sentence formulated in its own language.
          </p>
        </a>
      </section>

      <section class="hub-section" id="lessons">
        <div class="section-header">
          <h2>Lessons</h2>

          <p>
            A sequential path through the central concepts. These cards are
            highlights; later they can point to complete lesson pages.
          </p>
        </div>

        <div class="lesson-timeline">
          {
            lessons.map((lesson) => (
              <a class="lesson-card" href={lesson.href}>
                <span class="lesson-number">{lesson.number}</span>

                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.text}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-section" id="problems">
        <div class="section-header">
          <h2>Highlighted problems</h2>

          <p>
            A small rotating shelf of problems. Later, this can be replaced by
            a full archive with difficulty, topic, and method tags.
          </p>
        </div>

        <div class="hub-problem-grid">
          {
            problems.map((problem) => (
              <a class="hub-problem-card" href={branchHref}>
                <span class="eyebrow">Problem</span>

                <h3>{problem.title}</h3>

                <p>{problem.text}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="hub-index-grid">
        <a class="hub-index-card" id="theorems" href={branchHref}>
          <span class="eyebrow">Theorem index</span>

          <h2>Theorems</h2>

          <ul>
            {theorems.map((theorem) => <li>{theorem}</li>)}
          </ul>
        </a>

        <a class="hub-index-card" id="definitions" href={branchHref}>
          <span class="eyebrow">Definition index</span>

          <h2>Definitions</h2>

          <ul>
            {definitions.map((definition) => <li>{definition}</li>)}
          </ul>
        </a>
      </section>
    </div>
  </section>
</BaseLayout>
