  <section class="hub-page">
    <ComplexAnalysisSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Complex Analysis · Definitions</span>

        <h1>Definitions</h1>

        <p>
          An alphabetical index of the principal functions, singularities, contour notions, series, mapping concepts, and local or global analytic structures used throughout complex analysis.
        </p>
      </section>

      <section class="index-tools" aria-label="Definitions index controls">
        <label class="search-control">
          <span>Search definitions</span>

          <input
            id="definition-search"
            type="search"
            placeholder="Try “residue”, “branch”, “holomorphic”…"
            autocomplete="off"
          />
        </label>

        <nav class="alphabet-nav" aria-label="Jump to letter">
          {
            letters.map((letter) => (
              <a href={`#definitions-${letter}`}>{letter}</a>
            ))
          }
        </nav>

        <output id="definition-result-count" aria-live="polite">
          {items.length} definitions
        </output>
      </section>

