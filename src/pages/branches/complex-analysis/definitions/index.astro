  "Analytic function",
  "Argument",
  "Argument principle",
  "Branch",
  "Branch cut",
  "Branch point",
  "Cauchy\u2013Riemann equations",
  "Complex contour",
  "Complex derivative",
  "Complex logarithm",
  "Complex power",
  "Conformal map",
  "Contour integral",
  "Domain",
  "Entire function",
  "Essential singularity",
  "Harmonic conjugate",
  "Harmonic function",
  "Holomorphic function",
  "Identity theorem",
  "Isolated singularity",
  "Laurent series",
  "Meromorphic function",
  "M\u00f6bius transformation",
  "Normal family",
  "Order of a pole",
  "Order of a zero",
  "Pole",
  "Primitive",
  "Principal branch",
  "Principal part",
  "Removable singularity",
  "Residue",
  "Residue at infinity",
  "Riemann sphere",
  "Simple pole",
  "Simply connected domain",
  "Taylor series",
  "Winding number",
  "Zero of a holomorphic function"
];

const letters = [...new Set(items.map((item) => item[0].toUpperCase()))];
---

<BaseLayout
  title="Complex Analysis Definitions"
  description="An alphabetical index of complex analysis definitions."
