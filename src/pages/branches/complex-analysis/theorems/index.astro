---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ComplexAnalysisSidebar from "../../../../components/ComplexAnalysisSidebar.astro";

const items = [
  "Argument Principle",
  "Casorati\u2013Weierstrass Theorem",
  "Cauchy Estimates",
  "Cauchy's Integral Formula",
  "Cauchy's Integral Theorem",
  "Cauchy\u2013Goursat Theorem",
  "Fundamental Theorem of Algebra",
  "Great Picard Theorem",
  "Hurwitz's Theorem",
  "Identity Theorem",
  "Jordan's Lemma",
  "Liouville's Theorem",
  "Maximum Modulus Principle",
  "Minimum Modulus Principle",
  "Montel's Theorem",
  "Morera's Theorem",
  "Open Mapping Theorem",
  "Residue Theorem",
  "Riemann Mapping Theorem",
  "Rouch\u00e9's Theorem",
  "Schwarz Lemma",
  "Schwarz Reflection Principle",
  "Schwarz\u2013Pick Theorem",
  "Weierstrass Theorem on Locally Uniform Limits"
];

const letters = [...new Set(items.map((item) => item[0].toUpperCase()))];
---

<BaseLayout
  title="Complex Analysis Theorems"
  description="An alphabetical index of complex analysis theorems."
>
  <section class="hub-page">
    <ComplexAnalysisSidebar />

    <div class="hub-main">
      <section class="hub-hero">
        <span class="eyebrow">Complex Analysis · Theorems</span>

        <h1>Theorems</h1>

        <p>
          An alphabetical index of the principal integral, uniqueness, singularity, zero-counting, mapping, compactness, and rigidity theorems used throughout complex analysis.
        </p>
      </section>

      <section class="index-tools" aria-label="Theorems index controls">
        <label class="search-control">
          <span>Search theorems</span>

          <input
            id="theorem-search"
            type="search"
            placeholder="Try “Cauchy”, “Schwarz”, “Rouché”…"
            autocomplete="off"
          />
        </label>

        <nav class="alphabet-nav" aria-label="Jump to letter">
          {
            letters.map((letter) => (
              <a href={`#theorems-${letter}`}>{letter}</a>
            ))
          }
        </nav>

        <output id="theorem-result-count" aria-live="polite">
          {items.length} theorems
        </output>
      </section>

      <div class="alphabet-index" id="theorem-index">
        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-A">A</h2>

          <div class="alphabet-entry-list">
              <a
                id="argument-principle"
                class="index-entry"
                href="#argument-principle"
                data-index-entry
                data-search-term="argument principle"
