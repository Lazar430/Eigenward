          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-I">I</h2>

          <div class="alphabet-entry-list">
              <a
                id="identity-theorem"
                class="index-entry"
                href="#identity-theorem"
                data-index-entry
                data-search-term="identity theorem"
              >
                <span>Identity Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
