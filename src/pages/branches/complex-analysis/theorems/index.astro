          <div class="alphabet-entry-list">
              <a
                id="open-mapping-theorem"
                class="index-entry"
                href="#open-mapping-theorem"
                data-index-entry
                data-search-term="open mapping theorem"
              >
                <span>Open Mapping Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
          </div>
        </section>        <section class="alphabet-group" data-alpha-group>
          <h2 id="theorems-R">R</h2>

          <div class="alphabet-entry-list">
              <a
