                href="#casorati-weierstrass-theorem"
                data-index-entry
                data-search-term="casorati\u2013weierstrass theorem"
              >
                <span>Casorati–Weierstrass Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
              <a
