                data-index-entry
                data-search-term="cauchy's integral formula"
              >
                <span>Cauchy's Integral Formula</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
              <a
                id="cauchy-s-integral-theorem"
                class="index-entry"
                href="#cauchy-s-integral-theorem"
                data-index-entry
                data-search-term="cauchy's integral theorem"
              >
                <span>Cauchy's Integral Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
              <a
                id="cauchy-goursat-theorem"
                class="index-entry"
                href="#cauchy-goursat-theorem"
                data-index-entry
                data-search-term="cauchy\u2013goursat theorem"
              >
                <span>Cauchy–Goursat Theorem</span>
                <span class="index-arrow" aria-hidden="true">→</span>
