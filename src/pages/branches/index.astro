const GROUP_COLORS: Record<GroupId, string> = {
  "foundations": "#8e7dff",
  "algebra": "#ff7597",
  "number-theory": "#ffb04f",
  "geometry": "#52ddc7",
  "topology": "#2fd6a3",
  "analysis": "#65b7ff",
  "probability-statistics": "#7fa0ff",
  "discrete-mathematics": "#f4bd61",
  "computing": "#ff9a63",
  "mathematical-physics": "#d68cff",
  "applied-mathematics": "#ff86c8",
};

type TextOrientation = "radial" | "tangential";

type SunburstNode = {
  id: string;
  label: string;
  group: GroupId;
  prerequisites: string[];
  href: string;
  parent: SunburstNode | null;
  children: SunburstNode[];
  depth: number;
  weight: number;
  startAngle: number;
  endAngle: number;
  lines: string[];
  textOrientation: TextOrientation;
  fontSize: number;
};

type SunburstSector = {
  id: string;
  label: string;
  labelLower: string;
  href: string;
  prerequisites: string[];
  depth: number;
  path: string;
  fill: string;
  fillOpacity: number;
  stroke: string;
  textX: number;
  textY: number;
  textRotation: number;
  fontSize: number;
  orientation: TextOrientation;
  lines: {
    text: string;
    dy: string;
  }[];
};

type SunburstChart = {
  id: GroupId;
  label: string;
  shortLabel: string;
  color: string;
  sectors: SunburstSector[];
  centerLines: string[];
  topicCount: number;
  labelFontSize: number;
};

const SUNBURST_SIZE = 1400;
const SUNBURST_CENTER = SUNBURST_SIZE / 2;

/*
 * A slightly larger center gives the first ring more circumference, which
 * matters for dense groups such as Mathematical Physics. It also matches the
 * visual proportions of a conventional sunburst better than the earlier tiny
 * center disc.
 */
const SUNBURST_INNER_RADIUS = 130;
const SUNBURST_OUTER_RADIUS = 640;
const SUNBURST_GAP = 0.008;

const PREFERRED_LABEL_FONT_SIZE = 19;
const MINIMUM_LABEL_FONT_SIZE = 14.5;
const LABEL_FONT_STEP = 0.5;
const LABEL_LINE_HEIGHT = 1.08;
const LABEL_RADIAL_PADDING = 24;
const LABEL_ANGULAR_PADDING = 20;
const MAX_LABEL_LINES = 3;
const MAX_ROOT_ANGULAR_LOAD = Math.PI * 2 * 0.985;

function clamp(value: number, minimum: number, maximum: number) {
  return Math.min(maximum, Math.max(minimum, value));
}

function hexToRgb(hex: string): [number, number, number] {
  const value = hex.replace("#", "");
  return [
    Number.parseInt(value.slice(0, 2), 16),
    Number.parseInt(value.slice(2, 4), 16),
    Number.parseInt(value.slice(4, 6), 16),
  ];
}

function mixHex(left: string, right: string, amount: number): string {
  const a = hexToRgb(left);
  const b = hexToRgb(right);
  const t = clamp(amount, 0, 1);

  const mixed = a.map((channel, index) =>
    Math.round(channel + (b[index] - channel) * t),
  );

  return `rgb(${mixed[0]}, ${mixed[1]}, ${mixed[2]})`;
}

/*
 * A deliberately conservative approximation of glyph widths.
 *
 * The old layout estimated a label from character count alone and then used a
 * clip-path/textLength as a safety net. That is what produced both overflowing
 * labels and the "partially erased" look.
 *
 * Here the sector allocation itself is based on an estimated rendered width.
 * Wide letters such as M/W receive more space, narrow letters such as i/l less,
 * and an additional safety factor is included.
 */
function estimatedGlyphWidthEm(character: string): number {
  if (/\s/.test(character)) return 0.32;
  if ("ilIjtfr.,:;|'`".includes(character)) return 0.28;
  if ("mwMW@%&QO".includes(character)) return 0.82;
  if ("-–—/()".includes(character)) return 0.42;
  if (/[A-Z]/.test(character)) return 0.64;
  if (/[0-9]/.test(character)) return 0.56;
  return 0.53;
}

function estimateTextWidth(text: string, fontSize: number): number {
  let emWidth = 0;

  for (const character of text) {
    emWidth += estimatedGlyphWidthEm(character);
  }

  return emWidth * fontSize * 1.10;
}

function lineBreakCandidates(
  label: string,
  maximumLines = MAX_LABEL_LINES,
): string[][] {
  const words = label.split(/\s+/).filter(Boolean);
  const candidates: string[][] = [[label]];

  if (words.length <= 1) {
    return candidates;
  }

  for (let firstCut = 1; firstCut < words.length; firstCut += 1) {
    candidates.push([
      words.slice(0, firstCut).join(" "),
      words.slice(firstCut).join(" "),
    ]);
  }

  if (maximumLines >= 3) {
    for (let firstCut = 1; firstCut < words.length - 1; firstCut += 1) {
      for (
        let secondCut = firstCut + 1;
        secondCut < words.length;
        secondCut += 1
      ) {
        candidates.push([
          words.slice(0, firstCut).join(" "),
          words.slice(firstCut, secondCut).join(" "),
          words.slice(secondCut).join(" "),
        ]);
      }
    }
  }

  return candidates.filter((candidate) => candidate.length <= maximumLines);
}

type TextLayoutChoice = {
  orientation: TextOrientation;
  lines: string[];
  angularDemand: number;
};

/*
 * Choose the cheaper of two legitimate ways of placing a label:
 *
 *   radial:
 *     text runs outward from the center; available WIDTH is ring thickness,
 *     while multiple rows consume angular room.
 *
 *   tangential:
 *     text runs around the circle; available WIDTH is arc length, while
 *     multiple rows consume ring thickness.
 *
 * This hybrid is important. Long one-word labels such as "Electromagnetism"
 * are often better tangentially, while multi-word labels often fit beautifully
 * in a radial sector. We therefore use the geometry of each individual label
 * rather than forcing one orientation on the whole chart.
 */
function chooseTextLayout(
  label: string,
  fontSize: number,
  innerRadius: number,
  outerRadius: number,
): TextLayoutChoice {
  const ringThickness = outerRadius - innerRadius;
  const usableRadialSpace = Math.max(
    1,
    ringThickness - LABEL_RADIAL_PADDING,
  );

  const midRadius = (innerRadius + outerRadius) / 2;
  const lineHeight = fontSize * LABEL_LINE_HEIGHT;

  const choices: TextLayoutChoice[] = [];

  for (const lines of lineBreakCandidates(label)) {
    const widths = lines.map((line) => estimateTextWidth(line, fontSize));
    const widestLine = Math.max(...widths);
    const blockHeight = lines.length * lineHeight;

    /*
     * Radial baseline:
     * the literal text width must fit in the ring thickness.
     */
    if (widestLine <= usableRadialSpace) {
      choices.push({
        orientation: "radial",
        lines,
        angularDemand:
          (blockHeight + LABEL_ANGULAR_PADDING) /
            Math.max(midRadius, 1),
      });
    }

    /*
     * Tangential baseline:
     * rows stack radially, so the full line block must fit inside the ring.
     * Use the innermost radius touched by the text when estimating the arc
     * length required, which is more conservative than using the midpoint.
     */
    if (blockHeight <= usableRadialSpace) {
      const minimumTextRadius = Math.max(
        innerRadius + LABEL_RADIAL_PADDING / 2,
        midRadius - blockHeight / 2,
      );

      choices.push({
        orientation: "tangential",
        lines,
        angularDemand:
          (widestLine + LABEL_ANGULAR_PADDING) /
            Math.max(minimumTextRadius, 1),
      });
    }
  }

  /*
   * At the minimum font size every ring in the current data has at least one
   * valid orientation. Keep a defensive fallback anyway so future subject
   * names cannot crash the page.
   */
  if (choices.length === 0) {
    return {
      orientation: "tangential",
      lines: [label],
      angularDemand:
        (estimateTextWidth(label, fontSize) + LABEL_ANGULAR_PADDING) /
          Math.max((innerRadius + outerRadius) / 2, 1),
    };
  }

  return choices.reduce((best, candidate) =>
    candidate.angularDemand < best.angularDemand
      ? candidate
      : best,
  );
}

function buildTree(groupId: GroupId): SunburstNode[] {
  const groupTopics = topics.filter((topic) => topic.group === groupId);

  const topicMap = new Map<string, SunburstNode>(
    groupTopics.map((topic) => [
      topic.id,
      {
        id: topic.id,
        label: topic.label,
        group: topic.group,
        prerequisites: [...topic.prerequisites],
        href: withBase(`branches/${topic.id}/`),
        parent: null,
        children: [],
        depth: 1,
        weight: 1,
        startAngle: 0,
        endAngle: 0,
        lines: [topic.label],
        textOrientation: "radial",
        fontSize: PREFERRED_LABEL_FONT_SIZE,
      },
    ]),
  );

  const roots: SunburstNode[] = [];

  for (const node of topicMap.values()) {
    const parent = node.prerequisites
      .map((id) => topicMap.get(id))
      .find((candidate) => candidate !== undefined);

    if (parent && parent !== node) {
      node.parent = parent;
      parent.children.push(node);
    } else {
      roots.push(node);
    }
  }

  function assignDepth(
    node: SunburstNode,
    depth: number,
    ancestors = new Set<string>(),
  ) {
    if (ancestors.has(node.id)) return;

    const nextAncestors = new Set(ancestors);
    nextAncestors.add(node.id);

    node.depth = depth;

    for (const child of node.children) {
      assignDepth(child, depth + 1, nextAncestors);
    }
  }

  for (const root of roots) {
    assignDepth(root, 1);
  }

  return roots;
}

function flattenTree(roots: SunburstNode[]): SunburstNode[] {
  const result: SunburstNode[] = [];
  const visited = new Set<string>();

  function visit(node: SunburstNode) {
    if (visited.has(node.id)) return;

    visited.add(node.id);
    result.push(node);

    for (const child of node.children) {
      visit(child);
    }
  }

  for (const root of roots) {
    visit(root);
  }

  return result;
}

/*
 * Equal-depth rings are much easier to reason about once labels can choose
 * their orientation independently. Every ring therefore receives a predictable
 * radial budget, and the label solver above decides how best to use it.
 */
function buildRadiusBoundaries(maximumDepth: number): number[] {
  return Array.from({ length: maximumDepth + 1 }, (_, index) =>
    SUNBURST_INNER_RADIUS +
      ((SUNBURST_OUTER_RADIUS - SUNBURST_INNER_RADIUS) * index) /
	maximumDepth,
  );
}

function assignWeights(
  node: SunburstNode,
  radiusBoundaries: number[],
  fontSize: number,
  ancestors = new Set<string>(),
): number {
  if (ancestors.has(node.id)) {
    node.weight = 1;
    return node.weight;
  }

  const nextAncestors = new Set(ancestors);
  nextAncestors.add(node.id);

  const innerRadius = radiusBoundaries[node.depth - 1];
  const outerRadius = radiusBoundaries[node.depth];

  const layout = chooseTextLayout(
    node.label,
    fontSize,
    innerRadius,
    outerRadius,
  );

  node.lines = layout.lines;
  node.textOrientation = layout.orientation;
  node.fontSize = fontSize;

  const childrenDemand = node.children.reduce(
    (sum, child) =>
      sum +
	assignWeights(
          child,
          radiusBoundaries,
          fontSize,
          nextAncestors,
	),
    0,
  );

  /*
   * A parent sector must be wide enough both for its own label and for every
   * child sector contained inside it.
   */
  node.weight = Math.max(
    layout.angularDemand,
    childrenDemand,
    0.055,
  );

  return node.weight;
}

function totalRootDemand(
  roots: SunburstNode[],
  radiusBoundaries: number[],
  fontSize: number,
): number {
  return roots.reduce(
    (sum, root) =>
      sum +
	assignWeights(
          root,
          radiusBoundaries,
          fontSize,
	),
    0,
  );
}

function chooseGroupFontSize(
  roots: SunburstNode[],
  radiusBoundaries: number[],
): number {
  let fontSize = PREFERRED_LABEL_FONT_SIZE;

  while (fontSize > MINIMUM_LABEL_FONT_SIZE) {
    const demand = totalRootDemand(
      roots,
      radiusBoundaries,
      fontSize,
    );

    if (demand <= MAX_ROOT_ANGULAR_LOAD) {
      return fontSize;
    }

    fontSize -= LABEL_FONT_STEP;
  }

  return MINIMUM_LABEL_FONT_SIZE;
}

function assignAngles(
  nodes: SunburstNode[],
  startAngle: number,
  endAngle: number,
) {
  const totalWeight = nodes.reduce((sum, node) => sum + node.weight, 0);
  let cursor = startAngle;

  nodes.forEach((node, index) => {
    const span =
      index === nodes.length - 1
        ? endAngle - cursor
        : ((endAngle - startAngle) * node.weight) /
          Math.max(totalWeight, 1);

    node.startAngle = cursor;
    node.endAngle = cursor + span;

    if (node.children.length > 0) {
      assignAngles(node.children, node.startAngle, node.endAngle);
    }

    cursor += span;
  });
}

function polar(radius: number, angle: number): [number, number] {
  return [
    SUNBURST_CENTER + radius * Math.cos(angle),
    SUNBURST_CENTER + radius * Math.sin(angle),
  ];
}

function annularSectorPath(
  innerRadius: number,
  outerRadius: number,
  startAngle: number,
  endAngle: number,
): string {
  const start = startAngle + SUNBURST_GAP;
  const end = endAngle - SUNBURST_GAP;

  if (end <= start) return "";

  const [outerStartX, outerStartY] = polar(outerRadius, start);
  const [outerEndX, outerEndY] = polar(outerRadius, end);
  const [innerEndX, innerEndY] = polar(innerRadius, end);
  const [innerStartX, innerStartY] = polar(innerRadius, start);

  const largeArc = end - start > Math.PI ? 1 : 0;

  return [
    `M ${outerStartX} ${outerStartY}`,
    `A ${outerRadius} ${outerRadius} 0 ${largeArc} 1 ${outerEndX} ${outerEndY}`,
    `L ${innerEndX} ${innerEndY}`,
    `A ${innerRadius} ${innerRadius} 0 ${largeArc} 0 ${innerStartX} ${innerStartY}`,
    "Z",
  ].join(" ");
}

function makeSector(
  node: SunburstNode,
  groupId: GroupId,
  radiusBoundaries: number[],
): SunburstSector {
  const innerRadius = radiusBoundaries[node.depth - 1];
  const outerRadius = radiusBoundaries[node.depth];
  const midRadius = (innerRadius + outerRadius) / 2;
  const midAngle = (node.startAngle + node.endAngle) / 2;

  const [textX, textY] = polar(midRadius, midAngle);

  const angleDegrees = (midAngle * 180) / Math.PI;

  /*
   * Radial text follows the radius.
   * Tangential text follows the local tangent, hence the additional 90°.
   */
  let textRotation =
    angleDegrees +
      (node.textOrientation === "tangential" ? 90 : 0);

  const normalizedRotation = ((textRotation % 360) + 360) % 360;

  if (normalizedRotation > 90 && normalizedRotation < 270) {
    textRotation += 180;
  }

  const lineHeight = node.fontSize * LABEL_LINE_HEIGHT;

  const lines = node.lines.map((line, index) => ({
    text: line,
    dy:
      index === 0
        ? node.lines.length === 1
        ? "0"
        : `${-((node.lines.length - 1) * lineHeight) / 2}px`
        : `${lineHeight}px`,
  }));

  const baseColor = GROUP_COLORS[groupId];
  const darkness = clamp(
    0.1 + (node.depth - 1) * 0.05,
    0.1,
    0.34,
  );
  const fillOpacity = clamp(
    0.86 - (node.depth - 1) * 0.03,
    0.74,
    0.86,
  );
  const stroke = mixHex(baseColor, "#120b24", 0.62);

  return {
    id: node.id,
    label: node.label,
    labelLower: node.label.toLowerCase(),
    href: node.href,
    prerequisites: node.prerequisites,
    depth: node.depth,
    path: annularSectorPath(
      innerRadius,
      outerRadius,
      node.startAngle,
      node.endAngle,
    ),
    fill: mixHex(baseColor, "#1c1432", darkness),
    fillOpacity,
    stroke,
    textX,
    textY,
    textRotation,
    fontSize: node.fontSize,
    orientation: node.textOrientation,
    lines,
  };
}

function centerLines(label: string): string[] {
  const words = label.split(/\s+/).filter(Boolean);

  if (words.length <= 2) {
    return [label];
  }

  const midpoint = Math.ceil(words.length / 2);

  return [
    words.slice(0, midpoint).join(" "),
    words.slice(midpoint).join(" "),
  ];
}

function buildSunburst(group: (typeof groups)[number]): SunburstChart {
  const roots = buildTree(group.id);
  const nodes = flattenTree(roots);

  const maximumDepth = Math.max(
    1,
    ...nodes.map((node) => node.depth),
  );

  const radiusBoundaries =
    buildRadiusBoundaries(maximumDepth);

  const labelFontSize =
    chooseGroupFontSize(
      roots,
      radiusBoundaries,
    );

  /*
   * Re-run once at the chosen final font. This stores the exact line breaks,
   * orientations and subtree weights that will be rendered.
   */
  totalRootDemand(
    roots,
    radiusBoundaries,
    labelFontSize,
  );

  assignAngles(
    roots,
    -Math.PI / 2,
    Math.PI * 1.5,
  );

  return {
    id: group.id,
    label: group.label,
    shortLabel: group.shortLabel,
    color: GROUP_COLORS[group.id],
    sectors: nodes.map((node) =>
      makeSector(
        node,
        group.id,
        radiusBoundaries,
      ),
    ),
    centerLines: centerLines(group.label),
    topicCount: nodes.length,
    labelFontSize,
  };
}

const sunbursts = groups.map(buildSunburst);
---

<BaseLayout title="Branches">
  <main class="branches-page">
    <header class="branches-hero">
      <p class="eyebrow">A map of the subject</p>
      <h1>Branches of Mathematics</h1>

      <p class="branches-intro">
        Mathematics is not a collection of sealed compartments. It is a network
        of ideas: subjects grow from earlier subjects, split into specialized
        theories, and reconnect through unexpected bridges.
      </p>

      <p class="branches-note">
        Solid arrows show major prerequisite or developmental paths. Dashed
        arrows show especially important cross-disciplinary connections. No
        such map can be perfectly canonical, since many subjects naturally
        belong to several areas at once.
      </p>
    </header>



    <section class="graph-panel" aria-labelledby="graph-heading">
      <div class="graph-panel-heading">
        <div>
          <p class="section-kicker">Interactive subject map</p>
          <h2 id="graph-heading">Sunburst of the selected area</h2>
        </div>

        <p class="sunburst-key">
          Move outward from the center into increasingly specialized subjects.
        </p>
      </div>

      <div class="graph-controls">
        <label class="search-control">
          <span>Find a subject</span>
          <input
            id="branch-search"
            type="search"
            placeholder="Highlight a subject…"
            autocomplete="off"
          />
        </label>

        <label class="group-control">
          <span>Area</span>
          <select id="group-filter">
            {groups.map((group) => (
              <option value={group.id}>{group.label}</option>
        ))}
          </select>
        </label>

        <output id="graph-result-count" aria-live="polite"></output>
      </div>

      <div class="group-legend" aria-label="Choose a subject area">
        {groups.map((group) => (
          <button
            class={`group-chip group-${group.id}`}
            type="button"
            data-group-jump={group.id}
          >
            <span class="group-dot"></span>
            {group.shortLabel}
          </button>
    ))}
      </div>
    </section>

    <div class="sunburst-viewport" id="sunburst-viewport">
      <svg
        id="sunburst-map"
        class="sunburst-map"
        viewBox={`0 0 ${SUNBURST_SIZE} ${SUNBURST_SIZE}`}
        role="img"
        aria-label="Sunburst diagram of the selected area of mathematics"
      >

        {sunbursts.map((chart, chartIndex) => (
          <g
            class={`sunburst-group group-${chart.id}`}
            data-sunburst-group={chart.id}
            style={`display:${chartIndex === 0 ? "block" : "none"};`}
          >
            {chart.sectors.map((sector) => (
              <a
                class="sunburst-sector"
                href={sector.href}
                data-node-label={sector.labelLower}
                data-node-id={sector.id}
                data-text-orientation={sector.orientation}
                aria-label={sector.label}
              >
                <path
                  class="sunburst-segment"
                  d={sector.path}
                  fill={sector.fill}
                  fill-opacity={sector.fillOpacity}
                  stroke={sector.stroke}
                  stroke-width="2.4"
                ></path>

                <text
                  class="sunburst-label"
                  x={sector.textX}
                  y={sector.textY}
                  fill="#ffffff"
                  stroke="rgba(8, 5, 20, 0.46)"
                  stroke-width="1.5"
                  paint-order="stroke"
                  text-anchor="middle"
                  dominant-baseline="middle"
                  font-size={sector.fontSize}
                  font-weight="760"
                  transform={`rotate(${sector.textRotation} ${sector.textX} ${sector.textY})`}
                >
                  {sector.lines.map((line) => (
                    <tspan
                      x={sector.textX}
                      dy={line.dy}
                    >
                      {line.text}
                    </tspan>
            ))}
                </text>
              </a>
              ))}

            <circle
              class="sunburst-center-disc"
              cx={SUNBURST_CENTER}
              cy={SUNBURST_CENTER}
              r={SUNBURST_INNER_RADIUS - 5}
              fill={mixHex(chart.color, "#0d081d", 0.72)}
              stroke={mixHex(chart.color, "#ffffff", 0.24)}
              stroke-width="4"
            ></circle>

            <text
              class="sunburst-center-label"
              x={SUNBURST_CENTER}
              y={SUNBURST_CENTER}
              fill="#ffffff"
              text-anchor="middle"
              dominant-baseline="middle"
              font-size="22"
              font-weight="820"
            >
              {chart.centerLines.map((line, index) => (
                <tspan
                  x={SUNBURST_CENTER}
                  dy={
                      index === 0
                      ? chart.centerLines.length === 1
                      ? "0"
                      : "-0.55em"
                      : "1.1em"
                  }
                >
                  {line}
                </tspan>
      ))}
            </text>
          </g>
))}
      </svg>
    </div>
  </main>
</BaseLayout>

<script>
    const svg =
    document.querySelector<SVGSVGElement>("#sunburst-map");

  const search =
    document.querySelector<HTMLInputElement>("#branch-search");

    const groupFilter =
      document.querySelector<HTMLSelectElement>("#group-filter");

    const resultCount =
      document.querySelector<HTMLOutputElement>("#graph-result-count");

    const charts = Array.from(
      document.querySelectorAll<SVGGElement>("[data-sunburst-group]"),
    );

    const groupButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-group-jump]"),
    );

    if (!svg || !groupFilter) {
      throw new Error("The branches sunburst could not be initialized.");
    }

    function currentChart(): SVGGElement | undefined {
      return charts.find(
	(chart) =>
          chart.dataset.sunburstGroup ===
            groupFilter.value,
      );
    }

    function applySearch() {
      const chart = currentChart();
      if (!chart) return;

      const query =
	(search?.value ?? "")
          .trim()
          .toLowerCase();

      const sectors = Array.from(
	chart.querySelectorAll<SVGAElement>(".sunburst-sector"),
      );

      let matches = 0;

      for (const sector of sectors) {
	const label =
          sector.dataset.nodeLabel ??
            "";

	const isMatch =
          query.length === 0 ||
            label.includes(query);

	sector.style.opacity =
        query.length > 0 && !isMatch
          ? "0.16"
          : "1";

	if (query.length > 0 && isMatch) {
          matches += 1;
	}
      }

      if (!resultCount) return;

      if (query.length === 0) {
	resultCount.textContent =
        `${sectors.length} ${
          sectors.length === 1
            ? "subject"
            : "subjects"
        }`;
      } else {
	resultCount.textContent =
        `${matches} ${
          matches === 1
            ? "match"
            : "matches"
        } · ${sectors.length} subjects`;
      }
    }

    function selectGroup(groupId: string) {
      groupFilter.value = groupId;

      for (const chart of charts) {
	chart.style.display =
        chart.dataset.sunburstGroup === groupId
          ? "block"
          : "none";
      }

      for (const button of groupButtons) {
	button.classList.toggle(
          "is-active",
          button.dataset.groupJump === groupId,
	);
      }

      applySearch();
    }

    groupFilter.addEventListener(
      "change",
      () => {
	selectGroup(groupFilter.value);
      },
    );

    search?.addEventListener(
      "input",
      applySearch,
    );

  for (const button of groupButtons) {
    button.addEventListener(
      "click",
      () => {
        const group =
          button.dataset.groupJump;

        if (!group) return;

        selectGroup(group);

        svg.scrollIntoView({
          behavior: "smooth",
          block: "center",
        });
      },
    );
  }

  selectGroup(groupFilter.value);
</script>

