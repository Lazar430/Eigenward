const rootNode: GraphNode = {
  id: "mathematics",
  label: "Mathematics",
  group: "root",
  x: STAGE_WIDTH / 2,
  y: 88,
  href: withBase("branches/"),
  kind: "root",
};

const hubNodes: GraphNode[] = groups.map((group) => ({
  id: `hub-${group.id}`,
  label: group.label,
  group: group.id,
  x: group.x,
  y: 278,
  href: withBase(`branches/${group.id}/`),
  kind: "hub",
}));

const topicNodes: GraphNode[] = topics.map((topic) => {
  const group = groupMap.get(topic.group);

  if (!group) throw new Error(`Unknown group: ${topic.group}`);

  return {
    id: topic.id,
    label: topic.label,
    group: topic.group,
    x: group.x + (topic.col === 0 ? -COLUMN_OFFSET : COLUMN_OFFSET),
    y: TOPIC_START_Y + topic.row * ROW_GAP,
    href: withBase(`branches/${topic.id}/`),
    kind: "topic",
  };
});

const allNodes = [rootNode, ...hubNodes, ...topicNodes];
const nodeMap = new Map(allNodes.map((node) => [node.id, node]));

const hubEdges: GraphEdge[] = groups.map((group) => ({
  from: "mathematics",
  to: `hub-${group.id}`,
  kind: "structural",
}));

const prerequisiteEdges: GraphEdge[] = topics.flatMap((topic) =>
  topic.prerequisites.map((from) => ({
    from,
    to: topic.id,
    kind: "structural" as const,
  })),
);

const allEdges = [...hubEdges, ...prerequisiteEdges, ...bridgeEdges].filter(
  (edge, index, edges) =>
    nodeMap.has(edge.from) &&
    nodeMap.has(edge.to) &&
    edges.findIndex(
      (candidate) =>
        candidate.from === edge.from &&
        candidate.to === edge.to &&
        candidate.kind === edge.kind,
    ) === index,
);

const groupForNode = (nodeId: string) => {
  const node = nodeMap.get(nodeId);
  return node?.group === "root" ? "root" : node?.group ?? "root";
};
---

<BaseLayout title="Branches">
  <main class="branches-page">
    <header class="branches-hero">
      <p class="eyebrow">A map of the subject</p>
      <h1>Branches of Mathematics</h1>

      <p class="branches-intro">
        Mathematics is not a collection of sealed compartments. It is a network
        of ideas: subjects grow from earlier subjects, split into specialized
        theories, and reconnect through unexpected bridges.
      </p>

      <p class="branches-note">
        Solid arrows show major prerequisite or developmental paths. Dashed
        arrows show especially important cross-disciplinary connections. No
        such map can be perfectly canonical, since many subjects naturally
        belong to several areas at once.
      </p>
    </header>

    <section class="graph-panel" aria-labelledby="graph-heading">
      <div class="graph-panel-heading">
        <div>
          <p class="section-kicker">Interactive subject map</p>
          <h2 id="graph-heading">Graph of all the subjects</h2>
        </div>

        <div class="graph-key" aria-label="Connection legend">
          <span><i class="key-line structural"></i> prerequisite path</span>
          <span><i class="key-line bridge"></i> cross-disciplinary bridge</span>
        </div>
      </div>

      <div class="graph-controls">
        <label class="search-control">
          <span>Find a subject</span>
          <input
            id="branch-search"
            type="search"
            placeholder="Try “topology”, “quantum”, “computational”…"
            autocomplete="off"
          />
        </label>

        <label class="group-control">
          <span>Area</span>
          <select id="group-filter">
            <option value="all">All areas</option>
            {groups.map((group) => (
              <option value={group.id}>{group.label}</option>
            ))}
          </select>
        </label>

        <!--<button id="graph-reset" type="button">Reset view</button>-->

        <output id="graph-result-count" aria-live="polite">
          {topicNodes.length} subjects shown
        </output>
      </div>

      <div class="group-legend" aria-label="Subject-area colors">
        {groups.map((group) => (
          <button
            class={`group-chip group-${group.id}`}
            type="button"
            data-group-jump={group.id}
          >
            <span class="group-dot"></span>
            {group.shortLabel}
          </button>
        ))}
      </div>

    </section>

    <div class="graph-viewport" id="graph-viewport" tabindex="0">
      <div
        class="math-map-stage"
        id="math-map-stage"
        data-stage-width={STAGE_WIDTH}
        data-stage-height={STAGE_HEIGHT}
        style={`width:${STAGE_WIDTH}px; height:${STAGE_HEIGHT}px;`}
      >
          <div
            class="math-map"
            id="math-map"
            style={`width:${STAGE_WIDTH}px; height:${STAGE_HEIGHT}px;`}
            role="list"
            aria-label="Dependency graph of mathematical subjects"
          >
          {groups.map((group) => (
            <div
              class={`lane group-${group.id}`}
              style={`left:${group.x - 218}px;`}
              aria-hidden="true"
            >
              <span>{group.shortLabel}</span>
            </div>
          ))}

          <svg
            class="math-map-lines"
            viewBox={`0 0 ${STAGE_WIDTH} ${STAGE_HEIGHT}`}
            width={STAGE_WIDTH}
            height={STAGE_HEIGHT}
            aria-hidden="true"
          >
            <defs>
              <marker
                id="arrowhead"
                markerWidth="8"
                markerHeight="8"
                refX="6"
                refY="4"
                orient="auto"
                markerUnits="strokeWidth"
              >
                <path d="M 0 0 L 8 4 L 0 8 z"></path>
              </marker>
            </defs>

            {allEdges.map((edge) => {
              const from = nodeMap.get(edge.from);
              const to = nodeMap.get(edge.to);

              if (!from || !to) return null;

              return (
                <line
                  class:list={[
                    "graph-edge",
                    edge.kind,
                    `edge-group-${groupForNode(edge.to)}`,
                  ]}
                  x1={from.x}
                  y1={from.y}
                  x2={to.x}
                  y2={to.y}
                  data-from={edge.from}
                  data-to={edge.to}
                  marker-end="url(#arrowhead)"
                />
              );
            })}
          </svg>

          {allNodes.map((node) => (
            <a
              id={`node-${node.id}`}
              class:list={[
                "math-node",
                `group-${node.group}`,
                `kind-${node.kind}`,
                node.id === "linear-algebra" && "is-live",
              ]}
              href={node.href}
              style={`left:${node.x}px; top:${node.y}px;`}
              data-node-id={node.id}
              data-node-label={node.label.toLowerCase()}
              data-node-group={node.group}
              role="listitem"
            >
              <span class="node-label">{node.label}</span>
              {node.id === "linear-algebra" && (
                <span class="node-status">available</span>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const viewport = document.querySelector<HTMLDivElement>("#graph-viewport");
  const mapStage = document.querySelector<HTMLDivElement>("#math-map-stage");
  const map = document.querySelector<HTMLDivElement>("#math-map");
  const stageWidth = Number(mapStage?.dataset.stageWidth ?? 0);
  const stageHeight = Number(mapStage?.dataset.stageHeight ?? 0);
  const search = document.querySelector<HTMLInputElement>("#branch-search");
  const groupFilter =
    document.querySelector<HTMLSelectElement>("#group-filter");
  const bridgeToggle =
    document.querySelector<HTMLInputElement>("#bridge-toggle");
  const resetButton =
    document.querySelector<HTMLButtonElement>("#graph-reset");
  const resultCount =
    document.querySelector<HTMLOutputElement>("#graph-result-count");
  const nodes = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".math-node"),
  );
  const edges = Array.from(
    document.querySelectorAll<SVGLineElement>(".graph-edge"),
  );
  const groupButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-group-jump]"),
  );

  const MIN_SCALE = 0.28;
  const MAX_SCALE = 2.2;
  const ZOOM_SENSITIVITY = 0.0011;
  const ZOOM_RESPONSE = 18;
  const DRAG_THRESHOLD = 5;

  let scale = 1;
  let targetScale = 1;
  let zoomFrame: number | null = null;
  let previousZoomTime = 0;

  let zoomAnchorGraphX = 0;
  let zoomAnchorGraphY = 0;
  let zoomAnchorViewportX = 0;
  let zoomAnchorViewportY = 0;

  let isDragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let dragStartScrollLeft = 0;
  let dragStartScrollTop = 0;

  function clamp(value: number, minimum: number, maximum: number) {
    return Math.min(maximum, Math.max(minimum, value));
  }

  function applyScale(nextScale: number) {
    if (!map || !mapStage || stageWidth <= 0 || stageHeight <= 0) return;

    scale = clamp(nextScale, MIN_SCALE, MAX_SCALE);

    map.style.transform = `translate3d(0, 0, 0) scale(${scale})`;
    mapStage.style.width = `${stageWidth * scale}px`;
    mapStage.style.height = `${stageHeight * scale}px`;
  }

  function centerGraph() {
    if (!viewport) return;

    const root = document.querySelector<HTMLElement>("#node-mathematics");
    if (!root) return;

    viewport.scrollLeft =
      root.offsetLeft * scale -
      viewport.clientWidth / 2 +
      (root.offsetWidth * scale) / 2;

    viewport.scrollTop = 0;
  }

  function keepZoomAnchorFixed() {
    if (!viewport) return;

    viewport.scrollLeft =
      zoomAnchorGraphX * scale - zoomAnchorViewportX;

    viewport.scrollTop =
      zoomAnchorGraphY * scale - zoomAnchorViewportY;
  }

  function animateZoom(timestamp: number) {
    if (!viewport) {
      zoomFrame = null;
      previousZoomTime = 0;
      return;
    }

    const elapsed =
      previousZoomTime === 0
        ? 1 / 60
        : Math.min((timestamp - previousZoomTime) / 1000, 0.05);

    previousZoomTime = timestamp;

    // Time-based exponential smoothing gives approximately the same motion
    // regardless of monitor refresh rate.
    const easing = 1 - Math.exp(-ZOOM_RESPONSE * elapsed);
    const nextScale = scale + (targetScale - scale) * easing;

    applyScale(nextScale);
    keepZoomAnchorFixed();

    if (Math.abs(targetScale - scale) < 0.0005) {
      applyScale(targetScale);
      keepZoomAnchorFixed();

      zoomFrame = null;
      previousZoomTime = 0;
      return;
    }

    zoomFrame = requestAnimationFrame(animateZoom);
  }

  function requestZoom(
    clientX: number,
    clientY: number,
    requestedScale: number,
  ) {
    if (!viewport) return;

    const rect = viewport.getBoundingClientRect();

    zoomAnchorViewportX = clientX - rect.left;
    zoomAnchorViewportY = clientY - rect.top;

    // Store the graph-space point underneath the cursor. During the animation
    // the viewport is repositioned so this exact point remains under it.
    zoomAnchorGraphX =
      (viewport.scrollLeft + zoomAnchorViewportX) / scale;

    zoomAnchorGraphY =
      (viewport.scrollTop + zoomAnchorViewportY) / scale;

    targetScale = clamp(requestedScale, MIN_SCALE, MAX_SCALE);

    if (zoomFrame === null) {
      previousZoomTime = 0;
      zoomFrame = requestAnimationFrame(animateZoom);
    }
  }

  viewport?.addEventListener(
    "wheel",
    (event) => {
      event.preventDefault();

      if (!viewport) return;

      // Firefox and some touchpads report wheel values in lines or pages,
      // while most browsers report pixels. Normalize all three cases.
      const deltaMultiplier =
        event.deltaMode === WheelEvent.DOM_DELTA_LINE
          ? 16
          : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
            ? viewport.clientHeight
            : 1;

      const normalizedDelta = event.deltaY * deltaMultiplier;
      const zoomFactor = Math.exp(
        -normalizedDelta * ZOOM_SENSITIVITY,
      );

      requestZoom(
        event.clientX,
        event.clientY,
        targetScale * zoomFactor,
      );
    },
    { passive: false },
  );

  viewport?.addEventListener("pointerdown", (event) => {
    if (event.button !== 0) return;

    const target = event.target as HTMLElement | null;

    // Links and controls retain their ordinary click behavior.
    if (target?.closest("a, button, input, select, textarea, label")) {
      return;
    }

    isDragging = true;
    dragStartX = event.clientX;
    dragStartY = event.clientY;
    dragStartScrollLeft = viewport.scrollLeft;
    dragStartScrollTop = viewport.scrollTop;

    viewport.setPointerCapture(event.pointerId);
    viewport.classList.add("is-dragging");
  });

  viewport?.addEventListener("pointermove", (event) => {
    if (!isDragging) return;

    const deltaX = event.clientX - dragStartX;
    const deltaY = event.clientY - dragStartY;

    if (
      Math.abs(deltaX) < DRAG_THRESHOLD &&
      Math.abs(deltaY) < DRAG_THRESHOLD
    ) {
      return;
    }

    viewport.scrollLeft = dragStartScrollLeft - deltaX;
    viewport.scrollTop = dragStartScrollTop - deltaY;
  });

  function stopDragging(event: PointerEvent) {
    if (!viewport || !isDragging) return;

    isDragging = false;
    viewport.classList.remove("is-dragging");

    if (viewport.hasPointerCapture(event.pointerId)) {
      viewport.releasePointerCapture(event.pointerId);
    }
  }

  viewport?.addEventListener("pointerup", stopDragging);
  viewport?.addEventListener("pointercancel", stopDragging);

  function applyFilters() {
    const query = (search?.value ?? "").trim().toLowerCase();
    const selectedGroup = groupFilter?.value ?? "all";
    const visibleIds = new Set<string>();
    let visibleTopicCount = 0;

    for (const node of nodes) {
      const id = node.dataset.nodeId ?? "";
      const label = node.dataset.nodeLabel ?? "";
      const group = node.dataset.nodeGroup ?? "";
      const structural =
        node.classList.contains("kind-root") ||
        node.classList.contains("kind-hub");

      const matchesQuery =
        query.length === 0 ||
        label.includes(query) ||
        group.includes(query);

      const matchesGroup =
        selectedGroup === "all" ||
        group === selectedGroup ||
        structural;

      const visible = matchesQuery && matchesGroup;

      node.classList.toggle("is-muted", !visible);
      node.classList.toggle("is-match", query.length > 0 && visible);

      if (visible) {
        visibleIds.add(id);
        if (node.classList.contains("kind-topic")) visibleTopicCount += 1;
      }
    }

    for (const edge of edges) {
      const from = edge.dataset.from ?? "";
      const to = edge.dataset.to ?? "";
      const isBridge = edge.classList.contains("bridge");
      const bridgeEnabled = bridgeToggle?.checked ?? true;
      const filtered = query.length > 0 || selectedGroup !== "all";
      const connected = visibleIds.has(from) || visibleIds.has(to);
      const show = (!isBridge || bridgeEnabled) && (!filtered || connected);

      edge.classList.toggle("is-muted", !show);
      edge.classList.toggle("is-hidden", isBridge && !bridgeEnabled);
    }

    if (resultCount) {
      resultCount.textContent = `${visibleTopicCount} ${
        visibleTopicCount === 1 ? "subject" : "subjects"
      } shown`;
    }
  }

  search?.addEventListener("input", applyFilters);
  groupFilter?.addEventListener("change", applyFilters);
  bridgeToggle?.addEventListener("change", applyFilters);

  resetButton?.addEventListener("click", () => {
    if (search) search.value = "";
    if (groupFilter) groupFilter.value = "all";
    if (bridgeToggle) bridgeToggle.checked = true;
    targetScale = 1;
    applyScale(1);
    applyFilters();
    centerGraph();
    search?.focus();
  });

  for (const button of groupButtons) {
    button.addEventListener("click", () => {
      const group = button.dataset.groupJump;
      if (!group || !groupFilter) return;

      groupFilter.value = group;
      applyFilters();

      const hub = document.querySelector<HTMLElement>(`#node-hub-${group}`);
      if (hub && viewport) {
        viewport.scrollTo({
          left:
            hub.offsetLeft * scale -
            viewport.clientWidth / 2 +
            (hub.offsetWidth * scale) / 2,
          top: Math.max(0, hub.offsetTop * scale - 90),
          behavior: "smooth",
        });
      }
    });
  }

  requestAnimationFrame(() => {
    targetScale = 1;
    applyScale(1);
    centerGraph();
  });
</script>

